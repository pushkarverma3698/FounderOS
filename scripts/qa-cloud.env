# FounderOS — Cloud QA / Live-Test env overrides
# Loaded AFTER .env (node --env-file=.env --env-file=scripts/qa-cloud.env ...)
# so these values win. Used only for the controlled live test battery.
#
# Dedicated test Postgres on 5433 (not the shared turicks-postgres on 5432).
DATABASE_URL=postgresql://founderos:founderos@localhost:5433/founderos
REDIS_URL=redis://localhost:6379
# Hard budget cap for the whole live test — enforced by checkBudget() now that
# Postgres is up (it fails OPEN without a DB, which is why infra must be live).
BUDGET_DAILY_USD=0.50
# Watch every run in LangSmith.
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=founderos-livetest
LOG_LEVEL=info
NODE_ENV=development
