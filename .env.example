# FounderOS — Environment Variables
# ===================================
# Copy to .env and fill in your values.
# NEVER commit .env to git.
#
# REQUIRED to start the bot:
#   DATABASE_URL, TELEGRAM_BOT_TOKEN, TELEGRAM_CHAT_ID
#   At least one LLM key: GOOGLE_GENERATIVE_AI_API_KEY or ANTHROPIC_API_KEY
#
# All other variables are OPTIONAL — features degrade gracefully when absent.

# ── Required: Database ────────────────────────────────────────────────────────

# REQUIRED — PostgreSQL connection string.
# Matches docker-compose.yml defaults for local dev.
DATABASE_URL=postgresql://founderos:founderos@localhost:5432/founderos

# ── Required: Telegram ────────────────────────────────────────────────────────

# REQUIRED — get your bot token from @BotFather on Telegram.
TELEGRAM_BOT_TOKEN=123456789:ABCDefGhIjKlMnOpQrStUvWxYz...

# REQUIRED — your Telegram chat/group ID (numeric, negative for groups).
# Add @RawDataBot to your group and send a message to see the chat_id field.
TELEGRAM_CHAT_ID=-100...

# ── LLM Providers (at least one required) ────────────────────────────────────
# Recommended minimum: GOOGLE_GENERATIVE_AI_API_KEY (covers most tiers cheaply)
# Add ANTHROPIC_API_KEY to unlock the critic tier anti-sycophancy guarantee
# Add OPENROUTER_API_KEY for free-tier fallbacks (deepseek-r1, llama-70b, qwen3-coder)

# OPTIONAL — Google Gemini: primary workhorse (gemini-2.5-flash, 2.5-pro, flash-lite)
# Get key: https://aistudio.google.com/app/apikey
GOOGLE_GENERATIVE_AI_API_KEY=AIza...

# OPTIONAL — Anthropic Claude: CEO routing + critic anti-sycophancy tier
# Get key: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# OPTIONAL — OpenRouter: free-tier fallbacks and multi-model routing
# Get key: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-...

# OPTIONAL — OpenAI: used for OpenAI-compatible local endpoints or direct GPT access
# Get key: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# OPTIONAL — Override the default agent model (default: gemini-2.5-flash)
# Example: gemini-2.5-flash, gemini-2.0-flash, claude-sonnet-4-5
AGENT_MODEL=gemini-2.5-flash

# OPTIONAL — Agent sampling temperature (default: 0 — deterministic routing)
# NEVER set to non-zero as a default — unstable routing is a P0 bug.
# Raise only for intentionally creative one-off runs via this env var.
AGENT_TEMPERATURE=0

# ── Tenant Identity ───────────────────────────────────────────────────────────

# OPTIONAL — Active tenant name, prefixes thread IDs and DB rows.
# Default: "turicks". Override per deployment.
FOUNDER_TENANT=turicks

# ── Telegram Topic Thread IDs ─────────────────────────────────────────────────
# Topic IDs are thread IDs inside a Telegram supergroup (requires Topics feature enabled)
# Set to 0 to disable topic routing and use the main group chat instead
# Get IDs by forwarding a message from the topic to @RawDataBot

TOPIC_BOARDROOM=0      # Executive decisions, CEO routing output
TOPIC_THINK_TANK=0     # Research and deep intelligence reports
TOPIC_TURICKS=0        # Turicks agency operations (sales, outreach, marketing)
TOPIC_SOCIAL=0         # Social media drafts and LinkedIn content

# ── Observability: LangSmith (optional) ───────────────────────────────────────
# Traces are PII-scrubbed before upload (see src/infra/telemetry.ts)
# Get key: https://smith.langchain.com/ -> Settings -> API Keys

LANGCHAIN_API_KEY=ls__...
LANGCHAIN_PROJECT=founderos           # Project name shown in LangSmith UI
LANGCHAIN_TRACING_V2=false            # Set to "true" to enable LangSmith trace upload

# ── Tool: Firecrawl (web search + scraping) ───────────────────────────────────

# OPTIONAL — deep web scraping for lead research and market intelligence
# Without it, the search_web tool falls back to a soft-failure message.
# Get key: https://firecrawl.dev/
FIRECRAWL_API_KEY=fc-...

# ── Tool: GitHub (direct token) ───────────────────────────────────────────────

# OPTIONAL — used by github_read and github_write tools (engineering dept).
# Create a Personal Access Token at https://github.com/settings/tokens
# Required scopes: repo, read:user
GITHUB_TOKEN=ghp_...

# ── Tool: Composio (email, LinkedIn, Calendar, GitHub OAuth) ─────────────────
# OPTIONAL — manages OAuth connections via managed proxied OAuth.
# Get API key: https://app.composio.dev/ -> API Keys

COMPOSIO_API_KEY=...

# Composio Gmail — send_email + read_emails tools (comms dept)
# Get IDs: app.composio.dev -> Connections -> Gmail
COMPOSIO_GMAIL_CONN_ID=ca_...        # Gmail connected account ID (ca_xxx format)
COMPOSIO_GMAIL_USER_ID=...           # Gmail entity/user ID

# Composio LinkedIn — linkedin_post tool (comms + marketing depts)
# Get IDs: app.composio.dev -> Connections -> LinkedIn
COMPOSIO_LINKEDIN_CONN_ID=ca_...     # LinkedIn connected account ID (ca_xxx format)
COMPOSIO_LINKEDIN_USER_ID=...        # LinkedIn entity/user ID

# Composio Google Calendar — create_calendar_event tool (comms dept)
# Get IDs: app.composio.dev -> Connections -> Google Calendar
# IMPORTANT: Composio Calendar fields use flat names: start_datetime/end_datetime
# NOT nested start.dateTime format. See src/tools/calendar.ts for reference.
COMPOSIO_GCAL_CONN_ID=ca_...         # Google Calendar connected account ID (ca_xxx format)
COMPOSIO_GCAL_USER_ID=...            # Google Calendar entity/user ID

# Composio GitHub — alternative OAuth-managed GitHub access (vs GITHUB_TOKEN above)
# Get IDs: app.composio.dev -> Connections -> GitHub
COMPOSIO_GITHUB_CONN_ID=ca_...       # GitHub connected account ID (ca_xxx format)
COMPOSIO_GITHUB_USER_ID=...          # GitHub entity/user ID

# Composio Instagram — OPTIONAL, used by social media tools
# Instagram connections expire — reconnect at app.composio.dev if you see auth errors.
COMPOSIO_INSTAGRAM_CONN_ID=ca_...    # Instagram connected account ID (optional)
COMPOSIO_INSTAGRAM_USER_ID=...       # Instagram entity/user ID (optional)

# ── Tool: Personal Dept (laptop operator) ─────────────────────────────────────

# OPTIONAL — root directory the personal dept can read/write files.
# Default: $HOME. Override to restrict to a specific directory.
# Absolute path. Secrets (.ssh, .aws, .env, *.pem, keychains) are always blocked
# regardless of this setting (enforced by src/infra/path-guard.ts).
PERSONAL_ROOT=/Users/your-username

# ── Tool: Engineering / Project Workflow ──────────────────────────────────────

# OPTIONAL — root directory the project_workflow tool is scoped to.
# Default: ~/Projects. Restrict to a subdirectory for extra safety.
PROJECT_WORKFLOW_ROOT=/Users/your-username/Projects

# ── Tool: Job-Hunt / Personal RAG ─────────────────────────────────────────────

# OPTIONAL — URL of the personal-rag REST API (CV search + knowledge retrieval).
# Default: http://localhost:8765 (local personal-rag service on the same machine).
PERSONAL_RAG_URL=http://localhost:8765

# OPTIONAL — Fallback path to the CV wiki markdown file if personal-rag is offline.
# Default: ~/Projects/personal-rag/data/wiki.md
PERSONAL_WIKI_PATH=/Users/your-username/Projects/personal-rag/data/wiki.md

# ── Tool: Claude Code (engineering dept) ─────────────────────────────────────

# OPTIONAL — override the path to the claude CLI binary (useful in CI).
# Default: auto-detected from $PATH.
CLAUDE_CODE_BIN=/usr/local/bin/claude

# ── Local Model: LM Studio ───────────────────────────────────────────────────

# OPTIONAL — used for the code and local cascade tiers (zero API cost for code gen).
# Download LM Studio: https://lmstudio.ai/ — load a qwen2.5-coder model.
LM_STUDIO_URL=http://localhost:1234          # LM Studio server URL (default port)
LM_STUDIO_MODEL=qwen2.5-coder-7b-instruct   # Model name loaded in LM Studio

# ── Infrastructure: Redis ─────────────────────────────────────────────────────

# OPTIONAL — used for: research cache (7d TTL), daily send quota counters, LLM
# prompt cache. Matches docker-compose.yml defaults for local dev.
# Bot degrades gracefully (no caching, no quota enforcement) if Redis is unavailable.
REDIS_URL=redis://localhost:6379

# ── Infrastructure: Health Server ─────────────────────────────────────────────

# OPTIONAL — HTTP health endpoint port for uptime monitoring (GET /health -> 200 OK).
# Default: 3001
HEALTH_PORT=3001

# ── Infrastructure: Single-Instance Lock ─────────────────────────────────────

# OPTIONAL — PID file path for the single-instance boot lock.
# Default: /tmp/founderos.pid. Override in multi-tenant or container deployments.
FOUNDEROS_PID_FILE=/tmp/founderos.pid

# ── Budget Controls ───────────────────────────────────────────────────────────

# OPTIONAL — hard cap on daily LLM API spend in USD (default: $5.00).
BUDGET_DAILY_USD=5.0

# OPTIONAL — max USD per single office.invoke() call (default: $0.50).
# $0.50 ≈ 7M Gemini Flash tokens — enough for any normal multi-step task.
# Breach surfaces a friendly Telegram message and stops the run immediately.
RUN_BUDGET_USD=0.50

# OPTIONAL — max total tokens (input + output, all agents) per run (default: 50000).
RUN_BUDGET_TOKENS=50000

# OPTIONAL — max outbound email/LinkedIn sends per tenant per day (default: 10).
# Enforced via Redis atomic counter. Prevents accidental spam.
DAILY_SEND_LIMIT=10

# ── Gateway Behaviour ─────────────────────────────────────────────────────────

# OPTIONAL — human turns of conversation history to keep per thread (default: 12).
# Older turns are trimmed so the model doesn't anchor on stale state and loop.
HISTORY_KEEP_TURNS=12

# OPTIONAL — max recursive supervisor/sub-agent steps before LangGraph aborts (default: 20).
# Prevents runaway agent loops. Breach surfaces a friendly rephrase prompt.
OFFICE_RECURSION_LIMIT=20

# ── Runtime ───────────────────────────────────────────────────────────────────

NODE_ENV=development      # development | production | test
LOG_LEVEL=info            # trace | debug | info | warn | error | fatal
