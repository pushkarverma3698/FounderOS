# FounderOS — Environment Variables
# ===================================
# Copy to .env and fill in your values.
# NEVER commit .env to git.
#
# Required: DATABASE_URL, TELEGRAM_BOT_TOKEN, TELEGRAM_CHAT_ID
# At least one LLM provider is required.

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://founderos:founderos@localhost:5432/founderos

# ── LLM Providers (at least one required) ────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
GOOGLE_GENERATIVE_AI_API_KEY=AIza...
OPENROUTER_API_KEY=sk-or-...
OPENAI_API_KEY=sk-...          # Optional — used for OpenAI-compatible endpoints

# ── Telegram ──────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=123456789:ABC...
TELEGRAM_CHAT_ID=-100...           # Your group/supergroup chat ID (negative number)

# Telegram topic thread IDs (0 = no topic, use main chat)
TOPIC_BOARDROOM=0
TOPIC_THINK_TANK=0
TOPIC_TURICKS=0
TOPIC_NAGGAR=0
TOPIC_SOCIAL=0

# ── Observability (optional) ──────────────────────────────────────────────────
LANGCHAIN_API_KEY=ls__...
LANGCHAIN_PROJECT=founderos
LANGCHAIN_TRACING_V2=false      # Set to "true" to enable LangSmith traces

# ── Tools (optional — features degrade gracefully if missing) ─────────────────
FIRECRAWL_API_KEY=fc-...
COMPOSIO_API_KEY=...
OPENWEATHER_API_KEY=...

# ── Local Model (LM Studio) ───────────────────────────────────────────────────
LM_STUDIO_URL=http://localhost:1234
LM_STUDIO_MODEL=qwen2.5-coder-7b-instruct

# ── Budget Controls ───────────────────────────────────────────────────────────
BUDGET_DAILY_USD=5.0             # Hard cap on daily LLM spend (USD)

# ── Runtime ───────────────────────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=info                  # trace | debug | info | warn | error | fatal
