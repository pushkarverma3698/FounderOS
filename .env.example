# FounderOS — Environment Variables
# ===================================
# Copy to .env and fill in your values.
# NEVER commit .env to git.
#
# Required: DATABASE_URL, TELEGRAM_BOT_TOKEN, TELEGRAM_CHAT_ID
# At least one LLM provider key is required (GOOGLE_GENERATIVE_AI_API_KEY recommended).
# All other variables have sensible defaults or degrade gracefully when absent.

# ── Required ──────────────────────────────────────────────────────────────────

# PostgreSQL connection string — matches docker-compose.yml defaults for local dev
DATABASE_URL=postgresql://founderos:founderos@localhost:5432/founderos

# Telegram bot token — get from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=123456789:ABCDefGhIjKlMnOpQrStUvWxYz...

# Telegram group/supergroup chat ID (negative number, e.g. -1001234567890)
# Obtain by adding @RawDataBot to your group and reading the chat_id field
TELEGRAM_CHAT_ID=-100...

# ── LLM Providers (at least one required) ────────────────────────────────────
# Recommended minimum: GOOGLE_GENERATIVE_AI_API_KEY (covers most tiers cheaply)
# Add ANTHROPIC_API_KEY to unlock the critic tier anti-sycophancy guarantee
# Add OPENROUTER_API_KEY for free-tier fallbacks (deepseek-r1, llama-70b, qwen3-coder)

# Anthropic — used for CEO routing + critic tier (claude-sonnet-4-5, claude-haiku-4-5)
# Get key: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Google Gemini — primary workhorse (gemini-2.5-flash, gemini-2.5-pro, flash-lite)
# Get key: https://aistudio.google.com/app/apikey
GOOGLE_GENERATIVE_AI_API_KEY=AIza...

# OpenRouter — free-tier fallbacks and multi-model routing
# Get key: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-...

# OpenAI — optional, used for OpenAI-compatible local endpoints or direct GPT access
# Get key: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# ── Telegram Topic Thread IDs ─────────────────────────────────────────────────
# Topic IDs are thread IDs inside a Telegram supergroup (requires Topics feature enabled)
# Set to 0 to disable topic routing and use the main group chat instead
# Get IDs by forwarding a message from the topic to @RawDataBot

TOPIC_BOARDROOM=0      # Executive decisions, CEO routing output
TOPIC_THINK_TANK=0     # Research and deep intelligence reports
TOPIC_TURICKS=0        # Turicks agency operations (sales, outreach, marketing)
TOPIC_SOCIAL=0         # Social media drafts and LinkedIn content

# ── Observability (optional — LangSmith tracing) ─────────────────────────────
# Traces are PII-scrubbed before sending (see src/infra/telemetry.ts)
# Get key: https://smith.langchain.com/ -> Settings -> API Keys

LANGCHAIN_API_KEY=ls__...
LANGCHAIN_PROJECT=founderos           # Project name shown in LangSmith UI
LANGCHAIN_TRACING_V2=false            # Set to "true" to enable trace upload

# ── Tools (optional — features degrade gracefully if missing) ─────────────────

# Firecrawl — deep web scraping for lead research and market intelligence
# Get key: https://firecrawl.dev/
FIRECRAWL_API_KEY=fc-...

# Composio — email, LinkedIn, GitHub, and Instagram automation via managed OAuth
# Get API key: https://app.composio.dev/ -> API Keys
COMPOSIO_API_KEY=...

# Composio connection IDs — get from app.composio.dev -> Connections
# For each integration: copy the connected account ID (ca_xxx) and entity/user ID

COMPOSIO_GMAIL_CONN_ID=ca_...        # Gmail connected account ID
COMPOSIO_GMAIL_USER_ID=...           # Gmail entity/user ID

COMPOSIO_LINKEDIN_CONN_ID=ca_...     # LinkedIn connected account ID
COMPOSIO_LINKEDIN_USER_ID=...        # LinkedIn entity/user ID

COMPOSIO_INSTAGRAM_CONN_ID=ca_...    # Instagram connected account ID (optional)
COMPOSIO_INSTAGRAM_USER_ID=...       # Instagram entity/user ID (optional)

# OpenWeatherMap — weather context for scheduling and location-aware content
# Get key: https://openweathermap.org/api
OPENWEATHER_API_KEY=...

# ── Local Model (LM Studio) ───────────────────────────────────────────────────
# Used for the code and local cascade tiers — zero API cost for code gen tasks
# Download LM Studio: https://lmstudio.ai/ — load a qwen2.5-coder model

LM_STUDIO_URL=http://localhost:1234          # LM Studio server URL (default port)
LM_STUDIO_MODEL=qwen2.5-coder-7b-instruct   # Model name loaded in LM Studio

# ── Redis ─────────────────────────────────────────────────────────────────────
# Used for: research cache (7d TTL), daily send quota counters, LLM prompt cache
# Matches docker-compose.yml defaults for local dev

REDIS_URL=redis://localhost:6379

# ── Budget Controls ───────────────────────────────────────────────────────────

BUDGET_DAILY_USD=5.0      # Hard cap on daily LLM API spend in USD

# Per-run budget caps — applied to each individual agent run (each Telegram message)
# Prevents a single runaway multi-step agent from burning through your daily budget.
# Breach surfaces a friendly message to Telegram and stops the run immediately.
RUN_BUDGET_USD=0.50       # Max USD per single run (default $0.50 = ~7M Gemini Flash tokens)
RUN_BUDGET_TOKENS=50000   # Max total tokens per single run (input + output across all agents)
DAILY_SEND_LIMIT=10       # Max outbound sales/email sends per tenant per day (enforced via Redis)

# ── Runtime ───────────────────────────────────────────────────────────────────

NODE_ENV=development      # development | production | test
LOG_LEVEL=info            # trace | debug | info | warn | error | fatal
