# FounderOS — Environment Variables
# ===================================
# Copy to .env and fill in your values.
# NEVER commit .env to git.
#
# REQUIRED to start the bot:
#   DATABASE_URL, TELEGRAM_BOT_TOKEN, TELEGRAM_CHAT_ID
#   One LLM key matching AGENT_MODEL's provider prefix
#
# All other variables are OPTIONAL — features degrade gracefully when absent.

# ── Required: Database ────────────────────────────────────────────────────────

# REQUIRED — PostgreSQL connection string.
# Matches docker-compose.yml defaults for local dev.
DATABASE_URL=postgresql://founderos:founderos@localhost:5432/founderos

# ── Required: Telegram ────────────────────────────────────────────────────────

# REQUIRED — get your bot token from @BotFather on Telegram.
TELEGRAM_BOT_TOKEN=123456789:ABCDefGhIjKlMnOpQrStUvWxYz...

# REQUIRED — your Telegram chat/group ID (numeric, negative for groups).
# Add @RawDataBot to your group and send a message to see the chat_id field.
TELEGRAM_CHAT_ID=-100...

# OPTIONAL — more chats where EVERYONE may talk to the bot (comma-separated;
# groups are negative). In a group the bot answers only commands, @mentions and
# replies to its own messages. Approving HITL cards and /halt /resume /task
# /newproject /connect stay owner-only; everything else is open to everyone in
# the chat, including reading your email, files and memory and cancelling or
# moving your scheduled posts and tasks. List only chats you trust that far.
# When you address the bot in a group not listed here, it answers you and
# replies with the exact line to add.
# TELEGRAM_ALLOWED_CHAT_IDS=-1001234567890
# Allowed chats where EVERY message is for the bot (no @mention needed) — e.g. a
# family group of two people and the bot. Implies allowed. Approvals stay the owner's.
# TELEGRAM_ANSWER_ALL_CHAT_IDS=-1001234567890
# OPTIONAL — your own Telegram user id. Derived from TELEGRAM_CHAT_ID when that
# is your private chat (there chat id == user id); set it if TELEGRAM_CHAT_ID is a group.
# TELEGRAM_OWNER_USER_ID=123456789
# OPTIONAL — the chat every job-lane message goes to (sweep alerts, pipeline digest, follow-up
# nudges, the 09:30 check), e.g. a family jobs group the bot is a member of. Unset = TELEGRAM_CHAT_ID.
# Budget alerts, approvals and dispatch notices stay in TELEGRAM_CHAT_ID. If Telegram refuses the
# jobs chat (bot removed, or the group upgraded to a supergroup, which changes its id), job messages
# go to TELEGRAM_CHAT_ID with a notice naming the cause. On the VPS this lives in /opt/founderos/.env
# and survives deploys (scripts/apply-prod-env-overrides.sh PRESERVE_IF_MISSING).
# JOBHUNT_CHAT_ID=-1001234567890
# Who sends job commands as which candidate: "<telegram user id>=<profile id>,…". A plain /today from
# that sender reads that profile's queue. Unset = every plain command reads the default profile.
# JOBHUNT_SENDER_PROFILES=

# ── LLM Providers (at least one matching AGENT_MODEL required) ────────────────
# Temporary production default uses OpenRouter while Gemini credits are depleted.
# Add ANTHROPIC_API_KEY to unlock the critic tier anti-sycophancy guarantee
# Add multiple provider keys to unlock AGENT_FALLBACK_MODELS failover.

# OPTIONAL — Google Gemini via AI Studio: still required for image-gen, web-search
# grounding, and gap-scanner (they call generativelanguage.googleapis.com directly
# with this key — see src/tools/{image-gen,web-search,gap-scanner}.ts). Also works
# as the google-genai: chat-model provider prefix below, but AI Studio has no SLA
# and hit repeated 503 storms in prod — google-vertexai: (below) is the reliable
# chat-model path now.
# Get key: https://aistudio.google.com/app/apikey
GOOGLE_GENERATIVE_AI_API_KEY=AIza...

# OPTIONAL — Google Gemini via Vertex AI: the production-reliable chat-model path
# (replaces AI Studio 503s for AGENT_MODEL/AGENT_FALLBACK_MODELS/WORKER_AGENT_MODEL
# — google-vertexai: prefix, or a bare "gemini*" id). Auth is a GCP service-account
# key, NOT an API key:
#   1) gcloud services enable aiplatform.googleapis.com --project=$PROJECT_ID
#   2) gcloud iam service-accounts create founderos-vertex --project=$PROJECT_ID
#   3) gcloud projects add-iam-policy-binding $PROJECT_ID \
#        --member="serviceAccount:founderos-vertex@$PROJECT_ID.iam.gserviceaccount.com" \
#        --role="roles/aiplatform.user"
#   4) gcloud iam service-accounts keys create google-vertex-sa.json \
#        --iam-account=founderos-vertex@$PROJECT_ID.iam.gserviceaccount.com
# GOOGLE_APPLICATION_CREDENTIALS=/opt/founderos/secrets/google-vertex-sa.json
# GOOGLE_CLOUD_PROJECT=your-project-id
# GOOGLE_CLOUD_LOCATION=us-central1

# OPTIONAL — Anthropic Claude: CEO routing + critic anti-sycophancy tier
# Get key: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# OPTIONAL — OpenRouter: free-tier fallbacks and multi-model routing
# Get key: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-...

# OPTIONAL — Outbound critic/judge model (gate 2, rule #6 anti-sycophancy).
# Defaults to a FREE OpenRouter model in a DIFFERENT family than the Gemini
# drafter, so the critic can't rubber-stamp its own copy and costs $0 per draft.
# Override to e.g. anthropic:claude-haiku-4-5 if you prefer the Claude critic.
# JUDGE_MODEL=openrouter:meta-llama/llama-3.3-70b-instruct:free

# OPTIONAL — Hard ceiling on a single office turn (ms). Prevents a hung model/tool
# call from leaving the founder with no reply forever. Default 180000 (3 min).
# OFFICE_TURN_TIMEOUT_MS=180000

# OPTIONAL — OpenAI: used for OpenAI-compatible local endpoints or direct GPT access
# Get key: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# OPTIONAL — Output-token cap on every chat model and the judge (default 4096).
# Without it OpenRouter reserves the model's whole output window against the
# balance and returns 402 with credit still on the key (AG-050).
# MODEL_MAX_OUTPUT_TOKENS=4096

# OPTIONAL — Override the default agent model (default: openrouter:google/gemini-2.5-flash)
# Prefixes: openrouter:, google-vertexai:, google-genai:, openai:, anthropic:
#
# Production (recommended — needs GCP service-account setup above). NOTE: Vertex
# AI does NOT support AI Studio's rolling "-latest" aliases (gemini-flash-latest
# 404s here) — use the fixed model id. Live-verified 2026-08-29 against
# us-central1: gemini-2.5-flash (~1s), gemini-2.5-flash-lite (~0.7s) both OK;
# gemini-2.5-pro OK but slower (~5s). gemini-3.x names aren't on Vertex yet.
#   AGENT_MODEL=google-vertexai:gemini-2.5-flash
#
# Local dev (free, zero cost — use in local .env):
#   AGENT_MODEL=openrouter:meta-llama/llama-3.3-70b-instruct:free
#
# NOTE: openrouter:google/gemini-2.5-flash:free was RETIRED 2026-06-27 (404 not 503 — fallback won't catch it).
# Google AI Studio direct (only if you have a Google AI Studio key, no GCP setup needed):
#   AGENT_MODEL=google-genai:gemini-2.5-flash
AGENT_MODEL=google-genai:gemini-2.5-flash

# OPTIONAL — Cross-provider failover, tried in order by LangChain modelFallbackMiddleware.
# Use provider-prefixed ids so swapping models is env-only.
# Free dev fallbacks (2026-08-23 verified working):
#   AGENT_FALLBACK_MODELS=openrouter:google/gemma-4-31b-it:free,openrouter:z-ai/glm-5.2:free
# Production (recommended, matches AGENT_MODEL=google-vertexai: above — only
# fixed model ids confirmed live on Vertex, see note above):
#   AGENT_FALLBACK_MODELS=google-vertexai:gemini-2.5-flash-lite,google-vertexai:gemini-2.5-pro,openrouter:nvidia/nemotron-3-super-120b-a12b:free,openrouter:minimax/minimax-m2.7:free
AGENT_FALLBACK_MODELS=google-genai:gemini-2.5-pro,google-genai:gemini-2-flash,google-genai:gemini-3.1-flash-lite

# OPTIONAL — per-role fallback pools. When SET they replace AGENT_FALLBACK_MODELS for that
# role (empty = no fallbacks); unset = the shared chain above. Measured picks and numbers:
# docs/sessions/2026-10-04-model-pools.md
#   PLANNER_FALLBACK_MODELS=openrouter:deepseek/deepseek-v4.1-flash,openrouter:nvidia/nemotron-3-super-120b-a12b:free,openrouter:xiaomi/mimo-v2.6-flash,openrouter:typesafe/jev-router
#   WORKER_FALLBACK_MODELS=openrouter:deepseek/deepseek-v4-flash,openrouter:nvidia/nemotron-3-super-120b-a12b:free,openrouter:google/gemini-3.6-flash

# OPTIONAL — Agent sampling temperature (default: 0 — deterministic routing)
# NEVER set to non-zero as a default — unstable routing is a P0 bug.
# Raise only for intentionally creative one-off runs via this env var.
AGENT_TEMPERATURE=0

# OPTIONAL — Gemini thinking for every google-genai: model (planner, workers,
# synthesizer, fallbacks, judge). Default LOW: on the real planner prompt, default
# dynamic thinking spent ~500 thought tokens and ~3 s per call (2026-09-28 audit).
# LOW | MEDIUM | HIGH, or DEFAULT to send no thinkingConfig at all (Google's dynamic
# thinking, the rollback lever). Any other value stops the boot.
# GEMINI_THINKING_LEVEL=LOW

# ── Tenant Identity ───────────────────────────────────────────────────────────

# OPTIONAL — Active tenant name, prefixes thread IDs and DB rows.
# Default: "turicks". Override per deployment.
FOUNDER_TENANT=turicks

# OPTIONAL — Founder-facing timezone (IANA). The SERVER stays UTC; this is only
# the zone the planner resolves bare times in ("9am" = your 9am) and that
# reminders/tasks display in. Default: "Asia/Kolkata" (IST). Do NOT set the OS
# clock to a local zone — this app-level setting is the correct lever.
APP_TIMEZONE=Asia/Kolkata

# OPTIONAL — Checkpoint retention window (days). The daily 3:30am sweep purges
# LangGraph checkpoints for threads idle longer than this, bounding unbounded
# growth of agents.checkpoints. Default: 30. Must be a positive number (a bad
# value falls back to 30 — the sweep is never silently disabled).
# CHECKPOINT_TTL_DAYS=30

# OPTIONAL — Worker (department/specialist) model for the model split (roadmap #10).
# The SUPERVISOR always uses AGENT_MODEL (strong, for routing reliability). Set this
# to a cheaper model to run department workers on it — routing is unaffected, worker
# cost drops. Default: same as AGENT_MODEL (no split). Misconfig falls back to primary.
# WORKER_AGENT_MODEL=openrouter:google/gemini-2.5-flash-lite

# Image generation (marketing.generate_image) needs GOOGLE_GENERATIVE_AI_API_KEY (Nano Banana)
# AND S3 storage below for delivery — without S3, images generate (real spend) then fail at upload.

# ── Video Factory (video-factory/ — standalone npm dir; run `npm install` there) ──
# Primary video engine is Kling image-to-video via fal.ai. Sign up at fal.ai →
# API key → set FAL_KEY. Kling animates Nano Banana keyframes (needs
# GOOGLE_GENERATIVE_AI_API_KEY above); Veo 3.1 is the automatic fallback (needs
# GEMINI_API_KEY / GOOGLE_GENERATIVE_AI_API_KEY). Voice/music need the ElevenLabs vars.
# FAL_KEY=fal-...
# GEMINI_API_KEY=AIza...            # Veo fallback + keyframe (alias of GOOGLE_GENERATIVE_AI_API_KEY)
# ELEVENLABS_API_KEY=...            # voiceover + music generation
# ELEVENLABS_VOICE_ID=...           # pick a voice in the ElevenLabs dashboard

# ── Telegram Topic Thread IDs ─────────────────────────────────────────────────
# Topic IDs are thread IDs inside a Telegram supergroup (requires Topics feature enabled)
# Set to 0 to disable topic routing and use the main group chat instead
# Get IDs by forwarding a message from the topic to @RawDataBot

TOPIC_BOARDROOM=0      # Executive decisions, CEO routing output
TOPIC_THINK_TANK=0     # Research and deep intelligence reports
TOPIC_TURICKS=0        # Turicks agency operations (sales, outreach, marketing)
TOPIC_SOCIAL=0         # Social media drafts and LinkedIn content

# ── Observability: LangSmith (optional) ───────────────────────────────────────
# Uploaded spans are NOT PII-scrubbed. See the warning below and the module
# header in src/infra/telemetry.ts for why there is a gate instead of a scrubber.
# Get key: https://smith.langchain.com/ -> Settings -> API Keys

LANGCHAIN_API_KEY=ls__...
LANGCHAIN_PROJECT=founderos           # Project name shown in LangSmith UI
LANGCHAIN_TRACING_V2=false            # Set to "true" to enable LangSmith trace upload

# ⚠️ Span export is NOT scrubbed. LangSmith receives full run I/O — prompts,
# tool inputs and outputs, model replies. For FounderOS that means the founder's
# email bodies, CV, recruiter addresses and job applications leave this box to a
# third party. src/infra/telemetry.ts REFUSES the export (and clears the tracing
# vars) unless you accept that trade explicitly:
LANGSMITH_ACCEPT_UNSCRUBBED_EXPORT=false

# ── Tool: Firecrawl (web search + scraping) ───────────────────────────────────

# OPTIONAL — deep web scraping for lead research and market intelligence
# Without it, the search_web tool falls back to a soft-failure message.
# Get key: https://firecrawl.dev/
FIRECRAWL_API_KEY=fc-...

# ── Tool: GitHub (direct token) ───────────────────────────────────────────────

# OPTIONAL — used by github_read and github_write tools (engineering dept).
# Create a Personal Access Token at https://github.com/settings/tokens
# Required scopes: repo, read:user
GITHUB_TOKEN=ghp_...

# ── Platform integrations (ADR-029 — direct APIs) ─

# Google Workspace via gws CLI (DEFAULT for Gmail + Calendar)
# One-time VPS setup: npm install -g @googleworkspace/cli && gws auth login
# Workspace admin: service account + domain-wide delegation (see ADR-029)
# GMAIL_BACKEND=gws          # gws | googleapis (default gws)
# CALENDAR_BACKEND=gws       # default: follows GMAIL_BACKEND
# GWS_BIN=gws
# PROVIDER_SMOKE_AT_BOOT=true   # default: true in production, false in dev
# PROVIDER_PROBE_TIMEOUT_MS=8000

# Google Workspace via googleapis service account (UNATTENDED — recommended for prod)
# "Add keys and go": no interactive `gws auth login`, no CLI binary on the host.
# NOTE: GOOGLE_APPLICATION_CREDENTIALS is also read by the google-vertexai: chat
# model provider (see the LLM Providers section above). If you use both Gmail SA
# and Vertex AI, grant ONE service account both roles/aiplatform.user and
# domain-wide delegation, and point both at the same JSON file — two separate
# files would mean only whichever is last in .env wins.
# 1) Workspace admin creates a service account + enables domain-wide delegation
#    with scopes: gmail.send, gmail.readonly, calendar.events
# 2) Download the SA JSON to the host, point GOOGLE_APPLICATION_CREDENTIALS at it
# 3) Set the per-account subject = the mailbox to send/read as
# GMAIL_BACKEND=googleapis        # switch Gmail + Calendar to the SA adapter
# CALENDAR_BACKEND=googleapis
# GOOGLE_APPLICATION_CREDENTIALS=/opt/founderos/secrets/google-sa.json
# GOOGLE_SUBJECT_TURICKS=hello@turicks.com     # per-account impersonation subject
# GOOGLE_SUBJECT_PERSONAL=you@gmail.com
# GOOGLE_SUBJECT_NAGGAR=stay@naggarretreat.com
# GOOGLE_IMPERSONATE_SUBJECT=hello@turicks.com # global fallback if a per-account one is unset

# LinkedIn via direct Posts API (DEFAULT)
# Founder completes OAuth once; store token + author URN here.
LINKEDIN_ACCESS_TOKEN=...
LINKEDIN_AUTHOR_URN=urn:li:organization:...   # Turicks company page (immediate + engagement)
# Production: set GitHub secrets LINKEDIN_ACCESS_TOKEN + LINKEDIN_AUTHOR_URN
# (patched on deploy by scripts/apply-prod-env-overrides.sh — no PROD_DOTENV re-encode needed)
# LINKEDIN_BACKEND=direct      # only value: direct
# LINKEDIN_API_VERSION=202606  # YYYYMM. 202506 was SUNSET — default is now 202606.
# Company Page to @tag when posting from the personal profile (scheduled posts).
# Name must EXACTLY match the page name or the tag renders as plain text.
# LINKEDIN_ORG_URN=urn:li:organization:1234567
# LINKEDIN_ORG_NAME=Turicks

# ── Account registry (ADR-036) — per-identity secrets ─────────────────────────
# Setup: pnpm accounts:seed && docs/guides/ACCOUNT-REGISTRY-RUNBOOK.md
# gws profiles (no .env needed): ~/.founderos/accounts/{turicks|personal|naggar}/gws
#
# Personal LinkedIn (jobhunt dept):
# LINKEDIN_ACCESS_TOKEN_PERSONAL=...
# LINKEDIN_AUTHOR_URN_PERSONAL=urn:li:person:...   # Flow B scheduled growth posts
# LINKEDIN_ORG_NAME=Turicks                          # @mention on personal posts
# LINKEDIN_ORG_URN=urn:li:organization:...           # optional structured mention
#
# Meta / Instagram / Facebook (marketing — tools coming):
# INSTAGRAM_ACCESS_TOKEN_TURICKS=...
# META_INSTAGRAM_PAGE_ID_TURICKS=...
# META_FACEBOOK_PAGE_ID_TURICKS=...
# INSTAGRAM_ACCESS_TOKEN_NAGGAR=...
# META_INSTAGRAM_PAGE_ID_NAGGAR=...
#
# Optional per-account GitHub:
# GITHUB_TOKEN_PERSONAL=ghp_...

# ── Knowledge Stores: pgvector + local Ollama embeddings ──────────────────────
# RAG is stored in two pgvector tables inside the same Postgres instance:
#   personal_rag   — CV, career history, certs, personal identity docs
#   turicks_brain  — ADRs, business strategy, decisions, conversation transcripts
#
# Embeddings are generated locally via Ollama (nomic-embed-text, 768-dim).
# RAG text NEVER leaves the box — no API egress, no external embedding service.
#
# Both Postgres and Ollama bind to 127.0.0.1 ONLY (see deploy/stack.compose.yml).
# ufw allows SSH only; app reaches postgres/ollama via loopback.
#
# First-time population (after deploy):
#   npx tsx --env-file=.env scripts/migrate-chroma-to-pgvector.ts
#
# Schema: personal_rag and turicks_brain tables are created by pnpm db:migrate.
# Isolation enforced by ALLOWED_RAG_TABLES set in src/db/rag-search.ts (ADR-013/015).

# OPTIONAL — Ollama base URL for local embeddings (default: http://localhost:11434)
# Matches the Docker service in deploy/stack.compose.yml (loopback-only).
OLLAMA_URL=http://localhost:11434

# OPTIONAL — embedding model name (default: nomic-embed-text, 768-dim)
# Must be pulled before first use: docker exec founderos-ollama ollama pull nomic-embed-text
# This is handled automatically by deploy/deploy.sh on every deploy.
EMBED_MODEL=nomic-embed-text

# OPTIONAL — embedding vector dimension; must match the model above (default: 768)
EMBED_DIM=768

# OPTIONAL — local rerank after hybrid RAG fusion (spec §1.1 F5). Default OFF.
# When "1"/"true", the top fused passages are reordered by a local model
# (qwen2.5:7b via Ollama) before returning. Fail-open: if the model is down or
# unparseable, the deterministic fused order stands. Adds one Ollama call per RAG
# query — leave OFF until verified on the VPS (`pnpm rag:probe`).
# RAG_RERANK=false
# NOTE: query embeddings are cached in Redis for 30 days when REDIS_URL is set
# (spec §1.1 F3) — no flag needed; it no-ops without Redis and never changes results.

# ── Tool: Claude Code executor (engineering dept) ─────────────────────────────
# The claude_code executor (src/tools/claude-code.ts) runs `claude -p` as a
# subprocess.  Auth is resolved in this priority order:
#   1. API key  — set CLAUDE_EXECUTOR_API_KEY (no OAuth session required)
#   2. OAuth    — requires `claude login` run as the founderos user on the VPS
#                 (one-time interactive step; credentials persist in ~/.claude/)
#
# For production VPS: run `claude login` once during provisioning (see Step 2 of
# DEPLOYMENT.md).  Leave CLAUDE_EXECUTOR_API_KEY empty to use OAuth.
# For CI / headless environments where OAuth is impractical, set the API key.

# OPTIONAL — Anthropic API key for the executor (bypasses OAuth session check)
CLAUDE_EXECUTOR_API_KEY=

# OPTIONAL — Custom base URL for the executor (e.g. enterprise proxy or local)
CLAUDE_EXECUTOR_BASE_URL=

# ── RAG Backend: pgvector (default) or RAGFlow ───────────────────────────────
# Default: pgvector — uses local Ollama + Postgres (see Knowledge Stores above).
# To switch to RAGFlow (self-hosted, eliminates Ollama dependency):
#   1. Deploy RAGFlow via Docker (see https://ragflow.io/docs/dev/install)
#   2. Create a knowledge-base dataset in the RAGFlow UI → copy its UUID
#   3. Set the four vars below

# RAG_BACKEND=ragflow                            # "pgvector" (default) | "ragflow"
# RAGFLOW_BASE_URL=http://localhost:9380          # RAGFlow server URL (Docker host or LAN)
# RAGFLOW_API_KEY=ragflow-...                     # API key from RAGFlow UI → Profile
# RAGFLOW_DATASET_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx  # Dataset UUID from RAGFlow UI

# ── Web Scraper: Apify (research dept real-data engine) ──────────────────────
# Apify (https://apify.com) powers the research department's full-page scraping:
#   scrape_url / deep_research → apify/rag-web-browser  (query OR url → Markdown)
#   crawl_site                 → apify/website-content-crawler (site → Markdown)
# ONE token works on local Mac, the VPS, and the app — set the same value everywhere.
# Get the token: https://console.apify.com → Settings → Integrations → API token.
# Fail-open: if APIFY_TOKEN is absent (or SCRAPE_BACKEND=fetch), the tools fall back
# to a keyless in-process fetch → strip-to-markdown, so research never hard-fails.
# Every scrape is cached in Redis (dedup) and auto-ingested into the research_cache
# pgvector store (searchable via search_research_cache).

# APIFY_TOKEN=apify_api_...
# APIFY_BASE_URL=https://api.apify.com/v2        # override only for proxy/self-host
# SCRAPE_BACKEND=apify                            # "apify" (default) | "fetch" (force keyless)
# RESEARCH_CACHE_TTL_SECONDS=86400               # Redis scrape-cache TTL (default 24h)

# ── Episodic Memory: mem0 (semantic recall layer) ────────────────────────────
# Optional cloud semantic memory (https://mem0.ai).
# When set, every record_event also pushes to mem0 cloud for semantic recall.
# search_memory gains a 4th "mem0 Semantic Recall" section alongside Postgres results.
# Fail-open: if MEM0_API_KEY is absent or the API is down, Postgres memory still works.
# Get key: https://app.mem0.ai/ → API Keys

# MEM0_API_KEY=m0-...
# MEM0_USER_ID=turicks     # Defaults to FOUNDER_TENANT ("turicks") when omitted

# ── Browser Backend (personal dept) ─────────────────────────────────────────
# Controls which browser engine the personal dept uses for open_url / get_page_text / run_js.
#   "auto"        — Playwright on Linux (VPS), AppleScript/Safari on macOS (default)
#   "playwright"  — Headless Chromium via Playwright (requires: npx playwright install chromium)
#   "applescript" — Safari via osascript (macOS only, broken on Linux)
# On Ubuntu VPS: leave as "auto" or set "playwright". Run setup command once on VPS:
#   npx playwright install chromium

BROWSER_BACKEND=auto

# ── Tool: Personal Dept (laptop operator) ─────────────────────────────────────

# OPTIONAL — root directory the personal dept can read/write files.
# Default: $HOME. Override to restrict to a specific directory.
# Secrets (.ssh, .aws, .env, *.pem, keychains) are ALWAYS blocked regardless
# of this setting (enforced by src/infra/path-guard.ts).
# Ubuntu VPS example: PERSONAL_ROOT=/home/founderos
PERSONAL_ROOT=/home/founderos

# ── Tool: Engineering / Project Workflow ──────────────────────────────────────

# OPTIONAL — root directory the project_workflow tool is scoped to.
# Default: ~/Projects. Restrict to a subdirectory for extra safety.
PROJECT_WORKFLOW_ROOT=/home/founderos/Projects

# ── Tool: Static site deploy (engineering dept) ───────────────────────────────

# OPTIONAL — public base URL returned by deploy_static_site (no trailing slash).
# Production VPS example: http://YOUR_VPS_IP
STATIC_SITE_PUBLIC_BASE_URL=http://127.0.0.1

# OPTIONAL — system web root when passwordless sudo works (default: /var/www)
# STATIC_SITE_SYSTEM_ROOT=/var/www

# OPTIONAL — home fallback web root (default: ~/www)
# STATIC_SITE_HOME_ROOT=/home/founderos/www

# Force home deploy in tests: DEPLOY_STATIC_SITE_FORCE_HOME=1

# ── Local Model: LM Studio ───────────────────────────────────────────────────

# OPTIONAL — used for the code and local cascade tiers (zero API cost for code gen).
# Download LM Studio: https://lmstudio.ai/ — load a qwen2.5-coder model.
LM_STUDIO_URL=http://localhost:1234          # LM Studio server URL (default port)
LM_STUDIO_MODEL=qwen2.5-coder-7b-instruct   # Model name loaded in LM Studio

# ── Infrastructure: Redis ─────────────────────────────────────────────────────

# OPTIONAL — used for: research cache (7d TTL), daily send quota counters, LLM
# prompt cache. Matches docker-compose.yml defaults for local dev.
# Bot degrades gracefully (no caching, no quota enforcement) if Redis is unavailable.
REDIS_URL=redis://localhost:6379

# OPTIONAL — Redis-backed LLM response cache for the side-effect-free planner and
# synthesizer calls. Worker tool-calling is never cached. No-op without REDIS_URL.
# Default: false
LLM_CACHE_ENABLED=false
# OPTIONAL — TTL in seconds for a cached LLM response; 0 disables writes.
# Default: 3600
LLM_CACHE_TTL_SECONDS=3600

# OPTIONAL — AG-029 kill switch for the planner's "Recent work" block: a dated list of
# what Claude, Antigravity and the daemons recorded in the brain in the last 36 h,
# shown in the founder's DM only. "false" drops the block from the planner prompt.
# Default: true
RECENT_ACTIVITY_ENABLED=true

# ── Infrastructure: Health Server ─────────────────────────────────────────────

# OPTIONAL — HTTP health endpoint port for uptime monitoring (GET /health -> 200 OK).
# Default: 3001
HEALTH_PORT=3001

# OPTIONAL — Bearer token for JARVIS web gateway (/api/v1/*). When set, all API
# requests require Authorization: Bearer <token> OR ?token= for SSE streams.
# Set the same value as VITE_WEB_GATEWAY_TOKEN when building apps/jarvis for prod.
# WEB_GATEWAY_TOKEN=

# OPTIONAL — Telegram long-polling in this process. Default: true in production,
# false in development (lets Jarvis/API run locally while prod bot polls same token).
# TELEGRAM_POLLING_ENABLED=false

# ── Infrastructure: Single-Instance Lock ─────────────────────────────────────

# OPTIONAL — PID file path for the single-instance boot lock.
# Default: /tmp/founderos.pid. Override in multi-tenant or container deployments.
FOUNDEROS_PID_FILE=/tmp/founderos.pid

# ── Budget Controls ───────────────────────────────────────────────────────────

# OPTIONAL — hard cap on daily LLM API spend in USD (default: $5.00).
BUDGET_DAILY_USD=5.0

# OPTIONAL — max USD per single office.invoke() call (default: $0.50).
RUN_BUDGET_USD=0.50

# OPTIONAL — max total tokens (input + output, all agents) per run (default: 50000).
RUN_BUDGET_TOKENS=50000

# OPTIONAL — max outbound email/LinkedIn sends per tenant per day (default: 10).
DAILY_SEND_LIMIT=10

# ── Gateway Behaviour ─────────────────────────────────────────────────────────

# OPTIONAL — human turns of conversation history to keep per thread (default: 4).
# Lower is better: prevents stale leading messages from polluting routing.
# Durable context lives in memory tools, not history.
HISTORY_KEEP_TURNS=4

# OPTIONAL — max recursive supervisor/sub-agent steps (default: 150; sized for
# 3 attempts of a 20-call read step: 3 * (1 + 2*20 + 2) + plan/synthesize).
# A value below ~135 can abort a legal retry of a long read step.
OFFICE_RECURSION_LIMIT=150

# ── S3 Asset Storage ─────────────────────────────────────────────────────────
# Files uploaded by users or produced by agents are stored in S3 (or R2/MinIO).
# Only the S3 key is kept in Postgres — file content never enters LangGraph state.
# Presigned download URLs are generated on-demand via GET /api/v1/assets/:id/url.
#
# Compatible with: AWS S3, Cloudflare R2, MinIO (set STORAGE_ENDPOINT_URL).
# For R2/MinIO, forcePathStyle is enabled automatically when STORAGE_ENDPOINT_URL is set.

# REQUIRED for asset storage (leave blank to disable the feature)
STORAGE_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
# OPTIONAL — set for Cloudflare R2 or MinIO; leave blank for AWS S3
STORAGE_ENDPOINT_URL=

# ── External MCP client bridge (ADR-041) ────────────────────────────────────
# Merge tools from external MCP servers (declared in mcp-bridge.json) into the
# department tool arrays. Reads pass straight through; writes route through the
# same HITL approval + idempotency + audit gate as native sends. Default OFF —
# the default build is byte-identical until you opt in. Flip to true to enable
# (Tier 0). The manifest supports two transports:
#   stdio → local child process:  { "transport":"stdio","command":"npx","args":[...],"env":["TOKEN_NAME"] }
#   http  → hosted remote server: { "transport":"http","url":"https://…","headerEnv":{"Authorization":"TOKEN_NAME"} }
# Secrets never live in the manifest: stdio `env` and http `headerEnv` list the
# NAMES of process env vars, resolved from the environment at connect time.
# Verify a server connects with: pnpm mcp:probe mcp-bridge.json --invoke
MCP_BRIDGE_ENABLED=false
MCP_BRIDGE_MANIFEST=mcp-bridge.json

# The read-only MCP server FounderOS exposes (search_web, read_context,
# search_knowledge, search_memory, read_cv, github_read) runs over stdio via
# `pnpm mcp`. A remote client (e.g. your Mac) reaches the VPS copy by launching
# `pnpm mcp` over SSH — the SSH key is the auth, no port/token needed. See the
# "Connect a local MCP client to the VPS" section of docs/VPS-MCP-SETUP.md.

# ── Runtime ───────────────────────────────────────────────────────────────────

NODE_ENV=development      # development | production | test
LOG_LEVEL=info            # trace | debug | info | warn | error | fatal

# ── Sandbox (vps_run) — OPTIONAL capability ───────────────────────────────────
# The vps_run tool runs one founder-approved command in an ephemeral Docker
# sandbox on the VPS and hands outputs off through S3. Leave all four unset to
# disable the sandbox (the tool returns "not configured" — it never crashes).
# Provisioning all four turns the capability on.
VPS_RUN_HOST=              # e.g. founderos@95.217.162.12 — SSH target that runs docker
VPS_RUN_SSH_KEY=           # path to the SSH identity for VPS_RUN_HOST (optional; ssh default if unset)
S3_BUCKET=                 # artifact sink for sandbox outputs (agent-runs/{run_id}/)
S3_ENDPOINT=               # S3-compatible endpoint (omit for AWS default)

# ── Prod-parity mirror (2026-07-17 audit) ────────────────────────────────────
# Every var below is set on the production VPS but was missing here. Mirrored
# per the convergence rule: if PROD requires it, .env.example declares it.
# Values are placeholders — real secrets live only in the runtime environment.

# Provider backend selectors (which implementation each tool family uses)
GMAIL_BACKEND=gws                 # gws | googleapis
CALENDAR_BACKEND=gws              # gws | googleapis
LINKEDIN_BACKEND=direct           # direct
RAG_BACKEND=pgvector              # pgvector | ragflow
SCRAPE_BACKEND=apify              # apify | playwright

# LinkedIn direct API (Turicks company author)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_ACCESS_TOKEN_TURICKS=
LINKEDIN_AUTHOR_URN_TURICKS=
LINKEDIN_API_VERSION=202606

# Google Workspace CLI backend (gws)
GOOGLE_WORKSPACE_CLI_CLIENT_ID=
GOOGLE_WORKSPACE_CLI_CLIENT_SECRET=
GWS_BIN=gws

# Misc providers
APIFY_TOKEN=
MEM0_API_KEY=

# Gateway / runtime knobs
OFFICE_TURN_TIMEOUT_MS=300000
WEB_GATEWAY_TOKEN=
STATIC_SITE_HOME_ROOT=
# Unused — the web gateway shares HEALTH_PORT. Kept so existing .env files parse.
WEB_GATEWAY_PORT=3002
# Global halt (kill switch) flag-file path. Default: $HOME/.founderos/HALT
HALT_FLAG_PATH=

# Skill synthesis (F-07 security gate) — synthesize_skill writes and compiles
# TypeScript into the running app's source tree. Off means the tool is never even
# offered to a worker, so the model cannot pick it. Leave false unless you mean it.
SKILL_SYNTHESIS_ENABLED=false

# Evolution findings persistence (Task 3) — write each 3-day self-audit run to
# evolution_runs/evolution_findings so the report can say which findings are new,
# recurring, or regressed (fixed and back). Off means the audit still runs and
# still reports; it just cannot show a delta. The first run with this ON writes
# the baseline every later run is diffed against.
# Default ON since 2026-08-14 — set to "false" to opt out. It was opt-in until a
# hand-added line in the prod .env was erased by the next deploy (which re-renders
# .env from the PROD_DOTENV secret), leaving recurrence tracking silently inert.
EVOLUTION_PERSIST_FINDINGS=true

# Self-improvement acting loop (Task 6) — every 3rd day at 09:00 the top
# actionable finding becomes ONE GitHub issue labelled agent:ready, which the
# VPS agent-dispatch cron claims and Antigravity implements as a DRAFT PR that
# pr-brain reviews. The loop never edits code itself. Requires GITHUB_TOKEN with
# `repo` scope. Set to false to stop it filing anything.
SELF_IMPROVE_DISPATCH_ENABLED=true
# Must match the ISSUE_REPO the VPS agent-dispatch cron watches, or the issue is
# filed somewhere nothing will ever claim it.
SELF_IMPROVE_ISSUE_REPO=pushkarverma3698/FounderOS

# TUI dispatch demo stub (POST /api/v1/dispatch) — a prompt box for
# scripts/tui-dashboard.ts that does NOT invoke the kernel. Leave false. It used
# to emit fabricated trace events into journald, which is the corroboration
# channel `pnpm verify:benchmark` reads to prove a benchmark turn really ran.
TUI_DISPATCH_ENABLED=false

# ── Jobhunt: Google Sheet output ──────────────────────────────────────────────

# OPTIONAL — the Sheet the jobhunt lane writes screened roles to. Without both of
# these the lane still runs but has nowhere to publish, which reads from outside
# exactly like a market with no jobs in it.
JOBHUNT_SHEET_ID=
GOOGLE_SHEETS_CREDENTIALS_PATH=

# MTProto QA harness (production-acceptance battery; founder account session)
TELEGRAM_TESTER_API_ID=
TELEGRAM_TESTER_API_HASH=
TELEGRAM_TESTER_SESSION=
# Optional: a group (bot + tester account in it) the probes post to instead of the bot DM.
# Add its id to TELEGRAM_ANSWER_ALL_CHAT_IDS on the box so the bot answers there. Refused if it equals a real chat id.
TELEGRAM_TEST_CHAT_ID=

# ── Optional app settings (each has a code default; leave commented unless you need it) ──

# Path of the agent-dispatch daemon; setting it lets the bot kick a dispatch tick. Unset everywhere except a box that runs the dispatch cron.
# AGENT_DISPATCH_BIN=
# Exactly "1" turns on the Telegram coding pipeline (issue, agent PR, review). Needs the daemons from deploy/sync-daemons.sh.
# AGENT_PIPELINE_V2=
# Unix socket of the agy-login helper (systemd agy-login.socket). Default /run/agy-login.sock. Only for Antigravity login from Telegram.
# AGY_LOGIN_SOCKET=
# Jobhunt: JSON file with the applicant profile the apply lane fills forms from. Default apply-profile.json in the data dir.
# APPLY_PROFILE_PATH=
# Jobhunt: hours a queued application stays eligible before it is dropped.
# APPLY_QUEUE_MAX_AGE_HOURS=24
# Directory where generated files (CSVs, renders) are written. The code default is the founder's home path; set it on any other box.
# ARTIFACT_ROOT=
# File that remembers the last boot notice so a restart loop does not spam Telegram. Default ~/.founderos/boot-notice.json.
# BOOT_NOTICE_PATH=
# Jobhunt: most roles kept in the daily brief queue.
# BRIEF_QUEUE_LIMIT=500
# Video/web presets: directory of the bundled preset copies. Optional.
# CINEMATIC_WEB_BUNDLED_ROOT=
# Video/web presets: directory with a clone of the preset repo. Optional.
# CINEMATIC_WEB_PRESETS_ROOT=
# Absolute path of the claude CLI when it is not on PATH. Only for the coding tools.
# CLAUDE_CODE_BIN=
# Jobhunt: how many CSV rows the liveness check verifies per run. Optional; code default applies.
# CSV_VERIFY_MAX=
# Cap on outbound emails per day. Code default applies when unset.
# DAILY_EMAIL_LIMIT=
# Cap on outbound LinkedIn actions per day. Code default applies when unset.
# DAILY_LINKEDIN_LIMIT=
# Set to 1 to deploy static sites under HOME instead of the web root. Tests and laptops only.
# DEPLOY_STATIC_SITE_FORCE_HOME=
# Set to 1 to skip every Ollama call (CI or a box without the ollama container).
# DISABLE_LOCAL_MODELS=
# File where turns lost to a restart are recorded for replay. Default ~/.founderos/dropped-turns.json.
# DROPPED_TURNS_PATH=
# Experimental engineering subgraph. Leave false.
# ENGINEERING_SUBGRAPH=false
# Unix socket of the fos-job helper (systemd fos-job.socket) that runs daemon jobs on request. Default /run/fos-job.sock.
# FOS_JOB_SOCKET=
# File the screen-context log is appended to. Default ~/.claude/screen.jsonl. Optional.
# FOUNDEROS_SCREEN_LOG=
# Jobhunt free lane: drop roles older than this many hours. Leave unset for the code default; a blank value parses to 0.
# FREE_LANE_MAX_AGE_HOURS=
# Commit the running build was made from; stamped into dispatch findings. deploy.sh does not set it; optional.
# GIT_COMMIT_SHA=
# Google OAuth client secret JSON used by /login google. Default ~/.config/gws/client_secret.json.
# GWS_CLIENT_SECRET_FILE=
# Set to "brain" to limit the MCP hub to the memory tools. Only for the stdio MCP server.
# HUB_SCOPE=
# Timeout in ms for one image generation call.
# IMAGE_GEN_TIMEOUT_MS=60000
# Default repo (owner/name) for issues the bot files. Per-call arguments win.
# ISSUE_REPO=
# Jobhunt: hours before a posting's liveness check is repeated.
# LIVENESS_STALE_HOURS=24
# Set to 1 to send logs to stderr. Required by the stdio MCP server, whose stdout carries the protocol.
# LOG_STDERR=
# Key for a local OmniRouter proxy. Only if a model name starts with omnirouter:.
# OMNIROUTER_API_KEY=
# Base URL of the local OmniRouter proxy. Default http://127.0.0.1:20128/v1.
# OMNIROUTER_BASE_URL=
# Absolute path of the opencode CLI when it is not on PATH. Optional.
# OPENCODE_BIN=
# Directory of CV files the career tools read. Optional.
# PERSONAL_CV_DIR=
# Single CV file the career tools read. Optional.
# PERSONAL_CV_PATH=
# URL of a personal-rag API the career tools query first. Optional.
# PERSONAL_RAG_URL=
# Wiki directory used as a CV fallback by the career tools. Optional.
# PERSONAL_WIKI_PATH=
# Experimental revenue subgraph. Leave false.
# REVENUE_SUBGRAPH=false
# Timeout in ms for one shell command run by the personal-shell tool.
# SHELL_TIMEOUT_MS=120000
# Jobhunt: hours a standing role may go without a liveness check.
# STANDING_LIVENESS_MAX_HOURS=168
# Model used to transcribe voice notes. Needs GOOGLE_API_KEY.
# TRANSCRIPTION_MODEL=gemini-flash-latest
# Model used for text-to-speech replies. Needs GOOGLE_API_KEY.
# TTS_MODEL=gemini-2.5-flash-preview-tts
# Voice name for text-to-speech replies.
# TTS_VOICE=Kore
# Jobhunt: how many top-ranked roles the daily brief verifies live.
# VERIFY_TOP_N=60
# Video factory: brands directory. Default video-factory/brands under the working directory.
# VIDEO_BRANDS_DIR=
# Video factory: projects directory. Default video-factory/projects under the working directory.
# VIDEO_PROJECTS_DIR=
# Model used to read screenshots in the UI QA tool. Needs GOOGLE_API_KEY.
# VISION_MODEL=gemini-flash-latest
# Set to s3-isolated only on a box that runs shell tools in the isolated sandbox. Leave unset.
# VPS_RUN_MODE=
# Jobhunt second-profile lane: path of that profile's base CV. Founder-specific; leave unset.
# WIFE_CV_PATH=

# ── Daemons and deploy scripts (deploy/*, read by shell, not by the app) ──
# Only matter on a box that runs the agent-dispatch / pr-brain daemons. Entries defaulting to
# /opt/founderos are the founder box path: set them to your install path.

# Claude engine: model that implements issues.
# AGENT_DISPATCH_CLAUDE_MODEL=sonnet
# Claude engine: file holding the claude CLI token, mode 600. Default ~/.claude/claude-code.token of the dispatcher user.
# AGENT_DISPATCH_CLAUDE_TOKEN_FILE=
# dotenv with TELEGRAM_BOT_TOKEN and TELEGRAM_CHAT_ID the dispatcher uses to escalate. job-run points it at the app .env.
# AGENT_DISPATCH_ENV_FILE=
# Minutes before a stale agent:working claim is released.
# AGENT_DISPATCH_LEASE_MIN=60
# Seconds between lock checks when another tick is running.
# AGENT_DISPATCH_LOCK_POLL_SEC=5
# New issue claims per tick.
# AGENT_DISPATCH_MAX=1
# Re-dispatch cycles per PR before it is labelled agent:blocked.
# AGENT_DISPATCH_MAX_ATTEMPTS=3
# Antigravity engine: one model name. Prefer AGENT_DISPATCH_MODELS.
# AGENT_DISPATCH_MODEL=
# Antigravity engine: candidate model list, best first, space or comma separated.
# AGENT_DISPATCH_MODELS=
# Node binary the executor prompt builder runs.
# AGENT_DISPATCH_NODE=node
# Checkout the executor prompt builder reads. Set to your install path.
# AGENT_DISPATCH_PIPELINE_ROOT=/opt/founderos
# Seconds between progress updates while the CLI works.
# AGENT_DISPATCH_PROGRESS_POLL_SEC=20
# Spec pass: attempts to write a failing test.
# AGENT_DISPATCH_SPEC_ATTEMPTS=3
# Spec pass: model that writes the failing test.
# AGENT_DISPATCH_SPEC_MODEL=opus
# Spec pass: timeout for the test run.
# AGENT_DISPATCH_SPEC_TEST_TIMEOUT_SEC=300
# Spec pass: timeout for one model call.
# AGENT_DISPATCH_SPEC_TIMEOUT_SEC=900
# Spec pass: Linux user the spec pass runs as.
# AGENT_DISPATCH_SPEC_USER=claude-agent
# Spec pass: vitest binary, relative to the work tree.
# AGENT_DISPATCH_SPEC_VITEST=node_modules/.bin/vitest
# Spec pass: scratch directory.
# AGENT_DISPATCH_SPEC_WORK=/var/lib/claude-agent/spec-work
# Per-agent-run timeout. Keep the lease at least 10 minutes longer.
# AGENT_DISPATCH_TIMEOUT_SEC=2400
# Retries for a transient agent failure.
# AGENT_DISPATCH_TRANSIENT_MAX=3
# Unprivileged Linux user that runs the agy CLI.
# AGENT_DISPATCH_USER=antigravity
# Antigravity-owned clone the agent works in.
# AGENT_DISPATCH_WORKSPACE=/opt/agy-workspace/founderos
# Parent directory of the per-repo agent clones.
# AGENT_DISPATCH_WORKSPACE_BASE=/opt/agy-workspace
# Antigravity engine: default executor model.
# AGY_EXECUTOR_MODEL=
# Where backup-db.sh writes dumps.
# BACKUP_DIR=/var/backups/founderos
# Branch deploy.sh deploys.
# DEPLOY_BRANCH=main
# Extra repos (owner/name, space separated) for the dispatch daemon. The daemon reads its own DEFAULT_REPOS list; see docs/self-host-hardcodes.md.
# ISSUE_REPOS=
# Test override: crontab file job-run reads job lines from.
# JOB_RUN_CRONTAB=
# Test override: dispatcher binary job-run calls.
# JOB_RUN_DISPATCH=
# dotenv job-run loads Telegram credentials from. Set to your install path.
# JOB_RUN_ENV_FILE=/opt/founderos/.env
# Test override: keep the caller's PATH instead of the fixed one.
# JOB_RUN_KEEP_PATH=
# Test override: pr-brain binary job-run calls.
# JOB_RUN_PR_BRAIN=
# Seconds job-run waits for the request line on its socket.
# JOB_RUN_READ_TIMEOUT=10
# Directory where onboarded repos get a review clone for pr-brain.
# ONBOARD_REVIEW_BASE=
# Test override: dotenv oracle-report.sh reads.
# ORACLE_REPORT_ENV_FILE=
# Test override: node binary oracle-report.sh runs.
# ORACLE_REPORT_NODE=
# Test override: checkout oracle-report.sh runs from.
# ORACLE_REPORT_ROOT=
# pr-brain: Linux user for the agy review engine.
# PR_BRAIN_AGY_USER=antigravity
# pr-brain claude engine: spend cap per PR.
# PR_BRAIN_BUDGET_USD=5
# pr-brain: sweeps a PR waits for required CI before it is reviewed anyway.
# PR_BRAIN_CI_WAIT_SWEEPS=4
# pr-brain: dotenv with Telegram credentials. job-run points it at the app .env.
# PR_BRAIN_ENV_FILE=
# pr-brain: model that writes PRs; never used as the reviewer.
# PR_BRAIN_EXECUTOR_MODEL=
# pr-brain: where review clones come from. Tests point it at a local directory.
# PR_BRAIN_GITHUB_URL=https://github.com
# pr-brain: seconds between lock checks.
# PR_BRAIN_LOCK_POLL_SEC=5
# pr-brain: PRs acted on per sweep.
# PR_BRAIN_MAX=3
# pr-brain: failed gates on one head before it stops retrying.
# PR_BRAIN_MAX_ATTEMPTS=3
# pr-brain: one reviewer model. Prefer PR_BRAIN_MODELS.
# PR_BRAIN_MODEL=
# pr-brain: node binary for the evidence card.
# PR_BRAIN_NODE=node
# Test override: fixed clock for pr-brain.
# PR_BRAIN_NOW_EPOCH=
# pr-brain: checkout the evidence card reads. Set to your install path.
# PR_BRAIN_PIPELINE_ROOT=/opt/founderos
# pr-brain: seconds between progress updates.
# PR_BRAIN_PROGRESS_POLL_SEC=20
# pr-brain: directory of review clones.
# PR_BRAIN_REVIEW_WORKSPACES=/opt/agy-workspace/review
# pr-brain: where it auto-discovers repos. Default ~/Projects.
# PR_BRAIN_ROOT=
# pr-brain: review skill file.
# PR_BRAIN_SKILL_FILE=/opt/agent-rules/skills/pr-adversary/SKILL.md
# pr-brain agy engine: time limit for one review.
# PR_BRAIN_TIMEOUT_SEC=1800
# pr-brain: GitHub token file. Default ~/.claude/pr-brain.token.
# PR_BRAIN_TOKEN_FILE=
# pr-brain app QA: checkout to test against. Set to your install path.
# QA_APP_ROOT=/opt/founderos
# pr-brain app QA: time limit.
# QA_APP_TIMEOUT_SEC=1500
# backup-db.sh: days of dumps kept.
# RETENTION_DAYS=14
# Slack MCP server token. deploy.sh enables the Slack MCP only when this and SLACK_TEAM_ID are set.
# SLACK_BOT_TOKEN=
# Slack workspace id for the Slack MCP.
# SLACK_TEAM_ID=
# Test override: crontab command sync-daemons.sh edits.
# SYNC_DAEMONS_CRONTAB=
# Where sync-daemons.sh installs the daemons. Default $HOME/bin of the user running it.
# SYNC_DAEMONS_DEST=
# Checkout the daemons ask for the repo list (scripts/print-dispatch-repos.ts). Default /opt/founderos.
# DISPATCH_REPOS_ROOT=
# Test override: the node binary that prints the repo list. Default node.
# DISPATCH_REPOS_NODE=
# Test override: the promote-run script job-run starts for a promote job. Default: promote-run beside job-run.
# JOB_RUN_PROMOTE=
# promote-run (the /promote job: beta -> main, wait for checks, wait for the deploy). Overrides are for tests.
# Seconds between polls. Default 20.
# PROMOTE_RUN_POLL=
# Seconds to wait for the required checks. Default 1800.
# PROMOTE_RUN_CHECKS_TIMEOUT=
# Seconds to wait for the deploy to move prod. Default 1500.
# PROMOTE_RUN_DEPLOY_TIMEOUT=
# Production checkout it watches. Default /opt/founderos.
# PROMOTE_RUN_APP_DIR=
# systemd unit it expects to restart. Default founderos.
# PROMOTE_RUN_SERVICE=
# Clone URL for the promotion branch. Default https://github.com/<repo>.git.
# PROMOTE_RUN_CLONE_URL=
# Lock file that keeps two promotes from running at once. Default $HOME/.claude/promote.lock.
# PROMOTE_RUN_LOCK=
# Test override: deploy/ directory sync-daemons.sh copies from.
# SYNC_DAEMONS_SRC=
# Test override: sudo command for systemd unit installs. Default "sudo -n".
# SYNC_DAEMONS_SUDO=
# Test override: systemctl binary.
# SYNC_DAEMONS_SYSTEMCTL=
# Test override: systemd unit directory. Default /etc/systemd/system.
# SYNC_DAEMONS_UNIT_DEST=
# Name the daemon uses in its Telegram messages.
# TG_DAEMON_NAME=agent-dispatch
# Hours (local, start-end) when daemons stay silent on Telegram.
# TG_QUIET_HOURS=23-08
# Test override: fixed hour for the quiet-hours check.
# TG_QUIET_NOW=

# ── Self-host install (deploy/install.sh, docs/SELF-HOST.md) ──────────────────
# These are INPUTS to the installer and deploy.sh, not settings the app reads. install.sh writes
# the app's own .env from them. The required ones are TELEGRAM_BOT_TOKEN, TELEGRAM_CHAT_ID,
# GITHUB_TOKEN and one model key (all documented above).

# Where the app is checked out. Default /opt/founderos.
# FOUNDEROS_DIR=/opt/founderos
# Where state that must survive a deploy lives (the app reads it as FOUNDEROS_DATA_ROOT). Default <FOUNDEROS_DIR>-data.
# FOUNDEROS_DATA_DIR=/opt/founderos-data
# Repo the installer clones. Default: the origin of the checkout you run install.sh from.
# FOUNDEROS_REPO_URL=https://github.com/OWNER/REPO.git
# deploy.sh: checkout to deploy. install.sh sets it to FOUNDEROS_DIR; leave unset on the founder box.
# APP_DIR=/opt/founderos
# deploy.sh: set to 1 to skip seeding the repo owner's profile (scripts/seed-founder-context.ts) into your database.
# install.sh writes it into .env.
# FOUNDEROS_SKIP_FOUNDER_SEED=1
