# FounderOS — Environment Variables
# ===================================
# Copy to .env and fill in your values.
# NEVER commit .env to git.
#
# REQUIRED to start the bot:
#   DATABASE_URL, TELEGRAM_BOT_TOKEN, TELEGRAM_CHAT_ID
#   One LLM key matching AGENT_MODEL's provider prefix
#
# All other variables are OPTIONAL — features degrade gracefully when absent.

# ── Required: Database ────────────────────────────────────────────────────────

# REQUIRED — PostgreSQL connection string.
# Matches docker-compose.yml defaults for local dev.
DATABASE_URL=postgresql://founderos:founderos@localhost:5432/founderos

# ── Required: Telegram ────────────────────────────────────────────────────────

# REQUIRED — get your bot token from @BotFather on Telegram.
TELEGRAM_BOT_TOKEN=123456789:ABCDefGhIjKlMnOpQrStUvWxYz...

# REQUIRED — your Telegram chat/group ID (numeric, negative for groups).
# Add @RawDataBot to your group and send a message to see the chat_id field.
TELEGRAM_CHAT_ID=-100...

# ── LLM Providers (at least one matching AGENT_MODEL required) ────────────────
# Temporary production default uses OpenRouter while Gemini credits are depleted.
# Add ANTHROPIC_API_KEY to unlock the critic tier anti-sycophancy guarantee
# Add multiple provider keys to unlock AGENT_FALLBACK_MODELS failover.

# OPTIONAL — Google Gemini: primary workhorse (gemini-2.5-flash, 2.5-pro, flash-lite)
# Get key: https://aistudio.google.com/app/apikey
GOOGLE_GENERATIVE_AI_API_KEY=AIza...

# OPTIONAL — Anthropic Claude: CEO routing + critic anti-sycophancy tier
# Get key: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# OPTIONAL — OpenRouter: free-tier fallbacks and multi-model routing
# Get key: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-...

# OPTIONAL — OpenAI: used for OpenAI-compatible local endpoints or direct GPT access
# Get key: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# OPTIONAL — Override the default agent model (default: openrouter:google/gemini-2.5-flash)
# Prefixes: openrouter:, google-genai:, openai:, anthropic:
# OpenRouter (prod + local, free tier): openrouter:google/gemini-2.5-flash
# Google direct (only if you have a Google AI Studio key, NOT for prod):
#   AGENT_MODEL=google-genai:gemini-2.5-flash
# NOTE: do NOT use retired ids like gemini-2.5-flash-preview-05-20 — normalised automatically.
AGENT_MODEL=openrouter:google/gemini-2.5-flash

# OPTIONAL — Cross-provider failover, tried in order by LangChain modelFallbackMiddleware.
# Use provider-prefixed ids so swapping models is env-only.
AGENT_FALLBACK_MODELS=anthropic:claude-haiku-4-5,google-genai:gemini-2.5-flash

# OPTIONAL — Agent sampling temperature (default: 0 — deterministic routing)
# NEVER set to non-zero as a default — unstable routing is a P0 bug.
# Raise only for intentionally creative one-off runs via this env var.
AGENT_TEMPERATURE=0

# ── Tenant Identity ───────────────────────────────────────────────────────────

# OPTIONAL — Active tenant name, prefixes thread IDs and DB rows.
# Default: "turicks". Override per deployment.
FOUNDER_TENANT=turicks

# ── Telegram Topic Thread IDs ─────────────────────────────────────────────────
# Topic IDs are thread IDs inside a Telegram supergroup (requires Topics feature enabled)
# Set to 0 to disable topic routing and use the main group chat instead
# Get IDs by forwarding a message from the topic to @RawDataBot

TOPIC_BOARDROOM=0      # Executive decisions, CEO routing output
TOPIC_THINK_TANK=0     # Research and deep intelligence reports
TOPIC_TURICKS=0        # Turicks agency operations (sales, outreach, marketing)
TOPIC_SOCIAL=0         # Social media drafts and LinkedIn content

# ── Observability: LangSmith (optional) ───────────────────────────────────────
# Traces are PII-scrubbed before upload (see src/infra/telemetry.ts)
# Get key: https://smith.langchain.com/ -> Settings -> API Keys

LANGCHAIN_API_KEY=ls__...
LANGCHAIN_PROJECT=founderos           # Project name shown in LangSmith UI
LANGCHAIN_TRACING_V2=false            # Set to "true" to enable LangSmith trace upload

# ── Tool: Firecrawl (web search + scraping) ───────────────────────────────────

# OPTIONAL — deep web scraping for lead research and market intelligence
# Without it, the search_web tool falls back to a soft-failure message.
# Get key: https://firecrawl.dev/
FIRECRAWL_API_KEY=fc-...

# ── Tool: GitHub (direct token) ───────────────────────────────────────────────

# OPTIONAL — used by github_read and github_write tools (engineering dept).
# Create a Personal Access Token at https://github.com/settings/tokens
# Required scopes: repo, read:user
GITHUB_TOKEN=ghp_...

# ── Platform integrations (ADR-029 — direct APIs, Composio = legacy rollback) ─

# Google Workspace via gws CLI (DEFAULT for Gmail + Calendar)
# One-time VPS setup: npm install -g @googleworkspace/cli && gws auth login
# Workspace admin: service account + domain-wide delegation (see ADR-029)
# GMAIL_BACKEND=gws          # default: gws. Set composio to rollback.
# CALENDAR_BACKEND=gws       # default: follows GMAIL_BACKEND
# GWS_BIN=gws
# PROVIDER_SMOKE_AT_BOOT=true   # default: true in production, false in dev
# PROVIDER_PROBE_TIMEOUT_MS=8000

# LinkedIn via direct Posts API (DEFAULT)
# Founder completes OAuth once; store token + author URN here.
LINKEDIN_ACCESS_TOKEN=...
LINKEDIN_AUTHOR_URN=urn:li:person:...
# Production: set GitHub secrets LINKEDIN_ACCESS_TOKEN + LINKEDIN_AUTHOR_URN
# (patched on deploy by scripts/apply-prod-env-overrides.sh — no PROD_DOTENV re-encode needed)
# LINKEDIN_BACKEND=direct      # default: direct. Set composio to rollback.
# LINKEDIN_API_VERSION=202405

# ── Account registry (ADR-036) — per-identity secrets ─────────────────────────
# Setup: pnpm accounts:seed && docs/guides/ACCOUNT-REGISTRY-RUNBOOK.md
# gws profiles (no .env needed): ~/.founderos/accounts/{turicks|personal|naggar}/gws
#
# Personal LinkedIn (jobhunt dept):
# LINKEDIN_ACCESS_TOKEN_PERSONAL=...
# LINKEDIN_AUTHOR_URN_PERSONAL=urn:li:person:...
#
# Meta / Instagram / Facebook (marketing — tools coming):
# INSTAGRAM_ACCESS_TOKEN_TURICKS=...
# META_INSTAGRAM_PAGE_ID_TURICKS=...
# META_FACEBOOK_PAGE_ID_TURICKS=...
# INSTAGRAM_ACCESS_TOKEN_NAGGAR=...
# META_INSTAGRAM_PAGE_ID_NAGGAR=...
#
# Optional per-account GitHub:
# GITHUB_TOKEN_PERSONAL=ghp_...

# ── Composio (LEGACY FALLBACK — only needed if rolling back from direct APIs) ─
# OPTIONAL — kept for rollback. Not required when gws + direct LinkedIn are configured.
# Get API key: https://app.composio.dev/ -> API Keys

# COMPOSIO_API_KEY=...

# Composio connection IDs (only when using *_BACKEND=composio)
# COMPOSIO_GMAIL_CONN_ID=ca_...
# COMPOSIO_GMAIL_USER_ID=...
# COMPOSIO_LINKEDIN_CONN_ID=ca_...
# COMPOSIO_LINKEDIN_USER_ID=...
# COMPOSIO_GCAL_CONN_ID=ca_...
# COMPOSIO_GCAL_USER_ID=...
# COMPOSIO_GITHUB_CONN_ID=ca_...
# COMPOSIO_GITHUB_USER_ID=...
# COMPOSIO_INSTAGRAM_CONN_ID=ca_...
# COMPOSIO_INSTAGRAM_USER_ID=...

# ── Knowledge Stores: pgvector + local Ollama embeddings ──────────────────────
# RAG is stored in two pgvector tables inside the same Postgres instance:
#   personal_rag   — CV, career history, certs, personal identity docs
#   turicks_brain  — ADRs, business strategy, decisions, conversation transcripts
#
# Embeddings are generated locally via Ollama (nomic-embed-text, 768-dim).
# RAG text NEVER leaves the box — no API egress, no external embedding service.
#
# Both Postgres and Ollama bind to 127.0.0.1 ONLY (see deploy/stack.compose.yml).
# ufw allows SSH only; app reaches postgres/ollama via loopback.
#
# First-time population (after deploy):
#   npx tsx --env-file=.env scripts/migrate-chroma-to-pgvector.ts
#
# Schema: personal_rag and turicks_brain tables are created by pnpm db:migrate.
# Isolation enforced by ALLOWED_RAG_TABLES set in src/db/rag-search.ts (ADR-013/015).

# OPTIONAL — Ollama base URL for local embeddings (default: http://localhost:11434)
# Matches the Docker service in deploy/stack.compose.yml (loopback-only).
OLLAMA_URL=http://localhost:11434

# OPTIONAL — embedding model name (default: nomic-embed-text, 768-dim)
# Must be pulled before first use: docker exec founderos-ollama ollama pull nomic-embed-text
# This is handled automatically by deploy/deploy.sh on every deploy.
EMBED_MODEL=nomic-embed-text

# OPTIONAL — embedding vector dimension; must match the model above (default: 768)
EMBED_DIM=768

# ── Tool: Claude Code executor (engineering dept) ─────────────────────────────
# The claude_code executor (src/tools/claude-code.ts) runs `claude -p` as a
# subprocess.  Auth is resolved in this priority order:
#   1. API key  — set CLAUDE_EXECUTOR_API_KEY (no OAuth session required)
#   2. OAuth    — requires `claude login` run as the founderos user on the VPS
#                 (one-time interactive step; credentials persist in ~/.claude/)
#
# For production VPS: run `claude login` once during provisioning (see Step 2 of
# DEPLOYMENT.md).  Leave CLAUDE_EXECUTOR_API_KEY empty to use OAuth.
# For CI / headless environments where OAuth is impractical, set the API key.

# OPTIONAL — Anthropic API key for the executor (bypasses OAuth session check)
CLAUDE_EXECUTOR_API_KEY=

# OPTIONAL — Custom base URL for the executor (e.g. enterprise proxy or local)
CLAUDE_EXECUTOR_BASE_URL=

# ── RAG Backend: pgvector (default) or RAGFlow ───────────────────────────────
# Default: pgvector — uses local Ollama + Postgres (see Knowledge Stores above).
# To switch to RAGFlow (self-hosted, eliminates Ollama dependency):
#   1. Deploy RAGFlow via Docker (see https://ragflow.io/docs/dev/install)
#   2. Create a knowledge-base dataset in the RAGFlow UI → copy its UUID
#   3. Set the four vars below

# RAG_BACKEND=ragflow                            # "pgvector" (default) | "ragflow"
# RAGFLOW_BASE_URL=http://localhost:9380          # RAGFlow server URL (Docker host or LAN)
# RAGFLOW_API_KEY=ragflow-...                     # API key from RAGFlow UI → Profile
# RAGFLOW_DATASET_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx  # Dataset UUID from RAGFlow UI

# ── Episodic Memory: mem0 (semantic recall layer) ────────────────────────────
# Optional cloud semantic memory (https://mem0.ai).
# When set, every record_event also pushes to mem0 cloud for semantic recall.
# search_memory gains a 4th "mem0 Semantic Recall" section alongside Postgres results.
# Fail-open: if MEM0_API_KEY is absent or the API is down, Postgres memory still works.
# Get key: https://app.mem0.ai/ → API Keys

# MEM0_API_KEY=m0-...
# MEM0_USER_ID=turicks     # Defaults to FOUNDER_TENANT ("turicks") when omitted

# ── Browser Backend (personal dept) ─────────────────────────────────────────
# Controls which browser engine the personal dept uses for open_url / get_page_text / run_js.
#   "auto"        — Playwright on Linux (VPS), AppleScript/Safari on macOS (default)
#   "playwright"  — Headless Chromium via Playwright (requires: npx playwright install chromium)
#   "applescript" — Safari via osascript (macOS only, broken on Linux)
# On Ubuntu VPS: leave as "auto" or set "playwright". Run setup command once on VPS:
#   npx playwright install chromium

BROWSER_BACKEND=auto

# ── Tool: Personal Dept (laptop operator) ─────────────────────────────────────

# OPTIONAL — root directory the personal dept can read/write files.
# Default: $HOME. Override to restrict to a specific directory.
# Secrets (.ssh, .aws, .env, *.pem, keychains) are ALWAYS blocked regardless
# of this setting (enforced by src/infra/path-guard.ts).
# Ubuntu VPS example: PERSONAL_ROOT=/home/founderos
PERSONAL_ROOT=/home/founderos

# ── Tool: Engineering / Project Workflow ──────────────────────────────────────

# OPTIONAL — root directory the project_workflow tool is scoped to.
# Default: ~/Projects. Restrict to a subdirectory for extra safety.
PROJECT_WORKFLOW_ROOT=/home/founderos/Projects

# ── Tool: Static site deploy (engineering dept) ───────────────────────────────

# OPTIONAL — public base URL returned by deploy_static_site (no trailing slash).
# Production VPS example: http://YOUR_VPS_IP
STATIC_SITE_PUBLIC_BASE_URL=http://127.0.0.1

# OPTIONAL — system web root when passwordless sudo works (default: /var/www)
# STATIC_SITE_SYSTEM_ROOT=/var/www

# OPTIONAL — home fallback web root (default: ~/www)
# STATIC_SITE_HOME_ROOT=/home/founderos/www

# Force home deploy in tests: DEPLOY_STATIC_SITE_FORCE_HOME=1

# ── Local Model: LM Studio ───────────────────────────────────────────────────

# OPTIONAL — used for the code and local cascade tiers (zero API cost for code gen).
# Download LM Studio: https://lmstudio.ai/ — load a qwen2.5-coder model.
LM_STUDIO_URL=http://localhost:1234          # LM Studio server URL (default port)
LM_STUDIO_MODEL=qwen2.5-coder-7b-instruct   # Model name loaded in LM Studio

# ── Infrastructure: Redis ─────────────────────────────────────────────────────

# OPTIONAL — used for: research cache (7d TTL), daily send quota counters, LLM
# prompt cache. Matches docker-compose.yml defaults for local dev.
# Bot degrades gracefully (no caching, no quota enforcement) if Redis is unavailable.
REDIS_URL=redis://localhost:6379

# ── Infrastructure: Health Server ─────────────────────────────────────────────

# OPTIONAL — HTTP health endpoint port for uptime monitoring (GET /health -> 200 OK).
# Default: 3001
HEALTH_PORT=3001

# OPTIONAL — Bearer token for JARVIS web gateway (/api/v1/*). When set, all API
# requests require Authorization: Bearer <token> OR ?token= for SSE streams.
# Set the same value as VITE_WEB_GATEWAY_TOKEN when building apps/jarvis for prod.
# WEB_GATEWAY_TOKEN=

# OPTIONAL — Telegram long-polling in this process. Default: true in production,
# false in development (lets Jarvis/API run locally while prod bot polls same token).
# TELEGRAM_POLLING_ENABLED=false

# ── Infrastructure: Single-Instance Lock ─────────────────────────────────────

# OPTIONAL — PID file path for the single-instance boot lock.
# Default: /tmp/founderos.pid. Override in multi-tenant or container deployments.
FOUNDEROS_PID_FILE=/tmp/founderos.pid

# ── Budget Controls ───────────────────────────────────────────────────────────

# OPTIONAL — hard cap on daily LLM API spend in USD (default: $5.00).
BUDGET_DAILY_USD=5.0

# OPTIONAL — max USD per single office.invoke() call (default: $0.50).
RUN_BUDGET_USD=0.50

# OPTIONAL — max total tokens (input + output, all agents) per run (default: 50000).
RUN_BUDGET_TOKENS=50000

# OPTIONAL — max outbound email/LinkedIn sends per tenant per day (default: 10).
DAILY_SEND_LIMIT=10

# ── Gateway Behaviour ─────────────────────────────────────────────────────────

# OPTIONAL — human turns of conversation history to keep per thread (default: 4).
# Lower is better: prevents stale leading messages from polluting routing.
# Durable context lives in memory tools, not history.
HISTORY_KEEP_TURNS=4

# OPTIONAL — max recursive supervisor/sub-agent steps (default: 40).
OFFICE_RECURSION_LIMIT=40

# ── Runtime ───────────────────────────────────────────────────────────────────

NODE_ENV=development      # development | production | test
LOG_LEVEL=info            # trace | debug | info | warn | error | fatal
