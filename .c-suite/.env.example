# FounderOS Master Environment Variables
# Copy this file to .env and fill in your real values.
# NEVER commit .env to git.
# ============================================================

# ── AI Inference (CASCADE ORDER) ────────────────────────────
# CEO: Claude 4.5 Sonnet → Gemini 2.5 Pro → OpenRouter fallback
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxx     # Tier 1 CEO primary

# Deep Research + MD primary: Gemini 2.5 Pro / 2.5 Flash (generous free tiers)
GOOGLE_API_KEY=AIzaxxxxxxxxxxxx             # Tier 2/3/4 — Pro, Flash, Lite all free

# Fallback when Anthropic + Google quotas hit (CEO fallback + free models)
OPENROUTER_API_KEY=sk-or-xxxxxxxxxxxxxx    # Tier-3 fallback; free models like DeepSeek R1, Llama 3.3

# ── Telegram ────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=123456789:ABCxxxxxxxxxxxxxxxx
TELEGRAM_CHAT_ID=-100xxxxxxxxxx             # Supergroup ID (negative number)

# Telegram Topic Thread IDs (right-click topic → Copy Link → extract the number)
TOPIC_BOARDROOM=2
TOPIC_THINK_TANK=3
TOPIC_TURICKS=4
TOPIC_NAGGAR=5
TOPIC_SOCIAL=6                              # #Social_Command topic

# ── Tools & MCP ─────────────────────────────────────────────
FIRECRAWL_API_KEY=fc-xxxxxxxxxxxxx          # firecrawl.dev — clean web scraping
OPENWEATHER_API_KEY=xxxxxxxxxxxxxxxx        # openweathermap.org — free farm weather
LANGCHAIN_API_KEY=ls-xxxxxxxxxxxxxx         # langsmith.com — agent tracing (free tier)

# ── Optional / Future ───────────────────────────────────────
ELEVENLABS_API_KEY=                         # elevenlabs.io — TTS audio briefs
COMPOSIO_API_KEY=                           # composio.dev — MCP hub
