<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Mac brain capture (AG-027). scripts/mac/install-brain-capture.sh replaces __REPO__ and __HOME__ and loads it. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.founderos.brain-capture</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__REPO__/scripts/mac/brain-capture.sh</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>BRAIN_CAPTURE_REPO</key>
    <string>__REPO__</string>
  </dict>
  <key>StartInterval</key>
  <integer>1800</integer>
  <key>RunAtLoad</key>
  <true/>
  <key>StandardOutPath</key>
  <string>__HOME__/.claude/brain-capture.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/.claude/brain-capture.log</string>
</dict>
</plist>
