[Unit]
Description=FounderOS coding job %i (deploy/job-run: one issue, one stage, one outcome on Telegram)

[Service]
Type=simple
User=founderos
Group=founderos
WorkingDirectory=/home/founderos
Environment=HOME=/home/founderos
# The request line arrives on stdin (the accepted connection). job-run reads one line, runs the job, and reports it.
StandardInput=socket
StandardOutput=journal
StandardError=journal
SyslogIdentifier=fos-job
ExecStart=/home/founderos/bin/job-run
# A job waits up to an hour for the dispatch lock and an executor run takes up to 40 minutes: stop only a hung one.
TimeoutStopSec=60
RuntimeMaxSec=14400
# NO NoNewPrivileges, ProtectSystem or PrivateTmp, on purpose. The bot runs under all three, which is why it could
# never start a dispatcher itself: every `sudo -n -u antigravity` failed. This unit runs as the same user WITHOUT
# them, so the dispatcher works exactly as it does from cron (/tmp is shared with the antigravity user too).
