[Unit]
Description=FounderOS job socket (the bot hands it one coding job per connection)

[Socket]
# The bot (user founderos) writes ONE JSON line {repo, issue, stage}; systemd starts fos-job@.service for the connection.
# /run is tmpfs, so the file is recreated at boot. Not world-openable: only founderos and its group can start a job.
ListenStream=/run/fos-job.sock
SocketUser=founderos
SocketGroup=founderos
SocketMode=0660
Accept=yes

[Install]
WantedBy=sockets.target
