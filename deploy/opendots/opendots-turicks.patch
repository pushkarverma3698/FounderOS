+// A RUN_ERROR stops TanStack's loop before the tool phase, and a failed shift retries.
+function failCutOffReplies(adapter: object) {
+  const target = adapter as {
+    processStreamChunks(
+      stream: AsyncIterable<ModelChunk>,
+      ...rest: unknown[]
+    ): AsyncIterable<AdapterChunk>;
+  };
+  const upstream = target.processStreamChunks.bind(adapter);
+  target.processStreamChunks = async function* (stream, ...rest) {
+    let cutOff = false;
+    const watched = (async function* () {
+      for await (const chunk of stream) {
+        if (chunk.choices?.some((c) => c.finish_reason === 'length'))
+          cutOff = true;
+        yield chunk;
+      }
+    })();
+    for await (const event of upstream(watched, ...rest)) {
+      if (cutOff && event.type === EventType.RUN_FINISHED) {
+        const message = "The model's reply was cut off at the output limit.";
+        yield {
+          type: EventType.RUN_ERROR,
+          runId: event.runId,
+          model: event.model,
+          timestamp: Date.now(),
+          message,
+          code: 'max_tokens',
+          error: { message, code: 'max_tokens' },
+        } as AdapterChunk;
+        return;
+      }
+      yield event;
+    }
+  };
+}
