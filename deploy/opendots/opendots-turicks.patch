+import { expect, it, vi } from 'vitest';
+import {
+  messagesSignature,
+  resyncUntilStable,
+} from '../src/client/thread-resync';
+
+// turicks: opening a thread while its reply is still streaming (or within a second or two of the run
+// ending) replays only part of the reply, and the replay stream then closes. The page showed that cut-off
+// text until the next reload. These tests pin the re-sync that closes the gap.
+
+function harness(snapshots: string[]) {
+  let index = 0;
+  const connect = vi.fn(async () => {
+    index = Math.min(index + 1, snapshots.length - 1);
+  });
+  return {
+    connect,
+    signature: () => snapshots[index],
+    wait: vi.fn(async () => {}),
+  };
+}
+
+it('keeps reconnecting until the text stops changing, so a cut-off reply fills in', async () => {
+  const h = harness(['1 2 3', '1 2 3 4 5 6', '1 2 3 4 5 6 7 8 9', '1 2 3 4 5 6 7 8 9']);
+  const result = await resyncUntilStable({
+    ...h,
+    isBusy: () => false,
+    isCancelled: () => false,
+  });
+  expect(h.signature()).toBe('1 2 3 4 5 6 7 8 9');
+  expect(result).toEqual({ settled: true, rounds: 4 });
+});
+
+it('stops after two identical re-syncs when nothing was missing', async () => {
+  const h = harness(['complete']);
+  const result = await resyncUntilStable({
+    ...h,
+    isBusy: () => false,
+    isCancelled: () => false,
+  });
+  expect(h.connect).toHaveBeenCalledTimes(2);
+  expect(result).toEqual({ settled: true, rounds: 2 });
+});
+
+it('waits the configured delays between re-syncs', async () => {
+  const h = harness(['a']);
+  await resyncUntilStable({
+    ...h,
+    isBusy: () => false,
+    isCancelled: () => false,
+    delaysMs: [10, 20, 30],
+  });
+  expect((h.wait.mock.calls as unknown as number[][]).map((call) => call[0])).toEqual([10, 20]);
+});
+
+it('gives up, without throwing, when the text never settles', async () => {
+  let n = 0;
+  const connect = vi.fn(async () => {
+    n += 1;
+  });
+  const result = await resyncUntilStable({
+    connect,
+    signature: () => String(n),
+    isBusy: () => false,
+    isCancelled: () => false,
+    wait: async () => {},
+    delaysMs: [1, 1, 1],
+  });
+  expect(connect).toHaveBeenCalledTimes(3);
+  expect(result).toEqual({ settled: false, rounds: 3 });
+});
+
+it('does not touch the thread once this page started its own run', async () => {
+  const h = harness(['a', 'b']);
+  let busy = false;
+  h.wait.mockImplementation(async () => {
+    busy = true;
+  });
+  const result = await resyncUntilStable({
+    ...h,
+    isBusy: () => busy,
+    isCancelled: () => false,
+  });
+  expect(h.connect).not.toHaveBeenCalled();
+  expect(result).toEqual({ settled: false, rounds: 0 });
+});
+
+it('stops when the chat is closed', async () => {
+  const h = harness(['a', 'b', 'c']);
+  let cancelled = false;
+  h.connect.mockImplementation(async () => {
+    cancelled = true;
+  });
+  const result = await resyncUntilStable({
+    ...h,
+    isBusy: () => false,
+    isCancelled: () => cancelled,
+  });
+  expect(h.connect).toHaveBeenCalledTimes(1);
+  expect(result.settled).toBe(false);
+});
+
+it('survives a failed re-sync and counts it as not settled', async () => {
+  const h = harness(['a']);
+  h.connect.mockRejectedValueOnce(new Error('socket closed'));
+  const result = await resyncUntilStable({
+    ...h,
+    isBusy: () => false,
+    isCancelled: () => false,
+  });
+  expect(result.settled).toBe(true);
+  expect(h.connect).toHaveBeenCalledTimes(3);
+});
+
+it('signature changes when a message grows, a message is added, or a tool call appears', () => {
+  const base = [{ id: 'a', role: 'assistant', content: 'abc' }];
+  const sig = messagesSignature(base);
+  expect(messagesSignature([{ id: 'a', role: 'assistant', content: 'abcd' }])).not.toBe(sig);
+  expect(messagesSignature([...base, { id: 'b', role: 'user', content: 'x' }])).not.toBe(sig);
+  expect(
+    messagesSignature([{ ...base[0], toolCalls: [{ id: 't', function: { name: 'n', arguments: '{}' } }] }]),
+  ).not.toBe(sig);
+  expect(messagesSignature(base)).toBe(sig);
+});
+
+it('signature reads text from structured content parts', () => {
+  const sig = (text: string) =>
+    messagesSignature([{ id: 'a', role: 'assistant', content: [{ type: 'text', text }] }]);
+  expect(sig('abcd')).not.toBe(sig('abc'));
+});
