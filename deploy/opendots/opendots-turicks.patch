diff --git a/src/client/thread-resync.ts b/src/client/thread-resync.ts
new file mode 100644
index 0000000..eef3d4e
--- /dev/null
+++ b/src/client/thread-resync.ts
@@ -0,0 +1,71 @@
+// turicks: opening a thread while its reply is still streaming, or within a second or two of the run
+// ending, replays only part of the reply and then the replay stream closes. The page kept the cut-off text
+// until the next reload. Re-running the cursor-preserving connect picks up the rest; this repeats it until
+// the transcript stops changing.
+
+type Message = {
+  id?: string;
+  role?: string;
+  content?: unknown;
+  toolCalls?: unknown;
+};
+
+function contentText(content: unknown): string {
+  if (typeof content === 'string') return content;
+  if (Array.isArray(content))
+    return content
+      .map((part) =>
+        part && typeof part === 'object' && 'text' in part
+          ? String((part as { text?: unknown }).text ?? '')
+          : '',
+      )
+      .join('');
+  return '';
+}
+
+export function messagesSignature(messages: readonly Message[]): string {
+  return JSON.stringify(
+    messages.map((m) => [
+      m.id ?? '',
+      m.role ?? '',
+      contentText(m.content),
+      JSON.stringify(m.toolCalls ?? null),
+    ]),
+  );
+}
+
+export const RESYNC_DELAYS_MS = [1000, 2000, 3000, 5000, 8000, 12000];
+
+export async function resyncUntilStable(options: {
+  connect: () => Promise<unknown>;
+  signature: () => string;
+  isBusy: () => boolean;
+  isCancelled: () => boolean;
+  wait?: (ms: number) => Promise<void>;
+  delaysMs?: number[];
+}): Promise<{ settled: boolean; rounds: number }> {
+  const wait =
+    options.wait ?? ((ms: number) => new Promise<void>((r) => setTimeout(r, ms)));
+  const delays = options.delaysMs ?? RESYNC_DELAYS_MS;
+  let previous = options.signature();
+  let stable = 0;
+  let rounds = 0;
+  for (const delay of delays) {
+    await wait(delay);
+    if (options.isCancelled() || options.isBusy()) return { settled: false, rounds };
+    rounds += 1;
+    let failed = false;
+    try {
+      await options.connect();
+    } catch {
+      // a failed background re-sync leaves the transcript as it was; the next round retries
+      failed = true;
+    }
+    if (options.isCancelled()) return { settled: false, rounds };
+    const current = options.signature();
+    stable = !failed && current === previous ? stable + 1 : 0;
+    previous = current;
+    if (stable >= 2) return { settled: true, rounds };
+  }
+  return { settled: false, rounds };
+}
