--- a/src/shared/scheduled-message.ts
+++ b/src/shared/scheduled-message.ts
@@ -16,3 +16,14 @@ export function isScheduledTaskMessage(
     metadata.opendotsSource === 'scheduled_task'
   );
 }
+
+// turicks: a scheduled shift keeps its state in GitHub and its computer, not in chat history. Send only
+// its own turn, so a shift costs the same however long its conversation gets.
+export function currentScheduledTurn<
+  M extends Pick<Message, 'id' | 'role' | 'metadata'>,
+>(messages: M[]): M[] {
+  const last = messages.findLastIndex((message) => message.role === 'user');
+  return last > 0 && isScheduledTaskMessage(messages[last])
+    ? messages.slice(last)
+    : messages;
+}
