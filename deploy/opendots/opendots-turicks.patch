diff --git a/tests/turicks.test.ts b/tests/turicks.test.ts
new file mode 100644
index 0000000..1ef6ce0
--- /dev/null
+++ b/tests/turicks.test.ts
@@ -0,0 +1,212 @@
+// turicks: the engineering team's shifts are recurring tasks. They must survive a failed or interrupted
+// run, and each shift sends only its own turn (its state lives in GitHub, not in chat history).
+import { afterEach, describe, expect, it, vi } from 'vitest';
+import { EventType, type RunAgentInput } from '@ag-ui/core';
+import { lastValueFrom, tap, toArray } from 'rxjs';
+import { mkdtempSync, rmSync } from 'node:fs';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+import { Store } from '../src/server/store.js';
+import { WorkspaceStore } from '../src/server/workspace.js';
+import { DotAgent } from '../src/server/dot-agent.js';
+import { completion } from './fixtures/model-stream.js';
+import {
+  currentScheduledTurn,
+  scheduledTaskMessagePrefix,
+} from '../src/shared/scheduled-message.js';
+
+const open: { store: Store; dir: string }[] = [];
+const workspaces: WorkspaceStore[] = [];
+function fixture() {
+  const dir = mkdtempSync(join(tmpdir(), 'opendots-'));
+  const store = new Store(join(dir, 'test.sqlite'));
+  open.push({ store, dir });
+  return store;
+}
+afterEach(() => {
+  vi.restoreAllMocks();
+  workspaces.splice(0).forEach((workspace) => workspace.close());
+  open.splice(0).forEach(({ store, dir }) => {
+    store.close();
+    rmSync(dir, { recursive: true, force: true });
+  });
+});
+
+describe('recurring shifts', () => {
+  it('stay on schedule after a failed or interrupted run', () => {
+    const store = fixture();
+    const task = store.createTask('Builder shift', 60);
+    const now = Date.now();
+    store.fail(store.claim(now)!, 'Intelligence runtime returned HTTP 502.');
+    expect(store.task(task.id)?.status).toBe('failed');
+    expect(store.claim(now + 30_000)).toBeNull();
+    const retry = store.claim(now + 120_000)!;
+    expect(retry.id).toBe(task.id);
+    store.interrupt(retry, 'Server stopped during this run.');
+    expect(store.task(task.id)?.status).toBe('interrupted');
+    expect(store.claim(Date.now() + 30_000)).toBeNull();
+    expect(store.claim(Date.now() + 120_000)?.id).toBe(task.id);
+  });
+  it('still stop when paused, and one-off tasks still wait for the owner', () => {
+    const store = fixture();
+    const shift = store.createTask('Reviewer shift', 60);
+    store.claim(Date.now());
+    store.action(shift.id, 'pause');
+    expect(store.claim(Date.now() + 120_000)).toBeNull();
+    const once = store.createTask('One-off research');
+    store.fail(store.claim(Date.now())!, 'Model error');
+    expect(store.claim(Date.now() + 3_600_000)).toBeNull();
+    expect(store.task(once.id)?.status).toBe('failed');
+  });
+});
+
+describe('currentScheduledTurn', () => {
+  const user = (id: string) => ({ id, role: 'user' as const, content: id });
+  const reply = (id: string) => ({
+    id,
+    role: 'assistant' as const,
+    content: id,
+  });
+  it('keeps only the latest scheduled shift and what follows it', () => {
+    const shift = `${scheduledTaskMessagePrefix}2`;
+    const messages = [
+      user(`${scheduledTaskMessagePrefix}1`),
+      reply('a'),
+      user('founder asks something'),
+      reply('b'),
+      user(shift),
+    ];
+    expect(currentScheduledTurn(messages).map((m) => m.id)).toEqual([shift]);
+  });
+  it('leaves a normal chat turn with its full history', () => {
+    const messages = [
+      user(`${scheduledTaskMessagePrefix}1`),
+      reply('a'),
+      user('hi'),
+    ];
+    expect(currentScheduledTurn(messages)).toBe(messages);
+  });
+});
+
+// turicks: a reply that hits the output cap used to end the run as "completed" (a cut-off tool call ran
+// with `{}` arguments and the loop stopped). A shift must show it as failed so it retries.
+describe('output limit', () => {
+  function agent() {
+    const store = fixture();
+    const workspace = new WorkspaceStore(':memory:', 'owner');
+    workspaces.push(workspace);
+    const dot = workspace.dots()[0];
+    workspace.bindThread('thread', dot.id, 'Shift');
+    const dotAgent = new DotAgent(
+      store,
+      workspace,
+      {
+        intelligenceKey: 'fixture',
+        apiKey: 'fixture',
+        model: 'custom-model',
+        baseUrl: 'https://unused.invalid/v1',
+        runtimeUrl: '',
+        voiceName: 'marin',
+        slackUsers: [],
+      },
+      dot.id,
+    );
+    const input: RunAgentInput = {
+      threadId: 'thread',
+      runId: 'run',
+      state: {},
+      context: [],
+      messages: [{ id: 'user', role: 'user', content: 'Write the file.' }],
+      tools: [],
+      forwardedProps: {},
+    };
+    return { dotAgent, input };
+  }
+  const types = (events: { type: EventType }[]) => events.map((e) => e.type);
+  const cutOff = "The model's reply was cut off at the output limit.";
+  // A thrown run reaches the task runner as RUN_ERROR through the Intelligence runtime (headless.ts),
+  // the same path as any other model error, so the shift is marked failed.
+  async function failedRun(run: ReturnType<DotAgent['run']>) {
+    const events: { type: EventType }[] = [];
+    await expect(
+      lastValueFrom(run.pipe(tap((event) => events.push(event)))),
+    ).rejects.toThrow(cutOff);
+    return events;
+  }
+
+  it('asks for up to 16000 output tokens', async () => {
+    const { dotAgent, input } = agent();
+    const network = vi
+      .spyOn(globalThis, 'fetch')
+      .mockResolvedValueOnce(
+        completion({ role: 'assistant', content: 'Done.' }),
+      );
+    const events = await lastValueFrom(dotAgent.run(input).pipe(toArray()));
+    expect(types(events)).toContain(EventType.RUN_FINISHED);
+    const request = JSON.parse(String(network.mock.calls[0][1]?.body));
+    expect(request.max_completion_tokens).toBe(16000);
+  });
+  it('fails a text reply cut off at the limit', async () => {
+    const { dotAgent, input } = agent();
+    vi.spyOn(globalThis, 'fetch').mockResolvedValueOnce(
+      completion(
+        { role: 'assistant', content: 'Fixing the probe path:' },
+        'length',
+      ),
+    );
+    const events = await failedRun(dotAgent.run(input));
+    expect(types(events)).not.toContain(EventType.RUN_FINISHED);
+  });
+  it('fails a tool call cut off at the limit instead of running it with {}', async () => {
+    const { dotAgent, input } = agent();
+    const network = vi.spyOn(globalThis, 'fetch').mockResolvedValueOnce(
+      completion(
+        {
+          role: 'assistant',
+          tool_calls: [
+            {
+              index: 0,
+              id: 'cut',
+              type: 'function',
+              function: {
+                name: 'create_space_page',
+                arguments: '{"title":"Notes","content":"# Not',
+              },
+            },
+          ],
+        },
+        'length',
+      ),
+    );
+    const events = await failedRun(dotAgent.run(input));
+    expect(types(events)).not.toContain(EventType.RUN_FINISHED);
+    expect(network).toHaveBeenCalledTimes(1);
+  });
+});
+
+// turicks: the phone opens the app in new tabs; the owner token must survive them.
+describe('owner token', () => {
+  function storage() {
+    const items = new Map<string, string>();
+    return {
+      getItem: (key: string) => items.get(key) ?? null,
+      setItem: (key: string, value: string) => void items.set(key, value),
+      removeItem: (key: string) => void items.delete(key),
+    };
+  }
+  // Each tab gets its own sessionStorage; localStorage is shared by the browser.
+  async function freshTab() {
+    vi.stubGlobal('sessionStorage', storage());
+    vi.resetModules();
+    return import('../src/client/api.js');
+  }
+  it('is remembered by the browser, not only the tab', async () => {
+    vi.stubGlobal('localStorage', storage());
+    (await freshTab()).setToken('owner-secret');
+    const tab = await freshTab();
+    expect(tab.authHeaders()).toEqual({ Authorization: 'Bearer owner-secret' });
+    tab.setToken('');
+    expect((await freshTab()).authHeaders()).toEqual({});
+    vi.unstubAllGlobals();
+  });
+});
