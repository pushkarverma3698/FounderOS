#!/usr/bin/env bash
#
# pr-brain — the asynchronous half of the Brain/Doer division.
#
# Antigravity (the doer) opens draft PRs. This sweeps every repository on the
# machine, finds open PRs whose current head has not been gated yet, and
# dispatches headless Claude Code to run the `pr-adversary` protocol on each:
# re-run the gate, try to disprove "done", then approve / push a fix /
# request changes. No human click anywhere in that loop.
#
# Idempotent: a PR is skipped once a marker comment for its exact head SHA
# exists, so re-running costs nothing and a new push re-opens the gate.
#
# Usage:
#   pr-brain                       # sweep all repos, act on up to $PR_BRAIN_MAX PRs
#   pr-brain --dry-run             # list what it would act on, spend nothing
#   pr-brain --repo ~/Projects/x   # one repo
#   pr-brain --pr 427 --repo .     # one specific PR, ignores the marker
#   pr-brain --list                # show discovered repos and exit
#
# Config:
#   ~/.claude/pr-brain.repos   one repo path per line ('#' comments). Absent => auto-discover.
#   ~/.claude/pr-brain.off     kill switch. Present => exit 0 immediately.
#   PR_BRAIN_MAX               PRs per sweep (default 3)
#   PR_BRAIN_MODEL             model for the gate (default sonnet)
#   PR_BRAIN_BUDGET_USD        per-PR spend cap (default 5)
#   PR_BRAIN_ROOT              where to auto-discover repos (default ~/Projects)
#   PR_BRAIN_ENV_FILE          dotenv holding TELEGRAM_BOT_TOKEN + TELEGRAM_CHAT_ID.
#                              Set it and every gate action is announced on Telegram.
#                              Unset => silent (log only).
#
# Log: ~/.claude/pr-brain.log

set -uo pipefail

LOG="$HOME/.claude/pr-brain.log"
OFF_SWITCH="$HOME/.claude/pr-brain.off"
REPO_LIST="$HOME/.claude/pr-brain.repos"
ROOT="${PR_BRAIN_ROOT:-$HOME/Projects}"
MAX="${PR_BRAIN_MAX:-3}"
MODEL="${PR_BRAIN_MODEL:-sonnet}"
BUDGET="${PR_BRAIN_BUDGET_USD:-5}"
# Only ever act on repositories and PRs belonging to this account. Auto-approving
# or pushing to an upstream project's PR is not a thing this may do by accident.
OWNER="${PR_BRAIN_OWNER:-$(gh api user --jq .login 2>/dev/null || echo __none__)}"
MARKER_PREFIX="<!-- brain-reviewed:"

DRY_RUN=0
ONE_REPO=""
ONE_PR=""
LIST_ONLY=0

# Always both: append to the log, and print to stdout so pipes and `ssh host
# 'pr-brain --dry-run'` show something. The cron line must therefore send stdout
# to /dev/null — if it redirects into $LOG as well, every line lands twice and the
# log reads as though two sweeps ran. Gating on `[[ -t 1 ]]` instead is wrong: it
# silences exactly the non-TTY callers that need the output.
log() {
  local line
  line="$(date -u '+%Y-%m-%dT%H:%M:%SZ')  $*"
  printf '%s\n' "$line" >>"$LOG"
  printf '%s\n' "$line"
}

# A gate that runs unattended and tells nobody is indistinguishable from a gate
# that never ran. Every action this script takes on GitHub is announced.
ENV_FILE="${PR_BRAIN_ENV_FILE:-}"
notify() {
  [[ -n "$ENV_FILE" && -f "$ENV_FILE" ]] || return 0
  local token chat
  token=$(grep -m1 '^TELEGRAM_BOT_TOKEN=' "$ENV_FILE" | cut -d= -f2- | tr -d '"'"'"'\r')
  chat=$(grep -m1 '^TELEGRAM_CHAT_ID=' "$ENV_FILE" | cut -d= -f2- | tr -d '"'"'"'\r')
  [[ -n "$token" && -n "$chat" ]] || return 0
  curl -s -o /dev/null --max-time 20 \
    "https://api.telegram.org/bot${token}/sendMessage" \
    --data-urlencode "chat_id=${chat}" \
    --data-urlencode "text=$1" \
    --data "disable_web_page_preview=true" || true
}

# Send one screenshot with a caption. Text alone cannot answer "does it LOOK
# right" — the whole reason the app gate exists is that nothing in this loop ever
# showed the founder the running product. Bounded by its caller to two images per
# gated head: the 2026-09-08 audit found pr-brain's unthrottled notifications had
# taken 21% of the entire Telegram history, and a photo costs more attention than
# a line of text, not less.
notify_photo() {
  [[ -n "$ENV_FILE" && -f "$ENV_FILE" ]] || return 0
  [[ -f "$1" ]] || return 0
  local token chat
  token=$(grep -m1 '^TELEGRAM_BOT_TOKEN=' "$ENV_FILE" | cut -d= -f2- | tr -d '"'"'"'\r')
  chat=$(grep -m1 '^TELEGRAM_CHAT_ID=' "$ENV_FILE" | cut -d= -f2- | tr -d '"'"'"'\r')
  [[ -n "$token" && -n "$chat" ]] || return 0
  curl -s -o /dev/null --max-time 60 \
    "https://api.telegram.org/bot${token}/sendPhoto" \
    -F "chat_id=${chat}" \
    -F "photo=@$1" \
    -F "caption=$2" || true
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --dry-run) DRY_RUN=1; shift ;;
    --repo) ONE_REPO="${2:-}"; shift 2 ;;
    --pr) ONE_PR="${2:-}"; shift 2 ;;
    --list) LIST_ONLY=1; shift ;;
    -h|--help) sed -n '3,32p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) echo "pr-brain: unknown argument '$1' (try --help)" >&2; exit 2 ;;
  esac
done

if [[ -f "$OFF_SWITCH" ]]; then
  log "kill switch present ($OFF_SWITCH) — nothing dispatched"
  exit 0
fi

# A gate can outlast the 20-minute cron interval. Without a lock the next tick
# starts a second sweep on the same PR — the marker comment is only written at
# the END of a gate, so it cannot prevent an overlap, only a repeat. mkdir is the
# portable atomic test-and-set (flock is absent on macOS).
LOCK="$HOME/.claude/pr-brain.lock"
if [[ "$DRY_RUN" -eq 0 && "$LIST_ONLY" -eq 0 ]]; then
  if ! mkdir "$LOCK" 2>/dev/null; then
    # A crashed sweep would otherwise wedge the gate forever. Two hours is well
    # past any legitimate run.
    if [[ -n "$(find "$LOCK" -maxdepth 0 -mmin +120 2>/dev/null)" ]]; then
      log "stale lock older than 120m — reclaiming"
      rm -rf "$LOCK" && mkdir "$LOCK" 2>/dev/null || { log "could not reclaim lock"; exit 0; }
    else
      log "another sweep is running ($LOCK) — this tick does nothing"
      exit 0
    fi
  fi
  trap 'rm -rf "$LOCK"' EXIT
fi

for dep in gh claude git; do
  command -v "$dep" >/dev/null 2>&1 || { log "FATAL: '$dep' not on PATH"; exit 1; }
done
gh auth status >/dev/null 2>&1 || { log "FATAL: gh is not authenticated"; exit 1; }

# Keep the log bounded — this runs every 20 minutes forever.
if [[ -f "$LOG" ]] && [[ "$(wc -l <"$LOG")" -gt 20000 ]]; then
  tail -n 5000 "$LOG" >"$LOG.tmp" && mv "$LOG.tmp" "$LOG"
fi

# Preflight the model auth. Without this the sweep fails once per PR, twenty
# minutes apart, forever, and the only symptom is a log nobody reads. An
# unattended loop that cannot do its job must say so in one unmistakable line.
if [[ "$DRY_RUN" -eq 0 && "$LIST_ONLY" -eq 0 ]]; then
  preflight=$(claude -p "reply with the single word ok" --model "$MODEL" \
                --max-budget-usd 0.05 --output-format text 2>&1 | tail -2)
  case "$preflight" in
    *"authenticate"*|*401*|*"Invalid API key"*)
      log "FATAL: Claude Code cannot authenticate — every gate would fail silently."
      log "       Fix: run 'claude' interactively, then '/login'. Sweep aborted, nothing dispatched."
      notify "🧠 pr-brain STOPPED on $(hostname -s): Claude Code auth expired. No PR is being gated until someone runs 'claude' then '/login'."
      exit 1
      ;;
  esac
fi

# ---------------------------------------------------------------- repositories

discover_repos() {
  if [[ -n "$ONE_REPO" ]]; then
    printf '%s\n' "$(cd "$ONE_REPO" && pwd)"
    return
  fi
  if [[ -f "$REPO_LIST" ]]; then
    grep -vE '^\s*(#|$)' "$REPO_LIST" | while read -r line; do
      dir="${line/#\~/$HOME}"
      [[ -d "$dir/.git" ]] && printf '%s\n' "$dir"
    done
    return
  fi
  # Auto-discover: any immediate child of $ROOT that is a git repo whose origin
  # belongs to $OWNER or allowed organizations like OplifyMessage.
  local allowed_orgs=("$OWNER" "OplifyMessage")
  for dir in "$ROOT"/*/; do
    [[ -d "$dir/.git" ]] || continue
    remote=$(git -C "$dir" remote get-url origin 2>/dev/null || true)
    [[ "$remote" == *github.com* ]] || continue
    for org in "${allowed_orgs[@]}"; do
      case "$remote" in
        *"github.com/$org/"*|*"github.com:$org/"*)
          printf '%s\n' "${dir%/}"
          break
          ;;
      esac
    done
  done
}

# macOS ships bash 3.2 — no mapfile, and `set -u` trips on empty arrays. A
# newline-delimited string is the portable option here.
REPOS=$(discover_repos)
REPO_COUNT=$(printf '%s' "$REPOS" | grep -c . || true)

if [[ "$LIST_ONLY" -eq 1 ]]; then
  printf 'pr-brain would sweep %s repo(s):\n' "$REPO_COUNT"
  printf '%s\n' "$REPOS" | sed 's/^/  /'
  exit 0
fi

if [[ "$REPO_COUNT" -eq 0 ]]; then
  log "no GitHub repositories found under $ROOT"
  exit 0
fi

# ------------------------------------------------------------------ the sweep

# The prompt is deliberately thin: the protocol lives in the pr-adversary skill
# so that a fix to the protocol reaches every future sweep. A prompt that
# restates the rules is a second copy that will drift.
build_prompt() {
  local pr="$1" repo_name="$2" head="$3" app_rc="${4:-3}"
  local app_line
  case "$app_rc" in
    0) app_line="The browser gate ran on this branch and rendered the app's public pages with no blocking defects. Its evidence pack is a PR comment containing the marker <!-- app-evidence -->. READ IT — it names which screens were NOT covered, and those remain unverified." ;;
    1) app_line="The browser gate ran on this branch and found BLOCKING defects, or the app did not build/start at all. Its evidence pack is a PR comment containing the marker <!-- app-evidence -->. Treat that as a BLOCKER unless you can show the finding is the gate's own fault." ;;
    *) app_line="The browser gate did NOT run on this branch (no recipe for this repo, a diff it does not cover, or it failed to start). No page was rendered, so you may not claim any visual or runtime verification — say NOT VERIFIED and name this as the reason." ;;
  esac
  cat <<EOF
Act on pull request #${pr} in ${repo_name} as the brain in the Brain/Doer division.

BROWSER EVIDENCE (already gathered for you, before you were dispatched):
${app_line}

Invoke the pr-adversary skill and follow it exactly. An executor (Antigravity) wrote this PR;
your default posture is disproof, not agreement. Green CI is a necessary condition, never the
verdict.

CRITICAL FIRST LAYER OF THINKING — WAS THIS WORK REALLY REQUIRED?
Before evaluating implementation details or running tests, you MUST reason about necessity:
1. Was the work done on this branch actually necessary to achieve the stated goal?
2. Did the executor invent artificial problems, over-engineer a simple request, add speculative abstractions, or touch code that was already working?
3. Is this change solving an actual observed defect or delivering real requested user value, rather than performing busywork or unnecessary refactoring?
If the change was NOT genuinely required or over-complicates the system, treat that as a primary BLOCKER. Explain why it is not required and request changes.

You are running headless and unattended. That means:
- Finish with exactly one action taken on GitHub: approve (+ gh pr ready), push the smallest
  correct fix to the PR branch and comment what you fixed, or request changes with a concrete
  failure scenario. Never end with no action.
- Never force-push, never rewrite the executor's commits, never merge to main/master.
- If the working tree is being actively edited (agy-guard reports a live conversation), post a
  comment saying the gate was deferred and why, and stop.
- If you cannot verify a product-behaviour claim without running the real product, say
  NOT VERIFIED in the review body and hand that back rather than approving it.
- If the branch is behind its base, you may merge the base in locally to run the gate on an
  up-to-date tree, but do not push that merge back unless it's the actual fix you're making.

Then, as the last thing you do, stamp the PR's real remote head SHA so it is not re-gated
unchanged. Use exactly this value — ${head} — not the output of 'git rev-parse HEAD', which
reflects your local checkout and will be wrong if you merged the base in locally without pushing:
  gh pr comment ${pr} --body "${MARKER_PREFIX} ${head} -->"
EOF
}

# ------------------------------------------------------- the app (browser) gate
#
# THE LAST NODE. Everything else in this loop reads code: CI compiles it, the
# unit gate runs it in isolation, the adversarial audit reads the diff. Nothing
# STARTED the product. On a front-end repository that produced an honest but
# useless review body — "NOT VERIFIED: the page renders" — followed by a pass,
# because the protocol's rule is to hand that gap back rather than pretend.
#
# So the gate runs BEFORE the reviewer is dispatched, and posts its evidence pack
# on the PR. The reviewer then READS evidence instead of being told to go and
# produce it: CLAUDE.md rule #27 measured CI-enforced rules drifting zero times
# in a month against markdown rules drifting three times in a day. An instruction
# in a skill file is the weaker half of this; the artifact is the strong half.
#
# It is bounded, skippable and never fatal. A repo with no recipe, a diff that
# touches nothing it covers, a missing FounderOS checkout, or a timeout all leave
# a comment saying so. What must never happen is silence, because a gate that did
# not run and a gate that found nothing look identical from outside.
QA_ROOT="${QA_APP_ROOT:-/opt/founderos}"
QA_TIMEOUT="${QA_APP_TIMEOUT_SEC:-1500}"
APP_MARKER="<!-- app-evidence -->"

# Replace the previous pack in place rather than appending a new comment per
# push: same reasoning as the UI gate's single updated comment.
post_app_evidence() {
  local pr="$1" body="$2" existing
  existing=$(gh pr view "$pr" --json comments \
               --jq "[.comments[] | select(.body | contains(\"$APP_MARKER\")) | .url] | .[-1] // empty" 2>/dev/null || true)
  if [[ -n "$existing" ]]; then
    local cid; cid="${existing##*-}"
    local slug; slug=$(gh repo view --json nameWithOwner --jq .nameWithOwner 2>/dev/null)
    if [[ -n "$cid" && -n "$slug" ]] && gh api -X PATCH "repos/${slug}/issues/comments/${cid}" \
         -f body="$body" >/dev/null 2>&1; then
      return 0
    fi
  fi
  gh pr comment "$pr" --body "$body" >/dev/null 2>&1 || true
}

# Echoes the gate's own exit code: 0 clean · 1 blocking · 3 not applicable.
app_gate() {
  local pr="$1" slug="$2" repo_dir="$3" head="$4"
  local out="/tmp/app-qa/${slug//\//__}/${pr}"
  local base rc report

  if [[ ! -f "$QA_ROOT/scripts/qa-app.ts" ]]; then
    post_app_evidence "$pr" "$APP_MARKER
## App Evidence Pack — NOT RUN

- ⏭️ **SKIPPED** — no FounderOS checkout at \`$QA_ROOT\`, so the browser gate could not be started.
- ⚠️ No page on this branch was rendered. This is **not** a clean visual result; it is the absence of one."
    return 3
  fi

  base=$(gh pr view "$pr" --json baseRefName --jq .baseRefName 2>/dev/null || echo "")
  rm -rf "$out"; mkdir -p "$out"

  # Runs from $QA_ROOT so tsx and playwright resolve. READ-ONLY with respect to
  # that tree: no checkout, no merge, no install — /opt/founderos is the live
  # production working copy and switching its branch takes the bot down.
  ( cd "$QA_ROOT" && timeout "$QA_TIMEOUT" node --import tsx/esm scripts/qa-app.ts \
      --dir "$repo_dir" --repo "$slug" --out "$out" \
      ${base:+--changed-from "origin/$base"} ) >>"$LOG" 2>&1
  rc=$?

  if [[ ! -f "$out/report.md" ]]; then
    post_app_evidence "$pr" "$APP_MARKER
## App Evidence Pack — DID NOT COMPLETE

- ⏭️ **SKIPPED** — \`pnpm qa:app\` exited ${rc} without writing a report$([[ $rc -eq 124 ]] && echo " (timed out after ${QA_TIMEOUT}s)").
- ⚠️ No page on this branch was rendered. Treat visual behaviour as **NOT VERIFIED**; see \`$LOG\`."
    return 3
  fi

  report=$(cat "$out/report.md")
  post_app_evidence "$pr" "$APP_MARKER
$report"

  # Photos only when the gate actually rendered something, only on the head being
  # gated, and only two of them.
  if [[ $rc -eq 0 || $rc -eq 1 ]]; then
    local verdict; verdict=$([[ $rc -eq 0 ]] && echo "✅ no blocking defects" || echo "❌ BLOCKING defects")
    local n=0
    while IFS= read -r shot; do
      [[ $n -ge 2 ]] && break
      notify_photo "$shot" "$slug#${pr} · $(basename "$shot" .png) · ${verdict}"
      n=$((n + 1))
    done < <(find "$out/screenshots" -name '*.png' 2>/dev/null | sort)
  fi

  return $rc
}

acted=0

while IFS= read -r repo; do
  [[ -z "$repo" ]] && continue
  [[ "$acted" -ge "$MAX" ]] && break

  pushd "$repo" >/dev/null 2>&1 || continue
  repo_name=$(basename "$repo")
  # Derived the same way discover_repos() reads org membership from the remote —
  # needed here too so the merge step can single out employer/org repos below.
  repo_owner=$(git remote get-url origin 2>/dev/null | sed -E 's#.*[:/]([^/]+)/[^/]+(\.git)?$#\1#')

  # This checkout is dedicated review scratch space, not precious work — the same
  # invariant agent-dispatch's workspace already relies on. Without an unconditional
  # reset here, a prior gate that crashed, timed out, or ran `git stash -u` and never
  # dropped it (observed: /opt/review/founderos sitting on a stale PR branch with 2
  # orphaned stashes, 2026-09-10 through 2026-09-14) leaves the tree dirty for every
  # future sweep. `pnpm test`/`pnpm gate` then fails on files the DIRT introduced —
  # not on anything the PR under review touched — and got excused in three past
  # reviews as "pre-existing failures," which is a false pass: the founderos main
  # branch itself is clean (0 failures, verified 2026-09-14). Reset before every
  # repo's sweep, not just once at setup, since the dirt can reappear each tick.
  if ! git reset --hard --quiet 2>/dev/null || ! git clean -fdq 2>/dev/null; then
    log "$repo_name: could not reset review checkout to clean — skipping this sweep"
    popd >/dev/null
    continue
  fi
  git stash clear 2>/dev/null || true

  if [[ -n "$ONE_PR" ]]; then
    prs="$ONE_PR"
  else
    # Own PRs only, from a branch in this repo (never a fork), not opted out.
    prs=$(gh pr list --state open --limit 20 \
            --json number,headRefOid,labels,updatedAt,author,isCrossRepository \
            --jq "sort_by(.updatedAt) | reverse | .[]
                  | select(.isCrossRepository == false)
                  | select(.author.login == \"$OWNER\")
                  | select([.labels[].name] | index(\"no-brain\") | not)
                  | \"\(.number) \(.headRefOid)\"" 2>/dev/null || true)
  fi

  [[ -z "$prs" ]] && { popd >/dev/null; continue; }

  while read -r pr head; do
    [[ -z "$pr" ]] && continue
    [[ "$acted" -ge "$MAX" ]] && break

    # A PR is gated once per head SHA. A new push re-opens it.
    if [[ -z "$ONE_PR" ]]; then
      head="${head:-$(gh pr view "$pr" --json headRefOid --jq .headRefOid 2>/dev/null)}"
      if gh pr view "$pr" --json comments \
           --jq '[.comments[].body] | join("\n")' 2>/dev/null | grep -qF "$MARKER_PREFIX $head"; then
        log "$repo_name#$pr already gated at $head — skipped"
        continue
      fi
    fi

    # Resolve the real remote head fresh, right before dispatch — unconditionally,
    # covering --pr mode too (where the check block above is skipped and $head is
    # otherwise empty). This is the value that gets stamped in the marker; it must
    # never be substituted with a locally-computed 'git rev-parse HEAD' inside the
    # session, which can reflect an unpushed local merge. That exact bug caused
    # founderos#451 to be re-gated every 20 minutes for 9 hours (2026-08-11/12) —
    # the marker kept recording an unpushed merge SHA that never matched the next
    # sweep's real headRefOid, so the "already gated" skip never fired.
    head="$(gh pr view "$pr" --json headRefOid --jq .headRefOid 2>/dev/null)"
    if [[ -z "$head" ]]; then
      log "$repo_name#$pr could not resolve head SHA — skipping"
      continue
    fi

    if [[ "$DRY_RUN" -eq 1 ]]; then
      log "DRY RUN would gate $repo_name#$pr (head ${head:0:8})"
      acted=$((acted + 1))
      continue
    fi

    # Browser evidence FIRST, so the reviewer finds it already on the PR. A
    # reviewer told to go and run the app is a reviewer who reports NOT VERIFIED
    # and clears it anyway — measured on OplifyMessage/oplify-messaging-app#33.
    app_gate "$pr" "${repo_owner}/${repo_name}" "$repo" "$head"
    app_rc=$?
    case "$app_rc" in
      0) log "$repo_name#$pr app gate: rendered, no blocking defects" ;;
      1) log "$repo_name#$pr app gate: BLOCKING defects — evidence posted on the PR" ;;
      *) log "$repo_name#$pr app gate: not applicable or did not run (rc=$app_rc)" ;;
    esac

    log "gating $repo_name#$pr (head ${head:0:8}) model=$MODEL budget=\$$BUDGET"
    if claude -p "$(build_prompt "$pr" "$repo_name" "$head" "$app_rc")" \
        --model "$MODEL" \
        --permission-mode acceptEdits \
        --allowedTools "Bash Read Write Edit Grep Glob TodoWrite Skill" \
        --max-budget-usd "$BUDGET" \
        --output-format text >>"$LOG" 2>&1; then
      log "$repo_name#$pr gate finished"
      # Report the verdict GitHub actually recorded, not what the run claimed.
      #
      # GitHub returns reviewDecision as "" (not null) when no decision exists, and it
      # ALWAYS will here: the executor opens PRs under this same account and GitHub
      # refuses self-approval ("Can not approve your own pull request"). So the real
      # signal is draft→ready, and `// "..."` cannot supply it — jq's // only catches
      # null/false, never "". Read the state in plain words or the founder gets a
      # message with a blank where the verdict should be.
      verdict=$(gh pr view "$pr" --json reviewDecision,isDraft,title --jq '
                  (if   .reviewDecision == "CHANGES_REQUESTED" then "CHANGES REQUESTED — blocked"
                   elif .reviewDecision == "APPROVED"          then "APPROVED"
                   elif .isDraft                               then "REVIEWED, left as draft — not cleared"
                   else "CLEARED — marked ready for merge (self-approval impossible; ready IS the pass)"
                   end) + " · " + .title' 2>/dev/null \
                || echo "unknown — could not read PR state")
      log "$repo_name#$pr verdict: $verdict"

      # The documented pipeline (src/tools/dispatch-antigravity.ts's own header
      # comment) ends "pr-brain (Claude review, every 20 min) → Merge". That arrow
      # never existed in code — pr-brain gated, GitHub does not allow self-approval
      # so the pass signal is draft->ready, and nothing after that ever merged
      # anything. Found 2026-09-14: 3 PRs sat CLEARED, all CI green, mergeable,
      # for 4 days because of exactly this gap. Only the CLEARED case merges, and
      # even then never main/master, and never ANY branch in an employer/org repo
      # ($repo_owner != $OWNER — see the OplifyMessage carve-out below) — a main
      # merge, or any merge into a repo we don't personally own, is the founder's
      # call (restored 2026-09-21: this guard existed originally, was silently
      # dropped, and the comment above the dropped code kept claiming it still
      # ran — see docs/sessions/2026-09-21-oplify-onboarding-and-safety-fixes.md).
      # No --auto / no allow_auto_merge dependency: branch protection already
      # requires both checks server-side, and by the time a PR reaches this line
      # the pr-adversary gate re-ran them in-session and GitHub's own Actions run
      # (which starts on push, long before the next 20-min sweep) has already
      # finished — so an immediate merge attempt either succeeds because they're
      # actually green, or fails loud because they are not.
      merge_result="not attempted (verdict was not CLEARED)"
      case "$verdict" in
        "CLEARED"*)
          base=$(gh pr view "$pr" --json baseRefName --jq .baseRefName 2>/dev/null)
          if [[ "$repo_owner" == "OplifyMessage" ]]; then
            # Employer repo. founderOS reviews, fixes, and marks ready — a human
            # merges from GitHub or the phone, every time, no exceptions.
            merge_result="not attempted — $repo_owner is an employer org; a human merges"
            gh pr ready "$pr" >>"$LOG" 2>&1 || true
            log "$repo_name#$pr cleared — marked ready, merge withheld ($repo_owner org)"
          elif [[ "$base" == "main" || "$base" == "master" ]]; then
            merge_result="skipped — base is $base, a main/master merge needs the founder"
            log "$repo_name#$pr merge skipped — base is $base"
          elif gh pr merge "$pr" --squash >>"$LOG" 2>&1; then
            merge_result="merged (squash) into $base"
            log "$repo_name#$pr merge: squashed into $base"

            # If base was beta, auto-promote to main
            if [[ "$base" == "beta" ]]; then
              log "$repo_name#$pr is on beta — triggering auto-promotion to main"
              promo_pr=$(gh pr list --base main --head beta --state open --json number --jq '.[0].number // empty' 2>/dev/null || true)
              if [[ -z "$promo_pr" ]]; then
                # `gh pr create` has no --json flag — it prints the created PR's
                # URL on stdout. Resolving the number through `gh pr view <url>`
                # was missing before; without it a create failure or success was
                # indistinguishable and this promotion path never actually fired
                # (found 2026-09-21: silently swallowed by `|| true` below).
                promo_url=$(gh pr create --base main --head beta --title "chore: promote beta to main" --body "Automated promotion after PR #${pr} cleared and merged into beta." 2>/dev/null || true)
                if [[ -n "$promo_url" ]]; then
                  promo_pr=$(gh pr view "$promo_url" --json number --jq .number 2>/dev/null || true)
                fi
              fi
              if [[ -n "$promo_pr" ]]; then
                gh pr merge "$promo_pr" --auto --squash 2>/dev/null || gh pr merge "$promo_pr" --squash 2>/dev/null || true
                log "$repo_name auto-promoted beta to main (PR #${promo_pr})"
              fi
            fi
          elif gh pr update-branch "$pr" >>"$LOG" 2>&1; then
            # $base has a `strict` required-status-checks policy (verified
            # 2026-09-14): a CLEARED, all-green PR can still be refused with
            # "the head branch is not up to date with the base branch" — checks
            # must have run on the EXACT current commit, not merely have passed
            # on an older one (found live merging #671/#672/#673). update-branch
            # pushes a merge-with-base commit, which changes headRefOid — the
            # existing marker-comment mechanism then treats this PR as unguarded
            # on the NEXT sweep, so it gets a real re-gate and a fresh merge
            # attempt naturally, on a branch that is current by construction.
            # Deliberately not polling for CI here: a synchronous wait inside a
            # 20-minute cron tick either blocks the next tick or needs its own
            # timeout/retry machinery, and the marker cycle already provides one
            # for free at the cost of a single extra sweep.
            merge_result="was behind $base — ran update-branch, next sweep re-gates and retries"
            log "$repo_name#$pr merge deferred — updated branch against $base, will re-gate on next sweep"
          else
            merge_result="FAILED — see log ($LOG)"
            log "$repo_name#$pr merge FAILED — see $LOG"
          fi
          ;;
      esac

      notify "🧠 Gate done — ${repo_name}#${pr}
${verdict}
Merge: ${merge_result}
$(gh pr view "$pr" --json url --jq .url 2>/dev/null)"
    else
      log "$repo_name#$pr gate FAILED (exit $?) — see $LOG; PR left unstamped so the next sweep retries"
      notify "⚠️ Gate FAILED to complete — ${repo_name}#${pr}. Left unstamped; next sweep retries. Log: ~/.claude/pr-brain.log"
    fi
    acted=$((acted + 1))
  done <<<"$prs"

  popd >/dev/null
done <<<"$REPOS"

log "sweep complete — $acted PR(s) acted on (max $MAX)"
