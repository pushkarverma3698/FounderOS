#!/usr/bin/env bash
#
# pr-brain — the asynchronous half of the Brain/Doer division.
#
# Antigravity (the doer) opens draft PRs. This sweeps every repository on the
# machine, finds open PRs whose current head has not been gated yet, and
# dispatches a headless reviewer to run the `pr-adversary` protocol on each:
# re-run the gate, try to disprove "done", then clear it or request changes.
# No human click anywhere in that loop.
#
# THE REVIEWER IS AN ENGINE, chosen by PR_BRAIN_ENGINE:
#   agy     (default) the Antigravity CLI, as the antigravity user, in a fresh conversation on a clean
#           checkout of the PR head. Its model (PR_BRAIN_MODEL, default claude-sonnet-4-6) is NOT the
#           executor's (gemini-3.6-flash-medium): the executor is never its own grader, which is the
#           whole reason this loop has a separate reviewer. It cannot push (the checkout's push URL is
#           disabled) and it does not stamp or decide: it ends its answer with `BRAIN-VERDICT: PASS` or
#           `FAIL`, and this script makes the PR's state agree and posts the marker itself.
#   claude  headless Claude Code, as before (needs the Claude login; PR_BRAIN_ENGINE=claude).
# Claude went down for a week on its usage limit (2026-10-02, resets 10-05) and the whole review half of the
# loop stopped with it: the reviewer must not depend on one vendor's subscription.
#
# Idempotent: a PR is skipped once a marker comment for its exact head SHA
# exists, so re-running costs nothing and a new push re-opens the gate.
#
# Usage:
#   pr-brain                       # sweep all repos, act on up to $PR_BRAIN_MAX PRs
#   pr-brain --dry-run             # list what it would act on, spend nothing
#   pr-brain --repo ~/Projects/x   # one repo
#   pr-brain --pr 427 --repo .     # one specific PR, ignores the marker
#   pr-brain --list                # show discovered repos and exit
#
# Config:
#   ~/.claude/pr-brain.repos   one repo path per line ('#' comments). Absent => auto-discover.
#   ~/.claude/pr-brain.off     kill switch. Present => exit 0 immediately.
#   PR_BRAIN_MAX               PRs per sweep (default 3)
#   PR_BRAIN_ENGINE            agy (default) or claude, see above
#   PR_BRAIN_MODEL             model for the gate (default claude-sonnet-4-6 for agy, sonnet for claude)
#   PR_BRAIN_TIMEOUT_SEC       agy engine: one review's time limit (default 1800)
#   PR_BRAIN_BUDGET_USD        claude engine: per-PR spend cap (default 5)
#   PR_BRAIN_ROOT              where to auto-discover repos (default ~/Projects)
#   PR_BRAIN_ENV_FILE          dotenv holding TELEGRAM_BOT_TOKEN + TELEGRAM_CHAT_ID.
#                              Set it and every gate action is announced on Telegram.
#                              Unset => silent (log only).
#   PR_BRAIN_MAX_ATTEMPTS      failed gates on one head before it stops retrying (default 3)
#
# State:
#   ~/.claude/pr-brain.down        present while the reviewer is unavailable (auth, usage
#                                  limit, overload). One Telegram message when it
#                                  appears, one when it goes — nothing per tick.
#   ~/.claude/pr-brain.failures/   one file per PR: "<head> <failed-attempts>".
#   ~/.claude/pr-brain.photos/     one file per PR: the head whose screenshots were sent.
#
# Log: ~/.claude/pr-brain.log

set -uo pipefail

LOG="$HOME/.claude/pr-brain.log"
OFF_SWITCH="$HOME/.claude/pr-brain.off"
REPO_LIST="$HOME/.claude/pr-brain.repos"
ROOT="${PR_BRAIN_ROOT:-$HOME/Projects}"
MAX="${PR_BRAIN_MAX:-3}"
ENGINE="${PR_BRAIN_ENGINE:-agy}"
case "$ENGINE" in
  agy) MODEL="${PR_BRAIN_MODEL:-claude-sonnet-4-6}"; REVIEWER_NAME="the Antigravity reviewer" ;;
  claude) MODEL="${PR_BRAIN_MODEL:-sonnet}"; REVIEWER_NAME="Claude" ;;
  *) echo "pr-brain: PR_BRAIN_ENGINE must be agy or claude, not '$ENGINE'" >&2; exit 2 ;;
esac
BUDGET="${PR_BRAIN_BUDGET_USD:-5}"
# agy engine. The reviewer runs as the same Linux user as the executor (the only one with an agy login) but in
# its OWN clone, never the executor's workspace and never /opt/review (founderos-owned, not writable for it).
AG_USER="${PR_BRAIN_AGY_USER:-antigravity}"
REVIEW_WS_BASE="${PR_BRAIN_REVIEW_WORKSPACES:-/opt/agy-workspace/review}"
SKILL_FILE="${PR_BRAIN_SKILL_FILE:-/opt/agent-rules/skills/pr-adversary/SKILL.md}"
GITHUB_URL="${PR_BRAIN_GITHUB_URL:-https://github.com}"   # where review clones come from (tests point it at a local directory)
TIMEOUT_SEC="${PR_BRAIN_TIMEOUT_SEC:-1800}"
PROGRESS_POLL_SEC="${PR_BRAIN_PROGRESS_POLL_SEC:-20}"
# shellcheck disable=SC2034  # read by deploy/lib/down-state.sh, which shellcheck does not follow
DOWN_FILE="$HOME/.claude/pr-brain.down"
FAIL_DIR="$HOME/.claude/pr-brain.failures"
PHOTO_DIR="$HOME/.claude/pr-brain.photos"
MAX_ATTEMPTS="${PR_BRAIN_MAX_ATTEMPTS:-3}"
# Only ever act on repositories and PRs belonging to this account. Auto-approving
# or pushing to an upstream project's PR is not a thing this may do by accident.
OWNER="${PR_BRAIN_OWNER:-$(gh api user --jq .login 2>/dev/null || echo __none__)}"
MARKER_PREFIX="<!-- brain-reviewed:"

DRY_RUN=0
ONE_REPO=""
ONE_PR=""
LIST_ONLY=0

# Always both: append to the log, and print to stdout so pipes and `ssh host
# 'pr-brain --dry-run'` show something. The cron line must therefore send stdout
# to /dev/null — if it redirects into $LOG as well, every line lands twice and the
# log reads as though two sweeps ran. Gating on `[[ -t 1 ]]` instead is wrong: it
# silences exactly the non-TTY callers that need the output.
log() {
  local line
  line="$(date -u '+%Y-%m-%dT%H:%M:%SZ')  $*"
  printf '%s\n' "$line" >>"$LOG"
  printf '%s\n' "$line"
}

# A gate that runs unattended and tells nobody is indistinguishable from a gate
# that never ran. Every action this script takes on GitHub is announced.
ENV_FILE="${PR_BRAIN_ENV_FILE:-}"
notify() {
  [[ -n "$ENV_FILE" && -f "$ENV_FILE" ]] || return 0
  local token chat
  token=$(grep -m1 '^TELEGRAM_BOT_TOKEN=' "$ENV_FILE" | cut -d= -f2- | tr -d '"'"'"'\r')
  chat=$(grep -m1 '^TELEGRAM_CHAT_ID=' "$ENV_FILE" | cut -d= -f2- | tr -d '"'"'"'\r')
  [[ -n "$token" && -n "$chat" ]] || return 0
  curl -s -o /dev/null --max-time 20 \
    "https://api.telegram.org/bot${token}/sendMessage" \
    --data-urlencode "chat_id=${chat}" \
    --data-urlencode "text=$1" \
    --data "disable_web_page_preview=true" || true
}

# Send one screenshot with a caption. Text alone cannot answer "does it LOOK
# right" — the whole reason the app gate exists is that nothing in this loop ever
# showed the founder the running product. Bounded by its caller to two images per
# gated head: the 2026-09-08 audit found pr-brain's unthrottled notifications had
# taken 21% of the entire Telegram history, and a photo costs more attention than
# a line of text, not less.
notify_photo() {
  [[ -n "$ENV_FILE" && -f "$ENV_FILE" ]] || return 0
  [[ -f "$1" ]] || return 0
  local token chat
  token=$(grep -m1 '^TELEGRAM_BOT_TOKEN=' "$ENV_FILE" | cut -d= -f2- | tr -d '"'"'"'\r')
  chat=$(grep -m1 '^TELEGRAM_CHAT_ID=' "$ENV_FILE" | cut -d= -f2- | tr -d '"'"'"'\r')
  [[ -n "$token" && -n "$chat" ]] || return 0
  curl -s -o /dev/null --max-time 60 \
    "https://api.telegram.org/bot${token}/sendPhoto" \
    -F "chat_id=${chat}" \
    -F "photo=@$1" \
    -F "caption=$2" || true
}

# Shared helpers (deploy/lib/), found next to THIS script's own real path: ./lib on the VPS (~/bin/lib, next to
# ~/bin/pr-brain), ../lib in the repo (deploy/lib, next to deploy/vps-daemons). deploy/sync-daemons.sh ships them
# with the daemons, and tests/unit/scripts/sync-daemons.test.ts fails when a file a daemon sources is not in that
# copy list. Without them there is no pause state, so refuse to run.
#   down-state.sh   one Telegram message per pause/resume + redact_secrets (shared with agent-dispatch)
#   agy-failure.sh  classify_agy_failure: quota | auth | transient | unknown
#   agy-run.sh      as_antigravity + agy_run: one agy turn, streamed live into ONE Telegram message
SELF_PATH="$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || printf '%s' "${BASH_SOURCE[0]}")"
SELF_DIR="$(cd "$(dirname "$SELF_PATH")" 2>/dev/null && pwd)"
for _lib in down-state.sh agy-failure.sh agy-run.sh; do
  _lib_path=""
  for _lib_dir in "$SELF_DIR/lib" "$SELF_DIR/../lib"; do
    [[ -f "$_lib_dir/$_lib" ]] && { _lib_path="$_lib_dir/$_lib"; break; }
  done
  if [[ -z "$_lib_path" ]]; then
    log "FATAL: lib/$_lib not found next to $SELF_PATH (looked in $SELF_DIR/lib and $SELF_DIR/../lib). deploy/sync-daemons.sh ships it with the daemons: re-run the Deploy workflow, or copy deploy/lib/ to ~/bin/lib/."
    exit 1
  fi
  # shellcheck source=/dev/null
  source "$_lib_path"
done

# ── A Claude token that outlives a login ─────────────────────────────────────────────
# The interactive Claude login expires, and an expired login pauses every gate until
# somebody ssh'es in and runs /login. A token made once with `claude setup-token` does
# not need that. It lives in ~/.claude/pr-brain.token, mode 0600:
#   line 1   the token
#   line 2   the date it was created, YYYY-MM-DD (the age warning counts from it)
# When the file is usable, run_claude hands the token to `claude` through the environment
# of that one command: never an argument, never logged, never seen by gh or git. Without
# the file nothing changes and the interactive login is used as before.
#
# How long such a token lasts is NOT verified here. TOKEN_WARN_DAYS is a guess at "about a
# year, less a margin": confirm with `claude setup-token --help` on the VPS and adjust it.
TOKEN_FILE="${PR_BRAIN_TOKEN_FILE:-$HOME/.claude/pr-brain.token}"
TOKEN_WARN_DAYS=330
WARNED_DIR="$HOME/.claude/pr-brain.warned"
OAUTH_TOKEN=""

# One message per distinct problem. The key carries what makes it a NEW problem (the
# token's creation date, its mode), so a renewed token re-arms the warning. A dry run or a
# listing logs it but neither sends nor remembers, so the real run still reports it.
warn_once() {
  local key="$1" msg="$2" marker
  if [[ "$DRY_RUN" -eq 1 || "$LIST_ONLY" -eq 1 ]]; then
    log "$msg"
    return 0
  fi
  marker="$WARNED_DIR/$(printf '%s' "$key" | tr -c 'A-Za-z0-9._-' '_')"
  [[ -e "$marker" ]] && return 0
  mkdir -p "$WARNED_DIR" 2>/dev/null && : >"$marker"
  log "$msg"
  notify "🧠 pr-brain on $(hostname -s): $msg"
  return 0
}

warn_if_token_old() {
  local created="$1" created_epoch now_epoch age
  if ! [[ "$created" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]] || ! created_epoch="$(date -u -d "$created" +%s 2>/dev/null)"; then
    warn_once "token-no-date" "$TOKEN_FILE has no creation date on line 2 (expected YYYY-MM-DD), so the token's age cannot be watched. Fix: add the date the token was created as line 2."
    return 0
  fi
  now_epoch="${PR_BRAIN_NOW_EPOCH:-$(date -u +%s)}"
  age=$(( (now_epoch - created_epoch) / 86400 ))
  if (( age >= TOKEN_WARN_DAYS )); then
    warn_once "token-age-$created" "the Claude token in $TOKEN_FILE was created on $created ($age days ago). Tokens from 'claude setup-token' are meant to last long, but how long is unverified: renew it before it stops working. Fix: ssh founderos-vps, run 'claude setup-token', put the new token on line 1 and today's date (YYYY-MM-DD) on line 2 of $TOKEN_FILE."
  fi
  return 0
}

load_oauth_token() {
  [[ -f "$TOKEN_FILE" ]] || return 0
  local mode token created
  mode="$(stat -c '%a' "$TOKEN_FILE" 2>/dev/null || stat -f '%Lp' "$TOKEN_FILE" 2>/dev/null || echo unknown)"
  if [[ "$mode" != "600" ]]; then
    warn_once "token-mode-$mode" "$TOKEN_FILE has mode $mode, not 600, so it is NOT being used (anyone on the box could read the token). Fix: chmod 600 $TOKEN_FILE"
    return 0
  fi
  { IFS= read -r token; IFS= read -r created; } <"$TOKEN_FILE" || true
  token="${token%$'\r'}"
  created="${created%$'\r'}"
  if [[ -z "$token" ]]; then
    warn_once "token-empty" "$TOKEN_FILE is empty, so it is NOT being used. Fix: put the output of 'claude setup-token' on line 1 and today's date (YYYY-MM-DD) on line 2."
    return 0
  fi
  OAUTH_TOKEN="$token"
  warn_if_token_old "$created"
}

# Every `claude` call goes through here, so the token reaches claude's environment and no one else's.
run_claude() {
  if [[ -n "$OAUTH_TOKEN" ]]; then
    CLAUDE_CODE_OAUTH_TOKEN="$OAUTH_TOKEN" claude "$@"
  else
    claude "$@"
  fi
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --dry-run) DRY_RUN=1; shift ;;
    --repo) ONE_REPO="${2:-}"; shift 2 ;;
    --pr) ONE_PR="${2:-}"; shift 2 ;;
    --list) LIST_ONLY=1; shift ;;
    -h|--help) sed -n '3,32p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) echo "pr-brain: unknown argument '$1' (try --help)" >&2; exit 2 ;;
  esac
done

if [[ -f "$OFF_SWITCH" ]]; then
  log "kill switch present ($OFF_SWITCH) — nothing dispatched"
  exit 0
fi

# A gate can outlast the 20-minute cron interval. Without a lock the next tick
# starts a second sweep on the same PR — the marker comment is only written at
# the END of a gate, so it cannot prevent an overlap, only a repeat. mkdir is the
# portable atomic test-and-set (flock is absent on macOS).
LOCK="$HOME/.claude/pr-brain.lock"
if [[ "$DRY_RUN" -eq 0 && "$LIST_ONLY" -eq 0 ]]; then
  if ! mkdir "$LOCK" 2>/dev/null; then
    # A crashed sweep would otherwise wedge the gate forever. Two hours is well
    # past any legitimate run.
    if [[ -n "$(find "$LOCK" -maxdepth 0 -mmin +120 2>/dev/null)" ]]; then
      log "stale lock older than 120m — reclaiming"
      rm -rf "$LOCK" && mkdir "$LOCK" 2>/dev/null || { log "could not reclaim lock"; exit 0; }
    else
      log "another sweep is running ($LOCK) — this tick does nothing"
      exit 0
    fi
  fi
  trap 'rm -rf "$LOCK"' EXIT
fi

# What the engine needs on PATH. For agy the binary itself lives in the antigravity user's ~/.local/bin and is
# reached through sudo, so what is checked here is sudo and jq (the live view parses agy's stream with it); a
# missing agy shows up as a classified failure of the preflight, with the reason on the founder's phone.
case "$ENGINE" in
  claude) _deps="gh claude git" ;;
  *) _deps="gh git sudo jq curl" ;;
esac
for dep in $_deps; do
  command -v "$dep" >/dev/null 2>&1 || { log "FATAL: '$dep' not on PATH"; exit 1; }
done
gh auth status >/dev/null 2>&1 || { log "FATAL: gh is not authenticated"; exit 1; }
[[ "$ENGINE" == "claude" ]] && load_oauth_token

# Keep the log bounded — this runs every 20 minutes forever.
if [[ -f "$LOG" ]] && [[ "$(wc -l <"$LOG")" -gt 20000 ]]; then
  tail -n 5000 "$LOG" >"$LOG.tmp" && mv "$LOG.tmp" "$LOG"
fi

# "Claude is unavailable to everyone" as opposed to "this one PR's gate broke".
# Echoes auth | limit, or nothing. Only ever fed the last lines of a FAILED run,
# so a review that merely discusses rate limits cannot trip it.
claude_outage() {
  case "$1" in
    *"authenticate"*|*401*|*"Invalid API key"*|*"/login"*) echo auth ;;
    *"hit your"*"limit"*|*"usage limit"*|*"limit reached"*|*"rate limit"*|*"rate_limit"*|*[Oo]verloaded*|*"credit balance is too low"*) echo limit ;;
  esac
}

# The same question for the agy engine, asked of the PLAIN-TEXT view of the failed run (agy-run.sh), by the
# classifier agent-dispatch already trusts: quota -> limit, auth -> auth, anything else is not an outage (that
# PR's gate broke, not the reviewer). It reads only error lines the CLI printed about itself, so a review that
# merely discusses quotas cannot trip it.
agy_outage() { # agy_outage TEXT_LOG_FILE
  case "$(classify_agy_failure "$1")" in
    quota) echo limit ;;
    auth) echo auth ;;
  esac
}

# What an outage looks like in the founder's pocket: the failing class and the line the CLI printed.
outage_line() { # outage_line TEXT_LOG_FILE CLASS
  agy_failure_line "$([[ "$2" == limit ]] && echo quota || echo auth)" "$1" | redact_secrets | head -n1 | cut -c1-160
}

# An outage is announced once going down and once coming back. 2026-09-26/27:
# a weekly usage limit produced 72 "Gate FAILED" messages a day, one per tick,
# because only an AUTH failure was recognised as an outage. The state machine
# itself (one message per transition) lives in deploy/lib/down-state.sh, shared
# with agent-dispatch; what stays here is only the wording.
enter_down() {
  local cls="$1" detail="$2" msg
  log "${REVIEWER_NAME} unavailable ($cls): $detail — sweep stopped, nothing dispatched"
  if [[ "$ENGINE" == "agy" ]]; then
    case "$cls" in
      auth) msg="🧠 pr-brain PAUSED on $(hostname -s): the Antigravity reviewer's login was rejected (${detail}). Fix: ssh founderos-vps, then 'sudo -u ${AG_USER} -i', run 'agy' once and sign in. One more message when it resumes — none until then." ;;
      limit) msg="🧠 pr-brain PAUSED on $(hostname -s): the Antigravity reviewer's quota is used up (${detail}). Retrying silently when a PR is waiting; one more message when it resumes." ;;
      *) msg="🧠 pr-brain PAUSED on $(hostname -s): the Antigravity reviewer's preflight failed (${detail}). Retrying silently when a PR is waiting; one more message when it resumes." ;;
    esac
    down_enter "$cls" "$detail" "$msg"
    return 0
  fi
  case "$cls" in
    auth)
      if [[ -n "$OAUTH_TOKEN" ]]; then
        msg="🧠 pr-brain PAUSED on $(hostname -s): Claude rejected the token in $TOKEN_FILE. Fix: ssh founderos-vps, run 'claude setup-token', put the new token on line 1 and today's date (YYYY-MM-DD) on line 2 of $TOKEN_FILE. One more message when it resumes — none until then."
      else
        msg="🧠 pr-brain PAUSED on $(hostname -s): Claude Code auth expired. Fix: ssh founderos-vps, run 'claude', then '/login' (or run 'claude setup-token' once and keep its output in $TOKEN_FILE so this stops recurring). One more message when it resumes — none until then."
      fi ;;
    limit) msg="🧠 pr-brain PAUSED on $(hostname -s): Claude usage limit reached (${detail}). Retrying silently when a PR is waiting; one more message when it resumes." ;;
    *) msg="🧠 pr-brain PAUSED on $(hostname -s): Claude preflight failed (${detail}). Retrying silently when a PR is waiting; one more message when it resumes." ;;
  esac
  down_enter "$cls" "$detail" "$msg"
}

leave_down() {
  down_active || return 0
  local since; since=$(down_since)
  log "${REVIEWER_NAME} reachable again (paused since $since)"
  down_leave "✅ pr-brain resumed on $(hostname -s) — ${REVIEWER_NAME} reachable again (paused since $since). Queued PRs are being gated now."
}

# Preflight the model. Without this the sweep fails once per PR, twenty minutes
# apart, forever. Anything but "ok" means no gate can run this tick.
#
# Called lazily, right before the first PR that actually needs a gate — never at
# the top of the tick. An eager preflight was itself a Claude session on every
# 20-minute tick, 72 a day, while the PR queue sat empty most of the day
# (2026-09-28, on an account that hit its usage limit that morning). Claude is
# spent on demand only: no PR waiting means no Claude call at all.
PREFLIGHT_OK=0
preflight() {
  [[ "$PREFLIGHT_OK" -eq 1 ]] && return 0
  local preflight cls
  if [[ "$ENGINE" == "agy" ]]; then
    # One tiny agy turn in /tmp, in the plain text format (the answer is the word; a failure is the CLI's own error
    # line). The classifier reads the same text it reads for a real gate, so an outage is named identically.
    local pf_log; pf_log="$(mktemp /tmp/pr-brain-preflight-XXXXXX.log)"
    as_antigravity 'exec </dev/null; cd /tmp && timeout 150 agy --new-project --model "$1" --print "reply with the single word ok" --print-timeout 120s --output-format text' "$MODEL" >"$pf_log" 2>&1
    preflight=$(tail -n 3 "$pf_log")
    if ! printf '%s' "$preflight" | grep -qiwE 'ok'; then
      local detail
      cls=$(agy_outage "$pf_log")
      # The CLI's own error line when the classifier found one; otherwise whatever the run printed last.
      detail="$([[ -z "$cls" ]] || outage_line "$pf_log" "$cls")"
      [[ -n "$detail" ]] || detail="$(printf '%s' "$preflight" | tr '\n' ' ' | cut -c1-160)"
      detail="${detail#"${detail%%[![:space:]]*}"}"
      enter_down "${cls:-unknown}" "$detail"
      rm -f "$pf_log"
      exit 0
    fi
    rm -f "$pf_log"
    PREFLIGHT_OK=1
    return 0
  fi
  preflight=$(run_claude -p "reply with the single word ok" --model "$MODEL" \
                --max-budget-usd 0.05 --output-format text </dev/null 2>&1 | tail -2)
  # "Exceeded USD budget" is the preflight's own $0.05 cap tripping — Claude Code's
  # context costs more than that before it answers. A billed call proves auth and
  # quota are fine, so it counts as reachable (2026-09-28: treating it as an
  # outage paused every gate).
  if ! printf '%s' "$preflight" | grep -qiwE 'ok|Exceeded USD budget'; then
    cls=$(claude_outage "$preflight")
    enter_down "${cls:-unknown}" "$(printf '%s' "$preflight" | tr '\n' ' ' | cut -c1-160)"
    exit 0
  fi
  # Not leave_down() yet: a one-word preflight can pass while a full gate still
  # hits the limit. "Resumed" is announced only after a sweep finishes clean.
  PREFLIGHT_OK=1
}

fail_file() { printf '%s/%s#%s' "$FAIL_DIR" "$1" "$2"; }

# Failed attempts already spent on this exact head (0 if the head moved).
prior_failures() {
  local f h c; f=$(fail_file "$1" "$2")
  [[ -f "$f" ]] || { echo 0; return; }
  read -r h c <"$f"
  if [[ "$h" == "$3" ]]; then echo "${c:-0}"; else echo 0; fi
}

# ---------------------------------------------------------------- repositories

discover_repos() {
  if [[ -n "$ONE_REPO" ]]; then
    printf '%s\n' "$(cd "$ONE_REPO" && pwd)"
    return
  fi
  if [[ -f "$REPO_LIST" ]]; then
    grep -vE '^\s*(#|$)' "$REPO_LIST" | while read -r line; do
      dir="${line/#\~/$HOME}"
      [[ -d "$dir/.git" ]] && printf '%s\n' "$dir"
    done
    return
  fi
  # Auto-discover: any immediate child of $ROOT that is a git repo whose origin
  # belongs to $OWNER or allowed organizations like OplifyMessage.
  local allowed_orgs=("$OWNER" "OplifyMessage")
  for dir in "$ROOT"/*/; do
    [[ -d "$dir/.git" ]] || continue
    remote=$(git -C "$dir" remote get-url origin 2>/dev/null || true)
    [[ "$remote" == *github.com* ]] || continue
    for org in "${allowed_orgs[@]}"; do
      case "$remote" in
        *"github.com/$org/"*|*"github.com:$org/"*)
          printf '%s\n' "${dir%/}"
          break
          ;;
      esac
    done
  done
}

# macOS ships bash 3.2 — no mapfile, and `set -u` trips on empty arrays. A
# newline-delimited string is the portable option here.
REPOS=$(discover_repos)
REPO_COUNT=$(printf '%s' "$REPOS" | grep -c . || true)

if [[ "$LIST_ONLY" -eq 1 ]]; then
  printf 'pr-brain would sweep %s repo(s):\n' "$REPO_COUNT"
  printf '%s\n' "$REPOS" | sed 's/^/  /'
  exit 0
fi

if [[ "$REPO_COUNT" -eq 0 ]]; then
  log "no GitHub repositories found under $ROOT"
  exit 0
fi

# ------------------------------------------------------------------ the sweep

# The prompt is deliberately thin: the protocol lives in the pr-adversary skill
# so that a fix to the protocol reaches every future sweep. A prompt that
# restates the rules is a second copy that will drift.
# What the browser gate's exit code means to the reviewer, in the words both engines' prompts use.
app_evidence_line() { # app_evidence_line APP_RC
  case "$1" in
    0) echo "The browser gate ran on this branch and rendered the app's public pages with no blocking defects. Its evidence pack is a PR comment containing the marker <!-- app-evidence -->. READ IT — it names which screens were NOT covered, and those remain unverified." ;;
    1) echo "The browser gate ran on this branch and found BLOCKING defects, or the app did not build/start at all. Its evidence pack is a PR comment containing the marker <!-- app-evidence -->. Treat that as a BLOCKER unless you can show the finding is the gate's own fault." ;;
    *) echo "The browser gate did NOT run on this branch (no recipe for this repo, a diff it does not cover, or it failed to start). No page was rendered, so you may not claim any visual or runtime verification — say NOT VERIFIED and name this as the reason." ;;
  esac
}

build_prompt() {
  local pr="$1" repo_name="$2" head="$3" app_rc="${4:-3}"
  local app_line; app_line="$(app_evidence_line "$app_rc")"
  cat <<EOF
Act on pull request #${pr} in ${repo_name} as the brain in the Brain/Doer division.

BROWSER EVIDENCE (already gathered for you, before you were dispatched):
${app_line}

Invoke the pr-adversary skill and follow it exactly. An executor (Antigravity) wrote this PR;
your default posture is disproof, not agreement. Green CI is a necessary condition, never the
verdict.

CRITICAL FIRST LAYER OF THINKING — WAS THIS WORK REALLY REQUIRED?
Before evaluating implementation details or running tests, you MUST reason about necessity:
1. Was the work done on this branch actually necessary to achieve the stated goal?
2. Did the executor invent artificial problems, over-engineer a simple request, add speculative abstractions, or touch code that was already working?
3. Is this change solving an actual observed defect or delivering real requested user value, rather than performing busywork or unnecessary refactoring?
If the change was NOT genuinely required or over-complicates the system, treat that as a primary BLOCKER. Explain why it is not required and request changes.

You are running headless and unattended. That means:
- Finish with exactly one action taken on GitHub: approve (+ gh pr ready), push the smallest
  correct fix to the PR branch and comment what you fixed, or request changes with a concrete
  failure scenario. Never end with no action.
- Never force-push, never rewrite the executor's commits, never merge to main/master.
- If the working tree is being actively edited (agy-guard reports a live conversation), post a
  comment saying the gate was deferred and why, and stop.
- If you cannot verify a product-behaviour claim without running the real product, say
  NOT VERIFIED in the review body and hand that back rather than approving it.
- If the branch is behind its base, you may merge the base in locally to run the gate on an
  up-to-date tree, but do not push that merge back unless it's the actual fix you're making.

Then, as the last thing you do, stamp the PR's real remote head SHA so it is not re-gated
unchanged. Use exactly this value — ${head} — not the output of 'git rev-parse HEAD', which
reflects your local checkout and will be wrong if you merged the base in locally without pushing:
  gh pr comment ${pr} --body "${MARKER_PREFIX} ${head} -->"
EOF
}

# ------------------------------------------------------------- the agy engine
#
# The reviewer's own clone of the repository, owned by the antigravity user: /opt/agy-workspace/review/<repo>.
# Not the executor's workspace (a reviewer must not see the executor's scratch state) and not /opt/review/<repo>
# (founderos-owned and not writable for the antigravity user, so nothing could be built or tested there).
# Persistent on purpose: node_modules and package caches survive between reviews, so a review is not an install.
# Its PUSH url is disabled: fetching works, pushing cannot, so the reviewer cannot edit what it grades whatever a
# prompt says. (`gh` calls go through the API and are not affected; that is how it posts its review.)
REVIEW_DIR=""
prepare_review_workspace() { # prepare_review_workspace SLUG NAME PR  -> sets REVIEW_DIR
  local slug="$1" name="$2" pr="$3"
  REVIEW_DIR="$REVIEW_WS_BASE/$name"
  as_antigravity 'set -e
    mkdir -p "$1"
    if [ ! -d "$1/$2/.git" ]; then git clone --quiet "$5/$3.git" "$1/$2"; fi
    cd "$1/$2"
    git remote set-url origin "$5/$3.git"
    git remote set-url --push origin "https://push-disabled.invalid/"
    git fetch --quiet origin "+refs/pull/$4/head:refs/review/pr-$4" "+refs/heads/*:refs/remotes/origin/*"
    git reset --hard --quiet
    git clean -fdq
    git checkout --quiet -B "review-pr-$4" "refs/review/pr-$4"' "$REVIEW_WS_BASE" "$name" "$slug" "$pr" "$GITHUB_URL"
}

# The pr-adversary skill without its YAML front matter. It is INLINED because the antigravity user has no
# pr-adversary skill (only production-ready is linked for it), so "invoke the pr-adversary skill" sent the
# 2026-10-02 reviews improvising a protocol. One copy: the file the Claude engine's skill points at.
skill_text() {
  [[ -r "$SKILL_FILE" ]] || return 1
  awk 'NR == 1 && $0 == "---" { fm = 1; next } fm && $0 == "---" { fm = 0; next } !fm { print }' "$SKILL_FILE"
}

build_agy_prompt() { # build_agy_prompt PR SLUG HEAD APP_RC
  local pr="$1" slug="$2" head="$3" app_rc="${4:-3}" skill
  skill="$(skill_text)" || skill="(the protocol file $SKILL_FILE is not readable on this machine. Apply the adversarial gate from memory: re-run the project's gate yourself, hunt for false success, fabricated evidence, unwired code and out-of-scope changes, and reach a verdict.)"
  cat <<EOF
You are the independent reviewer (the "brain") in the Brain/Doer division, running as ${MODEL} in a fresh conversation.
An executor, a DIFFERENT model in a different conversation, wrote pull request #${pr} in ${slug}. You have never seen
its work and you owe it nothing: your job is to try to DISPROVE that it is done, then give a verdict.

Your current directory is a clean checkout of this PR's head (${head}). It is yours to build and test in: install
dependencies, run the gate, write scratch files. Do not run \`gh pr checkout\`.

BROWSER EVIDENCE (already gathered for you, before you were started):
$(app_evidence_line "$app_rc")

THE PROTOCOL. Follow it exactly. It is the pr-adversary skill, inlined because this CLI cannot load it.

${skill}

HOW THIS RUN DIFFERS FROM THE PROTOCOL ABOVE. These rules win wherever they conflict with it.
1. Verdict B (fix and push) is DISABLED. You cannot push to the PR branch (its push URL is disabled here), and a
   reviewer that edits what it grades is not independent. Reach verdict A (clear it) or verdict C (request changes).
   A defect you would have fixed becomes a finding with its concrete failure scenario.
2. Merge nothing. Do not touch main, beta or any branch other than by reading it.
3. Pass --repo ${slug} to every gh command.
4. Post your review as ONE pull request comment: gh pr comment ${pr} --repo ${slug} --body "...". GitHub refuses a
   formal approve or request-changes on your own account's PR; that is expected, a comment is the record.
   Do NOT post a "brain-reviewed" marker comment: the runner posts it.
5. You do not set the PR's draft/ready state either: the runner makes it match your verdict. Do not run gh pr ready.
6. You are headless and unattended. Never end without a verdict.

YOUR FINAL MESSAGE must end with exactly one of these two lines, and nothing after it:
BRAIN-VERDICT: PASS
BRAIN-VERDICT: FAIL
PASS only when verdict A's conditions hold: the gate green in this session, no BLOCKER finding, and the outcome claim
either verified or explicitly scoped as needing a real run. Anything else is FAIL.
EOF
}

# One gate on the agy engine. Returns 0 when the reviewer reached a verdict AND the PR now agrees with it; anything
# else is a failed attempt (the caller counts it, and the head is retried up to MAX_ATTEMPTS). OUT receives the
# plain-text view of the run: the classifier reads it, and the daemon log keeps it.
#
# The model PROPOSES the verdict; this function ACTS on it. Making the PR ready or draft is what other code reads as
# "cleared" and what the merge step acts on, so it is done here, from one parsed line, instead of trusting that a
# model remembered to run the right gh command. A run with no verdict line is not a pass and not a fail: it did not
# finish (a --print-timeout returns partial output with exit 0), so nothing is changed and nothing is stamped.
run_agy_gate() { # run_agy_gate PR SLUG NAME HEAD APP_RC OUT
  local pr="$1" slug="$2" name="$3" head="$4" app_rc="$5" out="$6" prompt_file rc verdict is_draft
  if ! prepare_review_workspace "$slug" "$name" "$pr" >>"$LOG" 2>&1; then
    printf 'Error: could not prepare the review workspace %s for %s#%s (see the log above)\n' "$REVIEW_WS_BASE/$name" "$name" "$pr" >"$out"
    return 1
  fi
  prompt_file="$(mktemp /tmp/pr-brain-prompt-XXXXXX.txt)"
  chmod 644 "$prompt_file"
  build_agy_prompt "$pr" "$slug" "$head" "$app_rc" >"$prompt_file"
  agy_run "Reviewing ${name}#${pr}" "$REVIEW_DIR" "$prompt_file" "$MODEL" "$TIMEOUT_SEC" "$out"
  rc=$?
  rm -f "$prompt_file"
  if [[ "$rc" -ne 0 ]]; then
    agy_progress_outcome "⚠️ The review run failed (agy exit ${rc}). It is retried."
    return "$rc"
  fi

  verdict="$(grep -a '^BRAIN-VERDICT:' "$out" | tail -n1 | tr -d '\r' | sed -E 's/^BRAIN-VERDICT:[[:space:]]*//; s/[[:space:]]+$//')"
  case "$verdict" in
    PASS|FAIL) ;;
    *)
      printf 'Error: the reviewer ended without a BRAIN-VERDICT line (PASS or FAIL), so there is no verdict to act on\n' >>"$out"
      agy_progress_outcome "⚠️ The reviewer ended without a verdict (cut off or confused). Nothing was changed; it is retried."
      return 1
      ;;
  esac

  is_draft="$(gh pr view "$pr" --json isDraft --jq .isDraft 2>/dev/null)"
  if [[ "$verdict" == "PASS" && "$is_draft" == "true" ]]; then
    gh pr ready "$pr" >>"$LOG" 2>&1 || log "$name#$pr verdict PASS but 'gh pr ready' failed"
  elif [[ "$verdict" == "FAIL" && "$is_draft" == "false" ]]; then
    gh pr ready "$pr" --undo >>"$LOG" 2>&1 || log "$name#$pr verdict FAIL but 'gh pr ready --undo' failed"
  fi
  # The marker is what stops this head being gated again, and it is what agent-dispatch reads before it sends the
  # executor back to a draft. It is posted once per head, and only after the PR agrees with the verdict.
  if ! gh pr view "$pr" --json comments --jq '[.comments[].body] | join("\n")' 2>/dev/null | grep -qF "$MARKER_PREFIX $head"; then
    gh pr comment "$pr" --body "${MARKER_PREFIX} ${head} -->" >>"$LOG" 2>&1 || log "$name#$pr could not post the reviewed marker"
  fi
  if [[ "$verdict" == "PASS" ]]; then
    agy_progress_outcome "✅ BRAIN-VERDICT: PASS. Cleared: ready for merge."
  else
    agy_progress_outcome "↩️ BRAIN-VERDICT: FAIL. Changes requested: the PR stays a draft and goes back to Antigravity."
  fi
  return 0
}

# ------------------------------------------------------- the app (browser) gate
#
# THE LAST NODE. Everything else in this loop reads code: CI compiles it, the
# unit gate runs it in isolation, the adversarial audit reads the diff. Nothing
# STARTED the product. On a front-end repository that produced an honest but
# useless review body — "NOT VERIFIED: the page renders" — followed by a pass,
# because the protocol's rule is to hand that gap back rather than pretend.
#
# So the gate runs BEFORE the reviewer is dispatched, and posts its evidence pack
# on the PR. The reviewer then READS evidence instead of being told to go and
# produce it: CLAUDE.md rule #27 measured CI-enforced rules drifting zero times
# in a month against markdown rules drifting three times in a day. An instruction
# in a skill file is the weaker half of this; the artifact is the strong half.
#
# It is bounded, skippable and never fatal. A repo with no recipe, a diff that
# touches nothing it covers, a missing FounderOS checkout, or a timeout all leave
# a comment saying so. What must never happen is silence, because a gate that did
# not run and a gate that found nothing look identical from outside.
QA_ROOT="${QA_APP_ROOT:-/opt/founderos}"
QA_TIMEOUT="${QA_APP_TIMEOUT_SEC:-1500}"
APP_MARKER="<!-- app-evidence -->"

# Replace the previous pack in place rather than appending a new comment per
# push: same reasoning as the UI gate's single updated comment.
post_app_evidence() {
  local pr="$1" body="$2" existing
  existing=$(gh pr view "$pr" --json comments \
               --jq "[.comments[] | select(.body | contains(\"$APP_MARKER\")) | .url] | .[-1] // empty" 2>/dev/null || true)
  if [[ -n "$existing" ]]; then
    local cid; cid="${existing##*-}"
    local slug; slug=$(gh repo view --json nameWithOwner --jq .nameWithOwner 2>/dev/null)
    if [[ -n "$cid" && -n "$slug" ]] && gh api -X PATCH "repos/${slug}/issues/comments/${cid}" \
         -f body="$body" >/dev/null 2>&1; then
      return 0
    fi
  fi
  gh pr comment "$pr" --body "$body" >/dev/null 2>&1 || true
}

# Echoes the gate's own exit code: 0 clean · 1 blocking · 3 not applicable.
app_gate() {
  local pr="$1" slug="$2" repo_dir="$3" head="$4"
  local out="/tmp/app-qa/${slug//\//__}/${pr}"
  local base rc report

  if [[ ! -f "$QA_ROOT/scripts/qa-app.ts" ]]; then
    post_app_evidence "$pr" "$APP_MARKER
## App Evidence Pack — NOT RUN

- ⏭️ **SKIPPED** — no FounderOS checkout at \`$QA_ROOT\`, so the browser gate could not be started.
- ⚠️ No page on this branch was rendered. This is **not** a clean visual result; it is the absence of one."
    return 3
  fi

  base=$(gh pr view "$pr" --json baseRefName --jq .baseRefName 2>/dev/null || echo "")
  rm -rf "$out"; mkdir -p "$out"

  # Runs from $QA_ROOT so tsx and playwright resolve. READ-ONLY with respect to
  # that tree: no checkout, no merge, no install — /opt/founderos is the live
  # production working copy and switching its branch takes the bot down.
  ( cd "$QA_ROOT" && timeout "$QA_TIMEOUT" node --import tsx/esm scripts/qa-app.ts \
      --dir "$repo_dir" --repo "$slug" --out "$out" \
      ${base:+--changed-from "origin/$base"} ) >>"$LOG" 2>&1
  rc=$?

  if [[ ! -f "$out/report.md" ]]; then
    post_app_evidence "$pr" "$APP_MARKER
## App Evidence Pack — DID NOT COMPLETE

- ⏭️ **SKIPPED** — \`pnpm qa:app\` exited ${rc} without writing a report$([[ $rc -eq 124 ]] && echo " (timed out after ${QA_TIMEOUT}s)").
- ⚠️ No page on this branch was rendered. Treat visual behaviour as **NOT VERIFIED**; see \`$LOG\`."
    return 3
  fi

  report=$(cat "$out/report.md")
  post_app_evidence "$pr" "$APP_MARKER
$report"

  # Photos only when the gate actually rendered something, only on the head being
  # gated, only two of them, and only ONCE per head: a gate that fails and is
  # retried re-renders the same commit (2026-09-23: oplify-messaging-app#35's two
  # screenshots arrived six times in 100 minutes — issue #730).
  local sent_file="$PHOTO_DIR/${slug//\//__}#${pr}"
  if [[ -f "$sent_file" && "$(cat "$sent_file")" == "$head" ]]; then
    log "${slug}#${pr} screenshots for ${head:0:8} already sent — not resent"
  elif [[ $rc -eq 0 || $rc -eq 1 ]]; then
    mkdir -p "$PHOTO_DIR" && printf '%s' "$head" >"$sent_file"
    local verdict; verdict=$([[ $rc -eq 0 ]] && echo "✅ no blocking defects" || echo "❌ BLOCKING defects")
    local n=0
    while IFS= read -r shot; do
      [[ $n -ge 2 ]] && break
      notify_photo "$shot" "$slug#${pr} · $(basename "$shot" .png) · ${verdict}"
      n=$((n + 1))
    done < <(find "$out/screenshots" -name '*.png' 2>/dev/null | sort)
  fi

  return $rc
}

# ------------------------------------------------- verdict, merge, carry-forward

# The verdict GitHub actually recorded, not what the run claimed.
#
# GitHub returns reviewDecision as "" (not null) when no decision exists, and it
# ALWAYS will here: the executor opens PRs under this same account and GitHub
# refuses self-approval ("Can not approve your own pull request"). So the real
# signal is draft→ready, and `// "..."` cannot supply it — jq's // only catches
# null/false, never "". Read the state in plain words or the founder gets a
# message with a blank where the verdict should be.
pr_verdict() {
  gh pr view "$1" --json reviewDecision,isDraft,title --jq '
      (if   .reviewDecision == "CHANGES_REQUESTED" then "CHANGES REQUESTED — blocked"
       elif .reviewDecision == "APPROVED"          then "APPROVED"
       elif .isDraft                               then "REVIEWED, left as draft — not cleared"
       else "CLEARED — marked ready for merge (self-approval impossible; ready IS the pass)"
       end) + " · " + .title' 2>/dev/null \
    || echo "unknown — could not read PR state"
}

# Sets merge_result. Merges only a CLEARED PR.
#
# The documented pipeline (src/tools/dispatch-antigravity.ts's own header
# comment) ends "pr-brain (Claude review, every 20 min) → Merge". That arrow
# never existed in code — pr-brain gated, GitHub does not allow self-approval
# so the pass signal is draft->ready, and nothing after that ever merged
# anything. Found 2026-09-14: 3 PRs sat CLEARED, all CI green, mergeable,
# for 4 days because of exactly this gap. Only the CLEARED case merges, and
# even then never main/master, and never ANY branch in an employer/org repo
# ($repo_owner != $OWNER — see the OplifyMessage carve-out below) — a main
# merge, or any merge into a repo we don't personally own, is the founder's
# call (restored 2026-09-21: this guard existed originally, was silently
# dropped, and the comment above the dropped code kept claiming it still
# ran — see docs/sessions/2026-09-21-oplify-onboarding-and-safety-fixes.md).
# No --auto / no allow_auto_merge dependency: branch protection already
# requires both checks server-side, and by the time a PR reaches this line
# the pr-adversary gate re-ran them in-session and GitHub's own Actions run
# (which starts on push, long before the next 20-min sweep) has already
# finished — so an immediate merge attempt either succeeds because they're
# actually green, or fails loud because they are not.
merge_cleared() {
  local pr="$1" verdict="$2" base promo_pr promo_url
  merge_result="not attempted (verdict was not CLEARED)"
  case "$verdict" in
    "CLEARED"*) ;;
    *) return 0 ;;
  esac
  base=$(gh pr view "$pr" --json baseRefName --jq .baseRefName 2>/dev/null)
  if [[ "$repo_owner" == "OplifyMessage" ]]; then
    # Employer repo. founderOS reviews, fixes, and marks ready — a human
    # merges from GitHub or the phone, every time, no exceptions.
    merge_result="not attempted — $repo_owner is an employer org; a human merges"
    gh pr ready "$pr" >>"$LOG" 2>&1 || true
    log "$repo_name#$pr cleared — marked ready, merge withheld ($repo_owner org)"
  elif [[ "$base" == "main" || "$base" == "master" ]]; then
    merge_result="skipped — base is $base, a main/master merge needs the founder"
    log "$repo_name#$pr merge skipped — base is $base"
  elif gh pr merge "$pr" --squash >>"$LOG" 2>&1; then
    merge_result="merged (squash) into $base"
    log "$repo_name#$pr merge: squashed into $base"

    # If base was beta, auto-promote to main
    if [[ "$base" == "beta" ]]; then
      log "$repo_name#$pr is on beta — triggering auto-promotion to main"
      promo_pr=$(gh pr list --base main --head beta --state open --json number --jq '.[0].number // empty' 2>/dev/null || true)
      if [[ -z "$promo_pr" ]]; then
        # `gh pr create` has no --json flag — it prints the created PR's
        # URL on stdout. Resolving the number through `gh pr view <url>`
        # was missing before; without it a create failure or success was
        # indistinguishable and this promotion path never actually fired
        # (found 2026-09-21: silently swallowed by `|| true` below).
        promo_url=$(gh pr create --base main --head beta --title "chore: promote beta to main" --body "Automated promotion after PR #${pr} cleared and merged into beta." 2>/dev/null || true)
        if [[ -n "$promo_url" ]]; then
          promo_pr=$(gh pr view "$promo_url" --json number --jq .number 2>/dev/null || true)
        fi
      fi
      if [[ -n "$promo_pr" ]]; then
        gh pr merge "$promo_pr" --auto --squash 2>/dev/null || gh pr merge "$promo_pr" --squash 2>/dev/null || true
        log "$repo_name auto-promoted beta to main (PR #${promo_pr})"
      fi
    fi
  elif gh pr update-branch "$pr" >>"$LOG" 2>&1; then
    # $base has a `strict` required-status-checks policy (verified
    # 2026-09-14): a CLEARED, all-green PR can still be refused with
    # "the head branch is not up to date with the base branch" — checks
    # must have run on the EXACT current commit, not merely have passed
    # on an older one (found live merging #671/#672/#673). update-branch
    # pushes a clean merge-with-base commit, which changes headRefOid. The
    # next sweep carries the verdict forward over that merge (see
    # only_our_commits_since) and retries the merge — no second review.
    merge_result="was behind $base — ran update-branch, next sweep retries the merge"
    log "$repo_name#$pr merge deferred — updated branch against $base, will retry on next sweep"
  else
    merge_result="FAILED — see log ($LOG)"
    log "$repo_name#$pr merge FAILED — see $LOG"
  fi
}

# Every gate is a full Claude session on the founder's own account (2026-09-28/29
# prod: 80–175 model calls, 4–12M cached tokens each). The marker is stamped with
# the head the gate STARTED on, so a gate that pushed its own fix — which the
# pr-adversary skill asks it to — moved the head, and the next sweep gated its own
# work again: founderos#763 was gated 7 times in 6 hours, 4 of them over nothing
# but pr-brain's own commits and a clean merge of beta, and the account sat at its
# session limit for ~9 hours that day.
#
# Succeeds only if EVERY commit between the last gated head and $head is either
#   - authored by this checkout's git identity (pr-brain's own fix), or
#   - a merge whose tree is exactly what a clean merge of its parents produces
#     (no hand-resolved conflict can hide in it). Whatever it brought in that is
#     not already on $base is listed too, and must pass the author check itself.
# Anything else — another author, a rewrite that drops the gated head, a failed
# fetch, a git too old for merge-tree — fails, and the PR gets a real gate.
# Every doubt resolves to "spend the review".
last_gated_head() {
  printf '%s\n' "$1" | grep -oE "brain-reviewed: [0-9a-f]{7,40}" | tail -n1 | awk '{print $2}'
}

only_our_commits_since() {
  local last="$1" head="$2" base="$3" pr="$4" me c p1 p2 extra tree
  me=$(git config user.email 2>/dev/null || true)
  [[ -n "$me" && -n "$last" && -n "$base" && "$last" != "$head" ]] || return 1
  git fetch -q origin "+refs/pull/$pr/head:refs/pr-brain/pr-$pr" \
                      "+refs/heads/$base:refs/pr-brain/base-$base" 2>/dev/null || return 1
  [[ "$(git rev-parse -q --verify "refs/pr-brain/pr-$pr^{commit}" 2>/dev/null)" == "$head" ]] || return 1
  git merge-base --is-ancestor "$last" "$head" 2>/dev/null || return 1
  while read -r c p1 p2 extra; do
    [[ -z "$c" ]] && continue
    [[ -z "$extra" ]] || return 1
    if [[ -z "$p2" ]]; then
      [[ "$(git log -1 --format=%ae "$c")" == "$me" ]] || return 1
    else
      tree=$(git merge-tree --write-tree "$p1" "$p2" 2>/dev/null) || return 1
      [[ "${tree%%$'\n'*}" == "$(git rev-parse "$c^{tree}")" ]] || return 1
    fi
  # Commits already on $base arrived through a merge and are not this PR's news.
  # A failed rev-list prints a 4-field line, which the `extra` check rejects.
  done < <(git rev-list --parents "$head" "^$last" "^refs/pr-brain/base-$base" 2>/dev/null \
             || echo "rev-list-failed x x x")
  return 0
}

acted=0
sweep_outage=0

while IFS= read -r repo; do
  [[ -z "$repo" ]] && continue
  [[ "$acted" -ge "$MAX" ]] && break

  pushd "$repo" >/dev/null 2>&1 || continue
  repo_name=$(basename "$repo")
  # Derived the same way discover_repos() reads org membership from the remote —
  # needed here too so the merge step can single out employer/org repos below.
  repo_owner=$(git remote get-url origin 2>/dev/null | sed -E 's#.*[:/]([^/]+)/[^/]+(\.git)?$#\1#')

  # This checkout is dedicated review scratch space, not precious work — the same
  # invariant agent-dispatch's workspace already relies on. Without an unconditional
  # reset here, a prior gate that crashed, timed out, or ran `git stash -u` and never
  # dropped it (observed: /opt/review/founderos sitting on a stale PR branch with 2
  # orphaned stashes, 2026-09-10 through 2026-09-14) leaves the tree dirty for every
  # future sweep. `pnpm test`/`pnpm gate` then fails on files the DIRT introduced —
  # not on anything the PR under review touched — and got excused in three past
  # reviews as "pre-existing failures," which is a false pass: the founderos main
  # branch itself is clean (0 failures, verified 2026-09-14). Reset before every
  # repo's sweep, not just once at setup, since the dirt can reappear each tick.
  if ! git reset --hard --quiet 2>/dev/null || ! git clean -fdq 2>/dev/null; then
    log "$repo_name: could not reset review checkout to clean — skipping this sweep"
    popd >/dev/null
    continue
  fi
  git stash clear 2>/dev/null || true

  if [[ -n "$ONE_PR" ]]; then
    prs="$ONE_PR"
  else
    # Own PRs only, from a branch in this repo (never a fork), not opted out.
    prs=$(gh pr list --state open --limit 20 \
            --json number,headRefOid,labels,updatedAt,author,isCrossRepository \
            --jq "sort_by(.updatedAt) | reverse | .[]
                  | select(.isCrossRepository == false)
                  | select(.author.login == \"$OWNER\")
                  | select([.labels[].name] | index(\"no-brain\") | not)
                  | \"\(.number) \(.headRefOid)\"" 2>/dev/null || true)
  fi

  [[ -z "$prs" ]] && { popd >/dev/null; continue; }

  while read -r pr head; do
    [[ -z "$pr" ]] && continue
    [[ "$acted" -ge "$MAX" ]] && break

    # A PR is gated once per head SHA. A new push re-opens it.
    comments=""
    if [[ -z "$ONE_PR" ]]; then
      head="${head:-$(gh pr view "$pr" --json headRefOid --jq .headRefOid 2>/dev/null)}"
      comments=$(gh pr view "$pr" --json comments --jq '[.comments[].body] | join("\n")' 2>/dev/null || true)
      if printf '%s\n' "$comments" | grep -qF "$MARKER_PREFIX $head"; then
        log "$repo_name#$pr already gated at $head — skipped"
        continue
      fi
    fi

    # Resolve the real remote head fresh, right before dispatch — unconditionally,
    # covering --pr mode too (where the check block above is skipped and $head is
    # otherwise empty). This is the value that gets stamped in the marker; it must
    # never be substituted with a locally-computed 'git rev-parse HEAD' inside the
    # session, which can reflect an unpushed local merge. That exact bug caused
    # founderos#451 to be re-gated every 20 minutes for 9 hours (2026-08-11/12) —
    # the marker kept recording an unpushed merge SHA that never matched the next
    # sweep's real headRefOid, so the "already gated" skip never fired.
    head="$(gh pr view "$pr" --json headRefOid --jq .headRefOid 2>/dev/null)"
    if [[ -z "$head" ]]; then
      log "$repo_name#$pr could not resolve head SHA — skipping"
      continue
    fi

    # Nothing new but pr-brain's own fix commits and clean merges of the base:
    # re-stamp, retry the merge if it was already cleared, spend no review session.
    if [[ -z "$ONE_PR" && "$DRY_RUN" -eq 0 ]]; then
      last=$(last_gated_head "$comments")
      pr_base=$(gh pr view "$pr" --json baseRefName --jq .baseRefName 2>/dev/null || true)
      if only_our_commits_since "$last" "$head" "$pr_base" "$pr"; then
        log "$repo_name#$pr head ${head:0:8}: only pr-brain's own commits / clean $pr_base merges since gated ${last:0:8} — verdict carried forward, no review session spent"
        gh pr comment "$pr" --body "${MARKER_PREFIX} ${head} -->
Carried forward from \`${last:0:8}\`: every commit since is pr-brain's own fix or a clean merge of \`${pr_base}\`, so no second review was spent." >>"$LOG" 2>&1 || true
        verdict=$(pr_verdict "$pr")
        merge_cleared "$pr" "$verdict"
        case "$merge_result" in
          merged*|FAILED*) notify "🧠 ${repo_name}#${pr}: ${verdict}
Merge: ${merge_result} (no new review — only pr-brain's own commits since the last one)
$(gh pr view "$pr" --json url --jq .url 2>/dev/null)" ;;
        esac
        continue
      fi
    fi

    # A head whose gate failed MAX_ATTEMPTS times is left alone until a new push
    # (or an explicit --pr run). Retrying it every tick only repeats the failure.
    fails=$(prior_failures "$repo_name" "$pr" "$head")
    if [[ -z "$ONE_PR" && "$fails" -ge "$MAX_ATTEMPTS" ]]; then
      log "$repo_name#$pr gate failed $fails times at ${head:0:8} — not retried until a new push (or pr-brain --pr $pr)"
      continue
    fi

    if [[ "$DRY_RUN" -eq 1 ]]; then
      log "DRY RUN would gate $repo_name#$pr (head ${head:0:8})"
      acted=$((acted + 1))
      continue
    fi

    # This PR needs a gate: the first time in this tick, prove the reviewer is reachable
    # before spending the browser gate's build on a review that cannot run.
    preflight

    # The browser gate renders whatever is CHECKED OUT in $repo, and nothing here ever checked the PR out: it
    # rendered the branch the previous review happened to leave behind, so the evidence pack on PR N could show
    # the code of PR N-1 (and `--changed-from` diffed the wrong head). The checkout is this script's job, done
    # before the app gate and for both engines. $repo was reset clean at the top of this repository's sweep.
    gh pr checkout "$pr" --force >>"$LOG" 2>&1 \
      || log "$repo_name#$pr could not check the PR head out for the browser gate — its evidence may describe another branch"

    # Browser evidence FIRST, so the reviewer finds it already on the PR. A
    # reviewer told to go and run the app is a reviewer who reports NOT VERIFIED
    # and clears it anyway — measured on OplifyMessage/oplify-messaging-app#33.
    app_gate "$pr" "${repo_owner}/${repo_name}" "$repo" "$head"
    app_rc=$?
    case "$app_rc" in
      0) log "$repo_name#$pr app gate: rendered, no blocking defects" ;;
      1) log "$repo_name#$pr app gate: BLOCKING defects — evidence posted on the PR" ;;
      *) log "$repo_name#$pr app gate: not applicable or did not run (rc=$app_rc)" ;;
    esac

    gate_out=$(mktemp "${TMPDIR:-/tmp}/pr-brain-gate.XXXXXX")
    if [[ "$ENGINE" == "agy" ]]; then
      log "gating $repo_name#$pr (head ${head:0:8}) engine=agy model=$MODEL"
      # </dev/null for the same reason as below: this runs inside `while read … done <<<"$prs"`.
      run_agy_gate "$pr" "${repo_owner}/${repo_name}" "$repo_name" "$head" "$app_rc" "$gate_out" </dev/null
      gate_rc=$?
    else
      log "gating $repo_name#$pr (head ${head:0:8}) model=$MODEL budget=\$$BUDGET"
      # </dev/null: this runs inside `while read … done <<<"$prs"`, and `claude -p`
      # reads piped stdin into its prompt — without it the gate swallowed every
      # remaining PR line, so one repo never had two PRs gated in one tick.
      run_claude -p "$(build_prompt "$pr" "$repo_name" "$head" "$app_rc")" \
          --model "$MODEL" \
          --permission-mode acceptEdits \
          --allowedTools "Bash Read Write Edit Grep Glob TodoWrite Skill" \
          --max-budget-usd "$BUDGET" \
          --output-format text </dev/null >"$gate_out" 2>&1
      gate_rc=$?
    fi
    # The review's own words go into the log, secrets masked: a reviewer that cats a config file to prove a
    # point must not leave its contents in a file the whole box can read.
    redact_secrets <"$gate_out" >>"$LOG"
    gate_tail=$(tail -n 3 "$gate_out")
    # Is this an outage (everything would fail the same way) or just this PR's gate breaking? Asked of the
    # run's own output, before it is deleted.
    outage=""; outage_detail=""
    if [[ $gate_rc -ne 0 ]]; then
      if [[ "$ENGINE" == "agy" ]]; then
        outage=$(agy_outage "$gate_out")
        [[ -z "$outage" ]] || outage_detail="$(outage_line "$gate_out" "$outage")"
      else
        outage=$(claude_outage "$gate_tail")
        [[ -z "$outage" ]] || outage_detail="$(printf '%s' "$gate_tail" | tr '\n' ' ' | cut -c1-160)"
      fi
    fi
    rm -f "$gate_out"

    if [[ $gate_rc -eq 0 ]]; then
      rm -f "$(fail_file "$repo_name" "$pr")"
      log "$repo_name#$pr gate finished"
      verdict=$(pr_verdict "$pr")
      log "$repo_name#$pr verdict: $verdict"
      merge_cleared "$pr" "$verdict"

      notify "🧠 Gate done — ${repo_name}#${pr}
${verdict}
Merge: ${merge_result}
$(gh pr view "$pr" --json url --jq .url 2>/dev/null)"
    else
      if [[ -n "$outage" ]]; then
        # Not this PR's fault, and every remaining PR would fail the same way.
        enter_down "$outage" "$outage_detail"
        sweep_outage=1
        break 2
      fi
      fails=$((fails + 1))
      mkdir -p "$FAIL_DIR" && printf '%s %s\n' "$head" "$fails" >"$(fail_file "$repo_name" "$pr")"
      log "$repo_name#$pr gate FAILED (exit $gate_rc, attempt $fails/$MAX_ATTEMPTS) — see $LOG; PR left unstamped"
      if [[ "$fails" -eq 1 ]]; then
        notify "⚠️ Gate FAILED to complete — ${repo_name}#${pr}. Retrying silently (up to ${MAX_ATTEMPTS} attempts on this head); you hear again only if it gives up. Log: ~/.claude/pr-brain.log"
      elif [[ "$fails" -ge "$MAX_ATTEMPTS" ]]; then
        notify "🛑 Gate gave up on ${repo_name}#${pr} after ${fails} failed attempts at ${head:0:8}. A new push re-opens it, or run on the VPS: pr-brain --pr ${pr} --repo /opt/review/${repo_name}"
      fi
    fi
    acted=$((acted + 1))
  done <<<"$prs"

  popd >/dev/null
done <<<"$REPOS"

# "Resumed" needs proof: only a tick that actually reached the reviewer may announce it.
# A tick with no PR waiting made no call, so it leaves the paused state as it is.
[[ "$DRY_RUN" -eq 0 && "$sweep_outage" -eq 0 && "$PREFLIGHT_OK" -eq 1 ]] && leave_down
log "sweep complete — $acted PR(s) acted on (max $MAX)"
