# pnpm 11's pre-run dependency check (runDepsStatusCheck) fails every `pnpm <script>`
# while the three optional `ws` native accelerators sit in "pending build approval"
# state (they are intentionally not built — see pnpm-workspace.yaml). Disabling the
# pre-run check makes the documented commands (pnpm test / lint / eval) runnable on a
# fresh clone. tsc/vitest still verify real correctness; this only skips pnpm's
# convenience drift-check, which was producing a false build failure.
verify-deps-before-run=false
