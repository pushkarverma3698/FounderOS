{
  "name": "founderos",
  "version": "0.1.0",
  "description": "FounderOS \u2014 Multi-agent AI operating system for Turicks",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --env-file=.env --import tsx/esm --watch src/index.ts",
    "start": "node --env-file=.env dist/src/index.js",
    "build": "tsc -p tsconfig.json",
    "build:all": "pnpm build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit",
    "test:regression": "vitest run tests/regression",
    "test:integration": "ALLOW_NETWORK=1 vitest run --config vitest.integration.config.ts",
    "test:smoke": "ALLOW_NETWORK=1 node --import tsx/esm scripts/smoke.ts",
    "test:ci": "vitest run",
    "eval": "node --env-file=.env --import tsx/esm scripts/run-eval.ts",
    "outreach:reflect": "node --import tsx/esm scripts/run-outreach-reflection.ts",
    "qa:telegram": "ALLOW_NETWORK=1 node --env-file=.env --import tsx/esm scripts/e2e-telegram-qa.ts run all --approve",
    "lint": "tsc --noEmit",
    "verify:arch": "node --import tsx/esm scripts/verify-architecture.ts",
    "verify:wiring": "node --import tsx/esm scripts/verify-wiring.ts",
    "gate": "pnpm lint && pnpm build:all && pnpm verify:wiring && pnpm verify:arch && pnpm test",
    "predeploy": "pnpm gate",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file=.env node_modules/drizzle-kit/bin.cjs migrate",
    "setup": "node --env-file=.env --import tsx/esm scripts/setup-db.ts",
    "brain:sync": "node --env-file=.env --import tsx/esm scripts/sync-turicks-brain.ts",
    "personal:sync": "node --env-file=.env --import tsx/esm scripts/sync-personal-rag.ts",
    "graph:gen": "node --env-file=.env --import tsx/esm scripts/generate-knowledge-graph.ts",
    "proof:scoreboard": "node --import tsx/esm scripts/proof-scoreboard.ts",
    "proof:case-study": "node --env-file=.env --import tsx/esm scripts/export-case-study.ts",
    "proof:costs": "node --env-file=.env --import tsx/esm scripts/proof-cost-ledger.ts",
    "gap:scan": "node --env-file=.env --import tsx/esm scripts/gap-scan.ts",
    "mcp:probe": "node --env-file=.env --import tsx/esm scripts/mcp-bridge-probe.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1075.0",
    "@aws-sdk/s3-request-presigner": "^3.1075.0",
    "@composio/core": "0.10.0",
    "@googleapis/calendar": "^15.0.0",
    "@googleapis/gmail": "^17.0.0",
    "@langchain/anthropic": "^1.4.1",
    "@langchain/core": "^1.1.49",
    "@langchain/google-genai": "^2.1.31",
    "@langchain/langgraph": "^1.4.2",
    "@langchain/langgraph-checkpoint": "1.1.1",
    "@langchain/langgraph-checkpoint-postgres": "^1.0.3",
    "@langchain/langgraph-supervisor": "1.1.1",
    "@langchain/mcp-adapters": "^1.1.3",
    "@langchain/openai": "^1.4.7",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "bottleneck": "^2.19.5",
    "drizzle-orm": "^0.38.0",
    "google-auth-library": "^10.9.0",
    "grammy": "^1.31.0",
    "hono": "^4.6.0",
    "ioredis": "^5.3.0",
    "jsonrepair": "^3.14.0",
    "langchain": "1.4.5",
    "langsmith": "^0.2.0",
    "mem0ai": "^3.0.9",
    "node-cron": "^3.0.3",
    "octokit": "^5.0.5",
    "opossum": "^8.1.4",
    "pg": "^8.13.1",
    "pino": "^9.5.0",
    "pino-pretty": "^13.0.0",
    "playwright": "^1.61.0",
    "postgres": "^3.4.5",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/node-cron": "^3.0.11",
    "@types/opossum": "^8.1.8",
    "@types/pg": "^8.11.10",
    "drizzle-kit": "^0.30.0",
    "telegram": "^2.26.22",
    "tsx": "^4.19.2",
    "typescript": "^5.5.4",
    "vitest": "^2.1.8"
  }
}
