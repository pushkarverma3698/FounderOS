# Environment
.env
.env.local
.env.*.local
.env.production
.vps-access.local
artifacts/

# Candidate CVs — real names, contact details, work history. Same class of
# secret as .env: never committed, always local/prod filesystem data (see
# data/local_docs/, mac-client/cv/, PERSONAL_CV_DIR in profile-config.ts).
# mac-client/apply-profile.json is covered separately below.
data/local_docs/
mac-client/cv/

# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
build/
.next/

# Database
*.sqlite
*.db

# Logs
logs/
*.log
npm-debug.log*
pnpm-debug.log*

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/settings.json
.idea/
*.swp
*.swo

# Claude local settings (machine-specific)
.claude/settings.local.json

# TypeScript
*.tsbuildinfo

# Test coverage
coverage/

# drizzle migrations (keep schema, skip generated output)
# drizzle/ — uncomment if you don't want to track migrations

# Gumroad packs — seller-only, never commit product files
gumroad-packs/
*.zip
.claude/worktrees/

# actual prod env filename (gap: gitignore had .env.production)
.env.prod
.vitest-report.json

# One-off board-registry maintenance run artifacts (scripts/jobhunt-board-registry.ts)
.board-registry/

# Boot-time compilation cache for synthesize_skill-authored tools
# (src/agents/skill-loader.ts) — regenerated from src/tools/custom/ on every
# boot, never source of truth.
.synthesized-cache/

# Mac apply client: local venv, the founder's real identity/resume paths, and
# the synced queue + outcome ledger. apply-profile.json is PERSONAL DATA and
# .queue/ holds row ids from production — neither belongs in git.
mac-client/.venv*/
mac-client/apply-profile.json
mac-client/.queue/
mac-client/*.pdf

# Python bytecode from the Mac client
__pycache__/
*.pyc

# Generated by `pnpm eval:retrieval` (companion to the untracked eval-report.md)
retrieval-eval-report.md

# Generated run output — CLI --outdir targets, never source (see .gitattributes)
runs/
.data/

# Local brainstorming-tool runtime state (PID files, session HTML) — never source
.superpowers/
